# =========================================================
# AVA - LOCAL DEVELOPMENT CONFIG
# Copy this file to .env before first run
# =========================================================

# Must be changed on each machine.
# ASP.NET and AVA must use the SAME value.
AVA_INTERNAL_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# SQL Server
SQL_SERVER=.\SQLEXPRESS
SQL_DATABASE=HRManagementDB_RAG

# General LLM
GENERAL_LLM_PROVIDER=ollama

# Keep cloud providers disabled unless intentionally configured.
OPENAI_API_KEY=
OPENAI_MODEL=
LLM_MODEL=

# Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TEXT_MODEL=qwen3:4b-instruct
VISION_MODEL=qwen2.5vl:3b
OLLAMA_VISION_NUM_GPU=0
OLLAMA_TIMEOUT_SECONDS=120

# Whisper STT
# Relative to ava_service because run-all starts AVA from that directory.
AVA_STT_MODEL_PATH=.\models\whisper\ggml-small.bin
AVA_STT_CONFIDENCE_THRESHOLD=0.58
AVA_STT_ADAPTIVE_ENHANCEMENT=true

# Vector DB
VECTOR_DB_DIR=.\vector_db
VECTOR_COLLECTION=hrms_knowledge

