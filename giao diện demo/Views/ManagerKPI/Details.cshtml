@model giao_dien_demo.Models.ManagerEvaluationDetailViewModel
@{
    ViewData["Title"] = "Chi tiết Đánh giá KPI - " + (Model.Evaluation.Employee?.Name ?? "Nhân viên");
    var eval = Model.Evaluation;
    var isDraft = eval.Status == "DRAFT";
    var isActive = eval.Status == "ACTIVE";
    var isEvaluating = eval.Status == "EVALUATING";
    var isCompleted = eval.Status == "COMPLETED";
    var isCancelled = eval.Status == "CANCELLED";
    var isWeight100 = Model.TotalWeight == 100.00m;
}

<div class="hrms-page-header mb-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h1 class="hrms-page-title mb-1">
                <i class="fa-solid fa-clipboard-check text-primary me-2"></i>Đánh giá KPI: @(eval.Employee?.Name ?? "Nhân viên")
            </h1>
</div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Index", "ManagerKPI")" class="btn btn-outline-secondary">
                <i class="fa-solid fa-arrow-left me-1"></i>Danh sách
            </a>
            @if ((isDraft || isActive || isEvaluating) && Model.IsActionable)
            {
                <form method="post" asp-action="Cancel" asp-route-id="@eval.Id" onsubmit="return confirm('Bạn có chắc chắn muốn HỦY đánh giá KPI này? Thao tác này không thể hoàn tác.');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger">
                        <i class="fa-solid fa-ban me-1"></i>Hủy đánh giá
                    </button>
                </form>
            }
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center" role="alert">
        <i class="fa-solid fa-circle-check me-2 fs-5"></i>
        <div>@TempData["SuccessMessage"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center" role="alert">
        <i class="fa-solid fa-triangle-exclamation me-2 fs-5"></i>
        <div>@TempData["ErrorMessage"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (!Model.IsActionable)
{
    <div class="alert alert-warning d-flex align-items-center mb-4" role="alert">
        <i class="fa-solid fa-circle-exclamation me-2 fs-4"></i>
        <div>
            <strong>Chế độ xem lịch sử:</strong> Nhân sự này hiện không còn nằm trong phạm vi phân công quản lý hiện tại của bạn. Toàn bộ thao tác chỉnh sửa, kích hoạt, chấm điểm và hủy bỏ đã bị khóa theo quy tắc bảo mật.
        </div>
    </div>
}

<!-- THÔNG TIN TỔNG QUAN -->
<div class="row g-4 mb-4">
    <div class="col-md-8">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <h5 class="fw-bold mb-1">@eval.Employee?.Name</h5>
                        <div class="text-muted small">
                            <span>Mã NV: <strong>@eval.Employee?.EmployeeCode</strong></span> | 
                            <span>Phòng ban: <strong>@(eval.EmployeeDepartmentSnapshot ?? eval.Employee?.Department)</strong></span> | 
                            <span>Chức vụ: <strong>@(eval.EmployeePositionSnapshot ?? eval.Employee?.JobTitle)</strong></span>
                        </div>
                    </div>
                    <div>
                        @if (isDraft)
                        {
                            <span class="badge bg-secondary px-3 py-2 fs-6"><i class="fa-regular fa-file-lines me-1"></i>Bản nháp (DRAFT)</span>
                        }
                        else if (isActive)
                        {
                            <span class="badge bg-primary px-3 py-2 fs-6"><i class="fa-solid fa-spinner fa-spin me-1"></i>Đang thực hiện (ACTIVE)</span>
                        }
                        else if (isEvaluating)
                        {
                            <span class="badge bg-warning text-dark px-3 py-2 fs-6"><i class="fa-solid fa-pen-ruler me-1"></i>Đang đánh giá (EVALUATING)</span>
                        }
                        else if (isCompleted)
                        {
                            <span class="badge bg-success px-3 py-2 fs-6"><i class="fa-solid fa-circle-check me-1"></i>Hoàn thành (COMPLETED)</span>
                        }
                        else if (isCancelled)
                        {
                            <span class="badge bg-danger px-3 py-2 fs-6"><i class="fa-solid fa-ban me-1"></i>Đã hủy (CANCELLED)</span>
                        }
                    </div>
                </div>
                <hr />
                <div class="row g-3">
                    <div class="col-sm-4">
                        <div class="text-muted small">Kỳ đánh giá</div>
                        <div class="fw-bold">@eval.Period?.Name</div>
                        <div class="small text-muted">@eval.Period?.StartDate.ToString("dd/MM/yyyy") - @eval.Period?.EndDate.ToString("dd/MM/yyyy")</div>
                    </div>
                    <div class="col-sm-4">
                        <div class="text-muted small">Quản lý trực tiếp</div>
                        <div class="fw-bold">@(eval.ManagerUsernameSnapshot ?? eval.ManagerUser?.Username ?? "N/A")</div>
                        <div class="small text-muted">Khởi tạo: @eval.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>
                    <div class="col-sm-4">
                        <div class="text-muted small">Trạng thái kỳ KPI</div>
                        <div>
                            @if (eval.Period?.Status == "ACTIVE")
                            {
                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">Kỳ đang diễn ra</span>
                            }
                            else if (eval.Period?.Status == "PLANNED")
                            {
                                <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25">Kỳ dự kiến</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary bg-opacity-10 text-secondary border">Kỳ đã đóng</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- KẾT QUẢ / TIẾN ĐỘ CARD -->
    <div class="col-md-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body p-4 text-center d-flex flex-column justify-content-center">
                @if (isCompleted)
                {
                    <div class="text-success small fw-bold text-uppercase mb-1">Kết quả cuối cùng</div>
                    <div class="display-5 fw-bold text-success mb-2">@eval.FinalScore?.ToString("0.00")</div>
                    <div>
                        <span class="badge bg-success fs-5 px-3 py-1">Xếp loại: @eval.FinalRating</span>
                    </div>
                    <div class="small text-muted mt-3">
                        Hoàn tất: @eval.CompletedAt?.ToString("dd/MM/yyyy HH:mm") bởi @(eval.CompletedBy ?? "Quản lý")
                    </div>
                }
                else if (isEvaluating)
                {
                    <div class="text-warning text-dark small fw-bold text-uppercase mb-1">Điểm tạm tính (Preview)</div>
                    <div class="display-6 fw-bold text-primary mb-2" id="previewScoreBox">@Model.PreviewFinalScore.ToString("0.00")</div>
                    <div class="small text-muted mb-2">Dựa trên điểm quản lý đã chấm và trọng số</div>
                    <div>
                        @if (Model.IsAllScored)
                        {
                            <span class="badge bg-info text-dark">Đã chấm đủ @Model.Targets.Count/@Model.Targets.Count mục tiêu</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Chưa chấm đủ các mục tiêu</span>
                        }
                    </div>
                }
                else
                {
                    <div class="text-muted small fw-bold text-uppercase mb-1">Tổng tiến độ thực hiện</div>
                    <div class="display-6 fw-bold text-info mb-2">@Model.ProgressAverage%</div>
                    <div class="progress mb-2" style="height: 10px;">
                        <div class="progress-bar bg-info" style="width: @(Model.ProgressAverage)%;"></div>
                    </div>
                    <div class="small text-muted">@Model.Targets.Count mục tiêu được giao</div>
                }
            </div>
        </div>
    </div>
</div>

<!-- SECTION 1: DRAFT TARGET EDITOR -->
@if (isDraft)
{
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-transparent border-0 pt-4 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h5 class="fw-bold mb-0">Thiết lập danh sách Mục tiêu KPI (DRAFT)</h5>
                <div class="text-muted small">Cần thêm các mục tiêu và phân bổ trọng số sao cho tổng đạt đúng 100%.</div>
            </div>
            <div class="d-flex align-items-center gap-3">
                <div class="fw-bold fs-6 @(isWeight100 ? "text-success" : "text-danger")">
                    Tổng trọng số: <span id="totalWeightDisplay">@Model.TotalWeight.ToString("0.00")</span> / 100%
                    @if (isWeight100)
                    {
                        <i class="fa-solid fa-circle-check text-success ms-1"></i>
                    }
                    else
                    {
                        <i class="fa-solid fa-triangle-exclamation text-danger ms-1"></i>
                    }
                </div>
                @if (Model.IsActionable)
                {
                    <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addTargetModal">
                        <i class="fa-solid fa-plus me-1"></i>Thêm mục tiêu
                    </button>
                }
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4" style="width: 50px;">STT</th>
                            <th>Tên mục tiêu</th>
                            <th>Mô tả chi tiết</th>
                            <th style="width: 150px;">Trọng số (%)</th>
                            <th class="text-end pe-4" style="width: 150px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Targets.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="fa-solid fa-list-check fa-2x mb-2 d-block text-secondary"></i>
                                    Chưa có mục tiêu nào. Vui lòng bấm <strong>Thêm mục tiêu</strong> để bắt đầu.
                                </td>
                            </tr>
                        }
                        else
                        {
                            int idx = 1;
                            foreach (var t in Model.Targets)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-muted">@(idx++)</td>
                                    <td class="fw-semibold text-dark">@t.Title</td>
                                    <td class="text-muted small">@(string.IsNullOrEmpty(t.Description) ? "Không có mô tả" : t.Description)</td>
                                    <td>
                                        <span class="badge bg-light text-dark border fs-6">@t.Weight.ToString("0.00")%</span>
                                    </td>
                                    <td class="text-end pe-4">
                                        @if (Model.IsActionable)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-secondary me-1" 
                                                    data-id="@t.Id"
                                                    data-title="@t.Title"
                                                    data-desc="@t.Description"
                                                    data-weight="@t.Weight"
                                                    onclick="openEditTargetModal(this)">
                                                <i class="fa-solid fa-pen"></i>
                                            </button>
                                            <form method="post" asp-action="RemoveTarget" asp-route-evaluationId="@eval.Id" asp-route-targetId="@t.Id" style="display:inline;" onsubmit="return confirm('Bạn có chắc chắn muốn xóa mục tiêu này?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    <i class="fa-solid fa-trash"></i>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted small"><i class="fa-solid fa-lock"></i></span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-light p-4 d-flex justify-content-between align-items-center">
            <div class="text-muted small">
                @if (!Model.IsActionable)
                {
                    <span class="text-muted"><i class="fa-solid fa-lock me-1"></i>Đánh giá đã bị khóa do nhân sự không còn trong phạm vi quản lý của bạn.</span>
                }
                else if (eval.Period?.Status != "ACTIVE")
                {
                    <span class="text-danger"><i class="fa-solid fa-circle-exclamation me-1"></i>Lưu ý: Kỳ đánh giá '@eval.Period?.Name' đang ở trạng thái <strong>@eval.Period?.Status</strong>. Cần được HR kích hoạt sang <strong>ACTIVE</strong> trước khi bạn có thể kích hoạt đánh giá này.</span>
                }
                else if (!isWeight100)
                {
                    <span class="text-warning text-dark"><i class="fa-solid fa-triangle-exclamation me-1"></i>Tổng trọng số phải đạt <strong>đúng 100.00%</strong> để có thể kích hoạt đánh giá.</span>
                }
                else
                {
                    <span class="text-success"><i class="fa-solid fa-circle-check me-1"></i>Đã đủ điều kiện kích hoạt đánh giá KPI.</span>
                }
            </div>
            <div>
                @if (Model.IsActionable)
                {
                    <form method="post" asp-action="Activate" asp-route-id="@eval.Id" onsubmit="return handleDoubleSubmit(this, 'Bạn có chắc chắn muốn KÍCH HOẠT đánh giá KPI này? Sau khi kích hoạt, mục tiêu và trọng số sẽ bị khóa và nhân viên sẽ nhận được thông báo thực hiện.');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-success px-4" @(isWeight100 && eval.Period?.Status == "ACTIVE" ? "" : "disabled")>
                            <i class="fa-solid fa-paper-plane me-1"></i>Kích hoạt đánh giá KPI
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
}

<!-- SECTION 2: ACTIVE MODE -->
@if (isActive)
{
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-transparent border-0 pt-4 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h5 class="fw-bold mb-0">Tiến độ thực hiện mục tiêu của Nhân sự (ACTIVE)</h5>
                <div class="text-muted small">Mục tiêu và trọng số đã được khóa. Nhân sự đang cập nhật tiến độ thực hiện.</div>
            </div>
            @if (Model.IsActionable)
            {
                <div>
                    <form method="post" asp-action="StartEvaluation" asp-route-id="@eval.Id" onsubmit="return handleDoubleSubmit(this, 'Bạn có chắc chắn muốn BẮT ĐẦU ĐÁNH GIÁ? Khi chuyển sang Đang đánh giá, nhân viên sẽ không thể sửa tiến độ và Quản lý bắt đầu chấm điểm.');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-warning text-dark fw-semibold px-4">
                            <i class="fa-solid fa-pen-ruler me-1"></i>Bắt đầu đánh giá (Chấm điểm)
                        </button>
                    </form>
                </div>
            }
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4" style="width: 50px;">STT</th>
                            <th>Tên mục tiêu</th>
                            <th>Mô tả</th>
                            <th style="width: 120px;">Trọng số</th>
                            <th style="width: 250px;">Tiến độ nhân viên</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int idxActive = 1; }
                        @foreach (var t in Model.Targets)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-muted">@(idxActive++)</td>
                                <td class="fw-semibold text-dark">@t.Title</td>
                                <td class="text-muted small">@(string.IsNullOrEmpty(t.Description) ? "Không có mô tả" : t.Description)</td>
                                <td><span class="badge bg-light text-dark border">@t.Weight.ToString("0.00")%</span></td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="progress flex-grow-1 me-2" style="height: 8px;">
                                            <div class="progress-bar bg-info" style="width: @(t.Progress)%;"></div>
                                        </div>
                                        <span class="fw-bold small text-dark">@t.Progress%</span>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!-- SECTION 3: EVALUATING MODE (SCORING & FINALIZATION) -->
@if (isEvaluating)
{
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-transparent border-0 pt-4 px-4">
            <h5 class="fw-bold mb-0">Chấm điểm Mục tiêu (EVALUATING)</h5>
            <div class="text-muted small">Nhập điểm đánh giá của Quản lý cho từng mục tiêu (Thang điểm 0 - 100).</div>
        </div>
        <div class="card-body p-0">
            <form method="post" asp-action="SaveScores" id="scoresForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="evaluationId" value="@eval.Id" />
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4" style="width: 50px;">STT</th>
                                <th>Tên mục tiêu</th>
                                <th style="width: 110px;">Trọng số</th>
                                <th style="width: 180px;">Tiến độ NV</th>
                                <th style="width: 200px;">Điểm Quản lý (0-100)</th>
                                <th class="pe-4 text-end" style="width: 150px;">Điểm quy đổi</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int sIdx = 0; }
                            @foreach (var t in Model.Targets)
                            {
                                decimal weighted = (t.ManagerScore ?? 0) * t.Weight / 100m;
                                <tr>
                                    <td class="ps-4 fw-bold text-muted">@(sIdx + 1)</td>
                                    <td>
                                        <div class="fw-semibold text-dark">@t.Title</div>
                                        <div class="small text-muted">@t.Description</div>
                                    </td>
                                    <td><span class="badge bg-light text-dark border">@t.Weight.ToString("0.00")%</span></td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="progress flex-grow-1 me-2" style="height: 6px;">
                                                <div class="progress-bar bg-info" style="width: @(t.Progress)%;"></div>
                                            </div>
                                            <span class="small fw-semibold">@t.Progress%</span>
                                        </div>
                                    </td>
                                    <td>
                                        <input type="hidden" name="scores[@sIdx].TargetId" value="@t.Id" />
                                        <input type="number" step="0.5" min="0" max="100" 
                                               name="scores[@sIdx].Score" 
                                               class="form-control form-control-sm score-input" 
                                               value="@(t.ManagerScore?.ToString("0.0") ?? "")" 
                                               data-weight="@t.Weight"
                                               required 
                                               placeholder="0 - 100" />
                                    </td>
                                    <td class="pe-4 text-end fw-bold text-primary target-weighted-score">
                                        @(t.ManagerScore.HasValue ? weighted.ToString("0.00") : "--")
                                    </td>
                                </tr>
                                sIdx++;
                            }
                        </tbody>
                    </table>
                </div>
                <div class="card-footer bg-light p-3 d-flex justify-content-between align-items-center">
                    <div class="small text-muted">
                        <i class="fa-solid fa-info-circle me-1"></i>Hãy bấm <strong>Lưu điểm đánh giá</strong> sau khi điều chỉnh điểm từng mục tiêu.
                    </div>
                    @if (Model.IsActionable)
                    {
                        <button type="submit" class="btn btn-primary">
                            <i class="fa-solid fa-floppy-disk me-1"></i>Lưu điểm đánh giá
                        </button>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Chỉ xem</span>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- KHỐI HOÀN TẤT ĐÁNH GIÁ (FINALIZATION) -->
    <div class="card shadow-sm border-0 mb-4 border-start border-4 border-success">
        <div class="card-body p-4">
            <h5 class="fw-bold mb-1 text-success"><i class="fa-solid fa-award me-2"></i>Hoàn tất & Xếp loại Đánh giá KPI</h5>
            <p class="text-muted small mb-4">Sau khi chấm điểm đầy đủ các mục tiêu, chọn Xếp loại từ cấu hình KPI và xác nhận hoàn tất đánh giá.</p>

            @if (!Model.IsActionable)
            {
                <div class="alert alert-secondary mb-0">
                    <i class="fa-solid fa-lock me-1"></i>
                    Không thể hoàn tất đánh giá do nhân sự đã chuyển khỏi phạm vi quản lý của bạn.
                </div>
            }
            else if (!Model.IsAllScored)
            {
                <div class="alert alert-warning mb-0">
                    <i class="fa-solid fa-triangle-exclamation me-1"></i>
                    Vui lòng chấm điểm và lưu điểm cho toàn bộ <strong>@Model.Targets.Count</strong> mục tiêu trước khi thực hiện xếp loại và hoàn tất.
                </div>
            }
            else if (!Model.AvailableRatings.Any())
            {
                <div class="alert alert-danger mb-0">
                    <i class="fa-solid fa-triangle-exclamation me-1"></i>
                    Hệ thống chưa có cấu hình Xếp loại KPI (KPIConfig). Vui lòng liên hệ HR để thiết lập thang xếp loại trước khi hoàn tất.
                </div>
            }
            else
            {
                <div class="row align-items-end g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Chọn Xếp loại KPI cuối cùng <span class="text-danger">*</span></label>
                        <select id="selectedFinalRating" class="form-select form-select-lg" required>
                            <option value="">-- Vui lòng chọn Xếp loại --</option>
                            @foreach (var r in Model.AvailableRatings)
                            {
                                <option value="@r.KPIRating" data-coef="@r.Coefficient" data-notes="@r.Notes">
                                    Xếp loại @r.KPIRating (Hệ số: @r.Coefficient.ToString("0.0")@(string.IsNullOrEmpty(r.Notes) ? "" : $" - {r.Notes}"))
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6 d-flex gap-2">
                        <button type="button" class="btn btn-success btn-lg px-4" onclick="openFinalizeModal()">
                            <i class="fa-solid fa-check-double me-1"></i>Xác nhận Hoàn tất Đánh giá
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
}

<!-- SECTION 4: COMPLETED / CANCELLED DISPLAY (READ-ONLY) -->
@if (isCompleted || isCancelled)
{
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-transparent border-0 pt-4 px-4">
            <h5 class="fw-bold mb-0">Danh sách Mục tiêu & Kết quả chi tiết</h5>
            <div class="text-muted small">Bản ghi đánh giá này đã được khóa và lưu trữ.</div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4" style="width: 50px;">STT</th>
                            <th>Tên mục tiêu</th>
                            <th>Mô tả</th>
                            <th style="width: 120px;">Trọng số</th>
                            <th style="width: 150px;">Tiến độ NV</th>
                            <th style="width: 150px;">Điểm Quản lý</th>
                            <th class="pe-4 text-end" style="width: 150px;">Điểm quy đổi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int cIdx = 1; }
                        @foreach (var t in Model.Targets)
                        {
                            decimal weighted = (t.ManagerScore ?? 0) * t.Weight / 100m;
                            <tr>
                                <td class="ps-4 fw-bold text-muted">@(cIdx++)</td>
                                <td class="fw-semibold text-dark">@t.Title</td>
                                <td class="text-muted small">@(string.IsNullOrEmpty(t.Description) ? "Không có mô tả" : t.Description)</td>
                                <td><span class="badge bg-light text-dark border">@t.Weight.ToString("0.00")%</span></td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="progress flex-grow-1 me-2" style="height: 6px;">
                                            <div class="progress-bar bg-info" style="width: @(t.Progress)%;"></div>
                                        </div>
                                        <span class="small fw-semibold">@t.Progress%</span>
                                    </div>
                                </td>
                                <td class="fw-bold text-dark">
                                    @(t.ManagerScore.HasValue ? t.ManagerScore.Value.ToString("0.0") : "--")
                                </td>
                                <td class="pe-4 text-end fw-bold text-primary">
                                    @(t.ManagerScore.HasValue ? weighted.ToString("0.00") : "--")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!-- MODALS -->

<!-- Modal Thêm Mục Tiêu -->
<div class="modal fade" id="addTargetModal" tabindex="-1" aria-labelledby="addTargetModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-action="AddTarget">
                @Html.AntiForgeryToken()
                <input type="hidden" name="evaluationId" value="@eval.Id" />
                <div class="modal-header">
                    <h5 class="modal-title" id="addTargetModalLabel"><i class="fa-solid fa-plus text-primary me-2"></i>Thêm Mục Tiêu KPI</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tên mục tiêu <span class="text-danger">*</span></label>
                        <input type="text" name="Title" class="form-control" placeholder="Ví dụ: Hoàn thành phát triển module KPI đúng tiến độ" required maxlength="200" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mô tả tiêu chí / kết quả cần đạt</label>
                        <textarea name="Description" class="form-control" rows="3" placeholder="Mô tả cụ thể yêu cầu và kết quả kỳ vọng..."></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Trọng số (%) <span class="text-danger">*</span></label>
                        <input type="number" step="0.5" min="0.5" max="100" name="Weight" class="form-control" placeholder="Ví dụ: 25" required />
                        <div class="form-text text-muted">Trọng số đóng góp vào 100% của toàn bộ đánh giá.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary"><i class="fa-solid fa-save me-1"></i>Lưu mục tiêu</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Sửa Mục Tiêu -->
<div class="modal fade" id="editTargetModal" tabindex="-1" aria-labelledby="editTargetModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-action="EditTarget">
                @Html.AntiForgeryToken()
                <input type="hidden" name="evaluationId" value="@eval.Id" />
                <input type="hidden" id="editTargetId" name="TargetId" value="" />
                <div class="modal-header">
                    <h5 class="modal-title" id="editTargetModalLabel"><i class="fa-solid fa-pen text-primary me-2"></i>Cập Nhật Mục Tiêu KPI</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tên mục tiêu <span class="text-danger">*</span></label>
                        <input type="text" id="editTargetTitle" name="Title" class="form-control" required maxlength="200" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mô tả tiêu chí / kết quả cần đạt</label>
                        <textarea id="editTargetDescription" name="Description" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Trọng số (%) <span class="text-danger">*</span></label>
                        <input type="number" step="0.5" min="0.5" max="100" id="editTargetWeight" name="Weight" class="form-control" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary"><i class="fa-solid fa-save me-1"></i>Cập nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Xác Nhận Hoàn Tất Đánh Giá -->
<div class="modal fade" id="finalizeModal" tabindex="-1" aria-labelledby="finalizeModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-action="Finalize" asp-route-id="@eval.Id" onsubmit="return handleDoubleSubmit(this);">
                @Html.AntiForgeryToken()
                <input type="hidden" id="modalFinalRatingInput" name="FinalRating" value="" />
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title" id="finalizeModalLabel"><i class="fa-solid fa-check-double me-2"></i>Xác Nhận Hoàn Tất Đánh Giá KPI</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="alert alert-warning mb-3">
                        <i class="fa-solid fa-lock me-1"></i><strong>CẢNH BÁO:</strong> Sau khi hoàn tất, đánh giá KPI sẽ chuyển sang trạng thái <strong>COMPLETED</strong> và bị khóa vĩnh viễn. Điểm xếp loại sẽ được đồng bộ trực tiếp vào hồ sơ nhân sự để tính lương.
                    </div>
                    <div class="border rounded p-3 bg-light mb-3">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Nhân viên:</span>
                            <span class="fw-bold">@eval.Employee?.Name (@eval.Employee?.EmployeeCode)</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Kỳ đánh giá:</span>
                            <span class="fw-bold">@eval.Period?.Name</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Điểm tính toán (Tạm tính):</span>
                            <span class="fw-bold text-primary fs-5" id="modalPreviewScore">@Model.PreviewFinalScore.ToString("0.00")</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Xếp loại được chọn:</span>
                            <span class="badge bg-success fs-5" id="modalFinalRatingDisplay">--</span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-success px-4"><i class="fa-solid fa-lock me-1"></i>Xác nhận Khóa & Hoàn tất</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
function openEditTargetModal(btn) {
    document.getElementById('editTargetId').value = btn.getAttribute('data-id');
    document.getElementById('editTargetTitle').value = btn.getAttribute('data-title');
    document.getElementById('editTargetDescription').value = btn.getAttribute('data-desc') || '';
    document.getElementById('editTargetWeight').value = btn.getAttribute('data-weight');
    new bootstrap.Modal(document.getElementById('editTargetModal')).show();
}

function openFinalizeModal() {
    var sel = document.getElementById('selectedFinalRating');
    if (!sel || !sel.value) {
        alert('Vui lòng chọn Xếp loại KPI cuối cùng trước khi hoàn tất.');
        return;
    }
    document.getElementById('modalFinalRatingInput').value = sel.value;
    document.getElementById('modalFinalRatingDisplay').innerText = sel.value;
    new bootstrap.Modal(document.getElementById('finalizeModal')).show();
}

function handleDoubleSubmit(form, confirmMsg) {
    if (confirmMsg && !confirm(confirmMsg)) {
        return false;
    }
    var btn = form.querySelector('button[type="submit"]');
    if (btn) {
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i>Đang xử lý...';
    }
    return true;
}
</script>
