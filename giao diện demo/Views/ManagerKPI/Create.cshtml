@model giao_dien_demo.Models.CreateEvaluationViewModel
@{
    ViewData["Title"] = "Tạo Đánh giá KPI Mới";
}

<div class="hrms-page-header mb-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h1 class="hrms-page-title mb-1">
                <i class="fa-solid fa-file-circle-plus text-primary me-2"></i>Khởi tạo Đánh giá KPI Mới
            </h1>
            <div class="hrms-breadcrumb text-muted small">
                <a href="@Url.Action("Index", "ManagerKPI")" class="text-decoration-none text-muted">Quản lý KPI</a>
                <i class="fa-solid fa-chevron-right mx-1"></i>
                <span class="text-dark fw-medium">Tạo đánh giá</span>
            </div>
        </div>
        <div>
            <a href="@Url.Action("Index", "ManagerKPI")" class="btn btn-outline-secondary">
                <i class="fa-solid fa-arrow-left me-1"></i>Quay lại danh sách
            </a>
        </div>
    </div>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center" role="alert">
        <i class="fa-solid fa-triangle-exclamation me-2 fs-5"></i>
        <div>@TempData["ErrorMessage"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-transparent border-0 pt-4 px-4">
                <h5 class="card-title fw-bold mb-0">Thông tin khởi tạo đánh giá</h5>
                <p class="text-muted small mb-0">Chọn kỳ đánh giá và nhân sự thuộc phạm vi quản lý trực tiếp của bạn.</p>
            </div>
            <div class="card-body p-4">
                @if (!Model.Periods.Any())
                {
                    <div class="alert alert-warning d-flex align-items-center" role="alert">
                        <i class="fa-solid fa-circle-exclamation me-2 fs-4"></i>
                        <div>
                            Hiện tại không có kỳ đánh giá KPI nào đang ở trạng thái <strong>Dự kiến</strong> hoặc <strong>Đang diễn ra</strong>. Vui lòng liên hệ bộ phận Nhân sự (HR) để mở kỳ đánh giá.
                        </div>
                    </div>
                }
                else if (!Model.ScopedEmployees.Any())
                {
                    <div class="alert alert-warning d-flex align-items-center" role="alert">
                        <i class="fa-solid fa-users-slash me-2 fs-4"></i>
                        <div>
                            Không có nhân viên hợp lệ nào trong phạm vi quản lý của bạn để tạo đánh giá.
                        </div>
                    </div>
                }
                else
                {
                    <form method="post" asp-action="Create">
                        @Html.AntiForgeryToken()
                        <div class="mb-4">
                            <label class="form-label fw-semibold">1. Kỳ đánh giá KPI <span class="text-danger">*</span></label>
                            <select name="PeriodId" class="form-select form-select-lg" required>
                                <option value="">-- Vui lòng chọn kỳ đánh giá --</option>
                                @foreach (var p in Model.Periods)
                                {
                                    <option value="@p.Id" selected="@(Model.SelectedPeriodId == p.Id)">
                                        @p.Name [@(p.Status == "ACTIVE" ? "Đang diễn ra" : "Dự kiến")] (@p.StartDate.ToString("dd/MM/yyyy") - @p.EndDate.ToString("dd/MM/yyyy"))
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold">2. Nhân viên được đánh giá <span class="text-danger">*</span></label>
                            <select name="EmployeeId" class="form-select form-select-lg" required>
                                <option value="">-- Vui lòng chọn nhân viên trong phạm vi --</option>
                                @foreach (var e in Model.ScopedEmployees)
                                {
                                    <option value="@e.Id" selected="@(Model.SelectedEmployeeId == e.Id)">
                                        @e.Name - @e.EmployeeCode (@e.Department / @e.JobTitle)
                                    </option>
                                }
                            </select>
                            <div class="form-text text-muted mt-2">
                                <i class="fa-solid fa-circle-info me-1"></i>Hệ thống chỉ hiển thị những nhân viên thuộc phạm vi phân công quản lý hiện tại của bạn.
                            </div>
                        </div>

                        <div class="alert alert-info bg-opacity-10 border-info border-opacity-25 small mb-4">
                            <div class="fw-bold mb-1"><i class="fa-solid fa-lightbulb me-1"></i>Quy trình đánh giá KPI:</div>
                            <ol class="ps-3 mb-0">
                                <li>Sau khi khởi tạo, đánh giá sẽ ở trạng thái <strong>Bản nháp (DRAFT)</strong>.</li>
                                <li>Quản lý sẽ tiến hành thiết lập các mục tiêu và trọng số sao cho <strong>tổng trọng số bằng đúng 100%</strong>.</li>
                                <li>Quản lý bấm <strong>Kích hoạt</strong> để chuyển sang <strong>Đang thực hiện (ACTIVE)</strong> cho nhân viên cập nhật tiến độ.</li>
                            </ol>
                        </div>

                        <div class="d-flex justify-content-end gap-2 pt-2">
                            <a href="@Url.Action("Index", "ManagerKPI")" class="btn btn-light px-4">Hủy bỏ</a>
                            <button type="submit" class="btn btn-primary px-4"><i class="fa-solid fa-check me-1"></i>Tiếp tục: Thiết lập mục tiêu</button>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
