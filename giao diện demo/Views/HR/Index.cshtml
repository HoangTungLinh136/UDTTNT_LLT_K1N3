@model giao_dien_demo.Models.HRWorkspaceViewModel
@{ ViewData["Title"] = "Tổng quan nhân sự"; }
<style>
.hr-dashboard{display:flex;flex-direction:column;gap:24px;max-width:1440px}.hr-columns{display:grid;grid-template-columns:minmax(0,2fr) minmax(280px,1fr);gap:16px}.hr-quick{display:flex;flex-wrap:wrap;gap:10px}.hr-empty{text-align:center;padding:40px 16px;color:#64748b}.hr-table-wrap{overflow:auto}@@media(max-width:900px){.hr-columns{grid-template-columns:1fr}}
</style>
<div class="hr-dashboard">
 <div class="hrms-page-header"><div class="hrms-page-header-main"><h1 class="hrms-page-title"><span class="hrms-page-icon blue"><i class="fa-solid fa-people-group"></i></span>Tổng quan nhân sự</h1><p class="hrms-page-subtitle">Theo dõi tình hình nhân sự và các hồ sơ cần xử lý.</p></div></div>
 <section class="hrms-kpi-grid hrms-kpi-grid-4"><div class="hrms-kpi-card kpi-blue"><div class="hrms-kpi-top"><div class="hrms-kpi-icon"><i class="fa-solid fa-users"></i></div></div><div class="hrms-kpi-body"><div class="hrms-kpi-label">Nhân viên đang làm việc</div><div class="hrms-kpi-value kpi-blue">@Model.ActiveEmployeeCount.ToString("N0")</div></div></div><div class="hrms-kpi-card kpi-green"><div class="hrms-kpi-top"><div class="hrms-kpi-icon"><i class="fa-solid fa-user-check"></i></div></div><div class="hrms-kpi-body"><div class="hrms-kpi-label">Có mặt hôm nay</div><div class="hrms-kpi-value kpi-green">@Model.PresentTodayCount.ToString("N0")</div></div></div><div class="hrms-kpi-card kpi-yellow"><div class="hrms-kpi-top"><div class="hrms-kpi-icon"><i class="fa-solid fa-list-check"></i></div></div><div class="hrms-kpi-body"><div class="hrms-kpi-label">Việc cần xử lý</div><div class="hrms-kpi-value kpi-yellow">@Model.PendingActionCount.ToString("N0")</div></div></div><div class="hrms-kpi-card kpi-red"><div class="hrms-kpi-top"><div class="hrms-kpi-icon"><i class="fa-solid fa-file-circle-exclamation"></i></div></div><div class="hrms-kpi-body"><div class="hrms-kpi-label">Hợp đồng hết hạn trong 30 ngày</div><div class="hrms-kpi-value kpi-red">@Model.ExpiringContractCount.ToString("N0")</div></div></div></section>
 <section class="hrms-card"><div class="hrms-card-header"><h2 class="hrms-card-title">Việc cần xử lý</h2></div><div class="hrms-card-body p-0">@if(Model.PendingWork.Any()){<div class="hr-table-wrap"><table class="hrms-table"><thead><tr><th>Mã</th><th>Loại</th><th>Nhân viên</th><th>Nội dung</th><th>Thời gian</th><th></th></tr></thead><tbody>@foreach(var item in Model.PendingWork){<tr><td><strong>@item.Code</strong></td><td>@item.Type</td><td>@item.EmployeeName</td><td>@item.Summary</td><td>@item.SubmittedAt.ToString("dd/MM/yyyy HH:mm")</td><td><a class="hrms-btn hrms-btn-sm hrms-btn-ghost" href="@(Url.Action(item.Action, item.Controller) + item.RouteQuery)">Mở</a></td></tr>}</tbody></table></div>}else{<div class="hr-empty"><h5>Không có hồ sơ cần xử lý</h5><p>Tất cả công việc hiện đã được cập nhật.</p></div>}</div></section>
 <div class="hr-columns"><section class="hrms-card"><div class="hrms-card-header"><h2 class="hrms-card-title">Truy cập nhanh</h2></div><div class="hrms-card-body"><div class="hr-quick"><a class="hrms-btn hrms-btn-primary" asp-controller="Employee" asp-action="Create"><i class="fa-solid fa-user-plus"></i> Tạo hồ sơ nhân viên</a><a class="hrms-btn hrms-btn-secondary" asp-controller="Onboarding" asp-action="Index">Hội nhập</a><a class="hrms-btn hrms-btn-secondary" asp-controller="Contract" asp-action="Create">Tạo hợp đồng</a><a class="hrms-btn hrms-btn-secondary" asp-controller="TaskTracking" asp-action="Index">Công việc HR</a></div></div></section><section class="hrms-card"><div class="hrms-card-header"><h2 class="hrms-card-title">Nhân sự theo đơn vị</h2></div><div class="hrms-card-body p-0">@if(Model.Departments.Any()){<div class="hr-table-wrap"><table class="hrms-table"><thead><tr><th>Đơn vị</th><th class="text-end">Nhân viên</th></tr></thead><tbody>@foreach(var d in Model.Departments){<tr><td>@d.Department</td><td class="text-end"><strong>@d.Employees</strong></td></tr>}</tbody></table></div>}else{<div class="hr-empty">Chưa có dữ liệu đơn vị.</div>}</div></section></div>
</div>
