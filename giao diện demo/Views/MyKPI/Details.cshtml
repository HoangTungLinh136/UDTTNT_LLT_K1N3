@model giao_dien_demo.Models.MyKPIDetailViewModel
@{
    ViewData["Title"] = "Chi tiết KPI - " + (Model.Evaluation.Period?.Name ?? "Kỳ đánh giá");
    var eval = Model.Evaluation;
    var isActive = eval.Status == "ACTIVE";
    var isCompleted = eval.Status == "COMPLETED";
    var isEvaluating = eval.Status == "EVALUATING";
}

<div class="hrms-page-header mb-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h1 class="hrms-page-title mb-1">
                <i class="fa-solid fa-bullseye text-primary me-2"></i>Chi tiết KPI: @(eval.Period?.Name ?? "Kỳ đánh giá")
            </h1>
            <div class="hrms-breadcrumb text-muted small">
                <a href="@Url.Action("Index", "MyKPI")" class="text-decoration-none text-muted">KPI của tôi</a>
                <i class="fa-solid fa-chevron-right mx-1"></i>
                <span class="text-dark fw-medium">Chi tiết đánh giá #@eval.Id</span>
            </div>
        </div>
        <div>
            <a href="@Url.Action("Index", "MyKPI")" class="btn btn-outline-secondary">
                <i class="fa-solid fa-arrow-left me-1"></i>Quay lại danh sách
            </a>
        </div>
    </div>
</div>

<div id="alertPlaceholder"></div>

<div class="row g-4 mb-4">
    <div class="col-md-8">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <h5 class="fw-bold mb-1">@eval.Period?.Name</h5>
                        <div class="text-muted small">
                            <i class="fa-regular fa-calendar me-1"></i>
                            Thời gian: <strong>@eval.Period?.StartDate.ToString("dd/MM/yyyy") - @eval.Period?.EndDate.ToString("dd/MM/yyyy")</strong>
                        </div>
                    </div>
                    <div>
                        @if (isActive)
                        {
                            <span class="badge bg-primary px-3 py-2 fs-6"><i class="fa-solid fa-spinner fa-spin me-1"></i>Đang thực hiện</span>
                        }
                        else if (isEvaluating)
                        {
                            <span class="badge bg-warning text-dark px-3 py-2 fs-6"><i class="fa-solid fa-pen-ruler me-1"></i>Đang đánh giá</span>
                        }
                        else if (isCompleted)
                        {
                            <span class="badge bg-success px-3 py-2 fs-6"><i class="fa-solid fa-circle-check me-1"></i>Hoàn thành</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary px-3 py-2 fs-6">@eval.Status</span>
                        }
                    </div>
                </div>
                <hr />
                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="text-muted small">Quản lý trực tiếp phụ trách</div>
                        <div class="fw-bold">@(eval.ManagerUsernameSnapshot ?? "Quản lý")</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small">Quyền hạn của nhân viên</div>
                        <div>
                            @if (isActive)
                            {
                                <span class="text-primary fw-medium"><i class="fa-solid fa-pen me-1"></i>Được phép tự cập nhật tiến độ</span>
                            }
                            else
                            {
                                <span class="text-muted"><i class="fa-solid fa-lock me-1"></i>Chế độ chỉ xem (Tiến độ đã khóa)</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body p-4 text-center d-flex flex-column justify-content-center">
                @if (isCompleted)
                {
                    <div class="text-success small fw-bold text-uppercase mb-1">Kết quả KPI của bạn</div>
                    <div class="display-5 fw-bold text-success mb-2">@eval.FinalScore?.ToString("0.00")</div>
                    <div>
                        <span class="badge bg-success fs-5 px-3 py-1">Xếp loại: @eval.FinalRating</span>
                    </div>
                    <div class="small text-muted mt-3">
                        Đã hoàn tất ngày @eval.CompletedAt?.ToString("dd/MM/yyyy")
                    </div>
                }
                else
                {
                    <div class="text-muted small fw-bold text-uppercase mb-1">Tiến độ trung bình của bạn</div>
                    <div class="display-6 fw-bold text-info mb-2" id="overallProgressDisplay">@Model.ProgressAverage%</div>
                    <div class="progress mb-2" style="height: 10px;">
                        <div class="progress-bar bg-info" id="overallProgressBar" style="width: @(Model.ProgressAverage)%;"></div>
                    </div>
                    <div class="small text-muted">@Model.Targets.Count mục tiêu được giao</div>
                }
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-transparent border-0 pt-4 px-4">
        <h5 class="fw-bold mb-0">Danh sách Mục tiêu được giao</h5>
        <div class="text-muted small">
            @if (isActive)
            {
                <span>Bạn có thể kéo thanh tiến độ hoặc nhập % và bấm <strong>Cập nhật</strong> cho từng mục tiêu.</span>
            }
            else
            {
                <span>Đánh giá này đã kết thúc thời gian tự cập nhật tiến độ.</span>
            }
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4" style="width: 50px;">STT</th>
                        <th>Tên mục tiêu & Yêu cầu</th>
                        <th style="width: 130px;">Trọng số</th>
                        <th style="width: 320px;">Tiến độ hoàn thành (%)</th>
                        @if (isCompleted)
                        {
                            <th style="width: 140px;" class="text-end pe-4">Điểm đánh giá</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @{ int idx = 1; }
                    @foreach (var t in Model.Targets)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-muted">@(idx++)</td>
                            <td>
                                <div class="fw-semibold text-dark">@t.Title</div>
                                <div class="small text-muted">@(string.IsNullOrEmpty(t.Description) ? "Không có mô tả chi tiết" : t.Description)</div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@t.Weight.ToString("0.00")%</span>
                            </td>
                            <td>
                                @if (isActive)
                                {
                                    <div class="d-flex align-items-center gap-2" id="target-row-@t.Id">
                                        <input type="range" class="form-range flex-grow-1" min="0" max="100" step="5" 
                                               id="range-@t.Id" value="@t.Progress" 
                                               oninput="document.getElementById('num-@t.Id').value = this.value" />
                                        <div class="input-group input-group-sm" style="width: 110px;">
                                            <input type="number" min="0" max="100" class="form-control text-center" 
                                                   id="num-@t.Id" value="@t.Progress" 
                                                   oninput="document.getElementById('range-@t.Id').value = this.value" />
                                            <span class="input-group-text">%</span>
                                        </div>
                                        <button type="button" class="btn btn-sm btn-primary" onclick="submitProgress(@t.Id)">
                                            <i class="fa-solid fa-check"></i>
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <div class="d-flex align-items-center">
                                        <div class="progress flex-grow-1 me-2" style="height: 8px;">
                                            <div class="progress-bar bg-info" style="width: @(t.Progress)%;"></div>
                                        </div>
                                        <span class="fw-bold small">@t.Progress%</span>
                                    </div>
                                }
                            </td>
                            @if (isCompleted)
                            {
                                <td class="text-end pe-4 fw-bold text-success">
                                    @(t.ManagerScore.HasValue ? t.ManagerScore.Value.ToString("0.0") : "--") / 100
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

<script>
function showAlert(message, type) {
    var placeholder = document.getElementById('alertPlaceholder');
    placeholder.innerHTML = `
        <div class="alert alert-${type} alert-dismissible fade show d-flex align-items-center" role="alert">
            <i class="fa-solid fa-${type === 'success' ? 'circle-check' : 'triangle-exclamation'} me-2 fs-5"></i>
            <div>${message}</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    `;
}

function submitProgress(targetId) {
    var val = document.getElementById('num-' + targetId).value;
    var progress = parseFloat(val);
    if (isNaN(progress) || progress < 0 || progress > 100) {
        showAlert('Tiến độ phải là con số từ 0 đến 100%.', 'danger');
        return;
    }

    var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

    fetch('@Url.Action("UpdateProgress", "MyKPI")', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': token
        },
        body: JSON.stringify({ targetId: targetId, progress: progress })
    })
    .then(res => res.json())
    .then(data => {
        if (data.success) {
            showAlert(data.message, 'success');
        } else {
            showAlert(data.message || 'Không thể cập nhật tiến độ.', 'danger');
        }
    })
    .catch(err => {
        showAlert('Đã xảy ra lỗi kết nối khi lưu tiến độ.', 'danger');
    });
}
</script>
