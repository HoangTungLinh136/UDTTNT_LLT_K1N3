@model IEnumerable<giao_dien_demo.Models.Salary>
@{
    ViewData["Title"] = "Báo cáo thuế";
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="mb-1 fw-bold text-dark">Báo cáo thuế</h3>
        <p class="text-muted mb-0">Theo dõi thu nhập chịu thuế và số thuế khấu trừ.</p>
    </div>
    <div class="d-flex gap-2">
        <button id="btnReconcile" class="btn btn-outline-primary" onclick="reconcileTax()">
            <i class="fas fa-sync-alt me-2"></i>Đối chiếu
        </button>
        <a href="/PayrollTaxReport/ExportExcel?period=@ViewBag.FilterPeriod&department=@ViewBag.FilterDepartment&mstStatus=@ViewBag.FilterMstStatus&employee=@ViewBag.FilterEmployee" class="btn btn-success">
            <i class="fas fa-file-excel me-2"></i>Xuất Excel
        </a>
    </div>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
            <div class="card-body p-3 d-flex align-items-center">
                <div class="rounded-circle bg-primary bg-opacity-10 p-3 me-3 text-primary">
                    <i class="fas fa-file-invoice-dollar fs-4"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1 text-uppercase fw-semibold" style="font-size:0.75rem">Thu nhập chịu thuế</h6>
                    <h4 class="mb-0 fw-bold text-dark">@string.Format("{0:N0}", ViewBag.TotalTaxableIncome ?? 0) ₫</h4>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
            <div class="card-body p-3 d-flex align-items-center">
                <div class="rounded-circle bg-danger bg-opacity-10 p-3 me-3 text-danger">
                    <i class="fas fa-hand-holding-usd fs-4"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1 text-uppercase fw-semibold" style="font-size:0.75rem">Thuế đã khấu trừ</h6>
                    <h4 class="mb-0 fw-bold text-dark">@string.Format("{0:N0}", ViewBag.TotalTaxWithheld ?? 0) ₫</h4>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
            <div class="card-body p-3 d-flex align-items-center">
                <div class="rounded-circle bg-success bg-opacity-10 p-3 me-3 text-success">
                    <i class="fas fa-users fs-4"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1 text-uppercase fw-semibold" style="font-size:0.75rem">Nhân viên phát sinh thuế</h6>
                    <h4 class="mb-0 fw-bold text-dark">@string.Format("{0:N0}", ViewBag.TaxableEmployeeCount ?? 0)</h4>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
            <div class="card-body p-3 d-flex align-items-center">
                <div class="rounded-circle bg-warning bg-opacity-10 p-3 me-3 text-warning">
                    <i class="fas fa-id-card-alt fs-4"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1 text-uppercase fw-semibold" style="font-size:0.75rem">Thiếu MST</h6>
                    <h4 class="mb-0 fw-bold text-dark">@string.Format("{0:N0}", ViewBag.MissingTaxCodeCount ?? 0)</h4>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" action="/PayrollTaxReport/Index" class="row g-2 align-items-center">
            <!-- Kỳ lương -->
            <div class="col-md-2">
                <select name="period" class="form-select bg-light text-muted">
                    <option value="">-- Kỳ lương --</option>
                    @for (int i = 0; i < 5; i++)
                    {
                        var periodVal = DateTime.Now.AddMonths(-i).ToString("MM/yyyy");
                        <!option value="@periodVal" @(ViewBag.FilterPeriod == periodVal ? "selected" : "")>Kỳ @periodVal</!option>
                    }
                </select>
            </div>
            
            <!-- Phòng ban -->
            <div class="col-md-3">
                <select name="department" class="form-select bg-light text-muted">
                    <option value="">-- Tất cả phòng ban --</option>
                    @if (ViewBag.Departments != null)
                    {
                        foreach (var dept in ViewBag.Departments)
                        {
                            <!option value="@dept" @(ViewBag.FilterDepartment == dept ? "selected" : "")>@dept</!option>
                        }
                    }
                </select>
            </div>

            <!-- Trạng thái MST -->
            <div class="col-md-3">
                <select name="mstStatus" class="form-select bg-light text-muted">
                    <!option value="" @(string.IsNullOrEmpty(ViewBag.FilterMstStatus) ? "selected" : "")>-- Trạng thái MST --</!option>
                    <!option value="Valid" @(ViewBag.FilterMstStatus == "Valid" ? "selected" : "")>Đã có MST</!option>
                    <!option value="Missing" @(ViewBag.FilterMstStatus == "Missing" ? "selected" : "")>Thiếu MST</!option>
                </select>
            </div>

            <!-- Nhân viên -->
            <div class="col-md-2">
                <input type="text" name="employee" class="form-control bg-light" placeholder="Tìm tên nhân viên..." value="@ViewBag.FilterEmployee">
            </div>

            <div class="col-md-auto ms-auto">
                <button type="submit" class="btn btn-primary px-4 rounded-3">Lọc</button>
                <a href="/PayrollTaxReport/Index" class="btn btn-light px-4 rounded-3 ms-2">Đặt lại</a>
            </div>
        </form>
    </div>
</div>

<!-- Data Table -->
<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size:0.95rem">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4 py-3 text-muted fw-semibold">Mã NV</th>
                        <th class="py-3 text-muted fw-semibold">Nhân viên</th>
                        <th class="py-3 text-muted fw-semibold">MST</th>
                        <th class="py-3 text-end text-muted fw-semibold">Tổng thu nhập</th>
                        <th class="py-3 text-end text-muted fw-semibold">Thu nhập chịu thuế</th>
                        <th class="py-3 text-end text-muted fw-semibold">Giảm trừ</th>
                        <th class="py-3 text-end text-muted fw-semibold">Thuế khấu trừ</th>
                        <th class="pe-4 py-3 text-center text-muted fw-semibold">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var row in Model)
                        {
                            <tr class="border-bottom">
                                <td class="ps-4 text-muted">EMP@(row.EmployeeId?.ToString("D3") ?? "000")</td>
                                <td>
                                    <div class="fw-bold text-dark">@row.EmployeeName</div>
                                    <div class="text-muted small">@row.DepartmentName</div>
                                </td>
                                <td>
                                    @if (string.IsNullOrEmpty(row.TaxCode))
                                    {
                                        <span class="badge bg-warning text-dark"><i class="fas fa-exclamation-triangle me-1"></i>Thiếu MST</span>
                                    }
                                    else
                                    {
                                        <span class="text-dark">@row.TaxCode</span>
                                    }
                                </td>
                                <td class="text-end fw-semibold">@string.Format("{0:N0}", row.TotalSalary) ₫</td>
                                <td class="text-end fw-semibold text-primary">@string.Format("{0:N0}", row.TaxableIncome) ₫</td>
                                <td class="text-end text-muted">@string.Format("{0:N0}", row.TotalDeduction) ₫</td>
                                <td class="text-end fw-bold text-danger">@string.Format("{0:N0}", row.TaxTNCN) ₫</td>
                                <td class="pe-4 text-center">
                                    <button class="btn btn-sm btn-light text-primary rounded-circle" 
                                            title="Xem chi tiết thuế"
                                            onclick="openDetailDrawer('@row.EmployeeName', '@row.DepartmentName', '@(row.TaxCode ?? "")', @row.TotalSalary, @row.TaxableIncome, @row.TotalDeduction, @row.TaxTNCN)">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5">
                                <div class="text-muted mb-2"><i class="fas fa-inbox fs-2"></i></div>
                                <h6 class="fw-bold mb-1">Không có dữ liệu.</h6>
                                <p class="text-muted mb-0 small">Chưa có dữ liệu thuế phù hợp với bộ lọc đã chọn.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Offcanvas Detail Panel (Right Drawer) -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="taxDetailDrawer" aria-labelledby="taxDetailLabel" style="width: 450px;">
    <div class="offcanvas-header border-bottom bg-light">
        <h5 class="offcanvas-title fw-bold" id="taxDetailLabel">Chi tiết thuế</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <div id="taxDetailEmpty" class="text-center py-5">
            <div class="text-muted mb-2"><i class="fas fa-hand-pointer fs-2"></i></div>
            <p class="text-muted">Chọn một kỳ lương hoặc nhân viên để xem chi tiết thuế.</p>
        </div>
        
        <div id="taxDetailContent" class="d-none">
            <!-- Basic Info -->
            <div class="d-flex align-items-center mb-4">
                <div class="rounded-circle bg-primary bg-opacity-10 p-3 me-3 text-primary">
                    <i class="fas fa-user fs-4"></i>
                </div>
                <div>
                    <h5 class="mb-0 fw-bold text-dark" id="detailEmployeeName">Nguyễn Văn A</h5>
                    <p class="text-muted mb-0 small" id="detailDepartment">IT Department</p>
                </div>
            </div>

            <!-- Tax Code Info -->
            <div class="mb-4">
                <h6 class="fw-bold text-muted text-uppercase" style="font-size:0.8rem">Mã số thuế</h6>
                <div id="detailTaxCodeContainer" class="p-3 bg-light rounded-3 border">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold fs-5" id="detailTaxCode">123456789</span>
                        <span class="badge bg-success" id="detailTaxStatus">Hợp lệ</span>
                    </div>
                </div>
            </div>

            <!-- Breakdown -->
            <div class="mb-4">
                <h6 class="fw-bold text-muted text-uppercase" style="font-size:0.8rem">Tổng quan thu nhập</h6>
                <ul class="list-group list-group-flush border-top border-bottom">
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-3">
                        <span class="text-muted">Tổng thu nhập</span>
                        <span class="fw-bold text-dark" id="detailTotalIncome">0 ₫</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-3">
                        <span class="text-muted">Các khoản giảm trừ</span>
                        <span class="fw-bold text-muted" id="detailDeduction">0 ₫</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-3 bg-light">
                        <span class="fw-semibold text-dark">Thu nhập chịu thuế</span>
                        <span class="fw-bold text-primary fs-5" id="detailTaxableIncome">0 ₫</span>
                    </li>
                </ul>
            </div>
            
            <div class="mb-4">
                <h6 class="fw-bold text-muted text-uppercase" style="font-size:0.8rem">Kết quả tính thuế</h6>
                <div class="p-3 bg-danger bg-opacity-10 rounded-3 border border-danger border-opacity-25 text-center">
                    <span class="d-block text-danger mb-1 fw-semibold">Thuế đã khấu trừ</span>
                    <h3 class="mb-0 text-danger fw-bold" id="detailTaxWithheld">0 ₫</h3>
                </div>
            </div>
            
            <div class="text-muted small text-center mt-auto pt-3">
                Dữ liệu thuộc Kỳ lương: <span class="fw-semibold text-dark">@ViewBag.FilterPeriod</span>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const currencyFormat = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' });

        function openDetailDrawer(name, department, taxCode, totalIncome, taxableIncome, deduction, taxWithheld) {
            // Hide empty state, show content
            document.getElementById('taxDetailEmpty').classList.add('d-none');
            document.getElementById('taxDetailContent').classList.remove('d-none');
            
            // Populate data
            document.getElementById('detailEmployeeName').innerText = name;
            document.getElementById('detailDepartment').innerText = department;
            
            let taxCodeEl = document.getElementById('detailTaxCode');
            let taxStatusEl = document.getElementById('detailTaxStatus');
            
            if (!taxCode) {
                taxCodeEl.innerText = "Chưa có mã số thuế.";
                taxCodeEl.classList.remove('fs-5');
                taxCodeEl.classList.add('text-muted');
                taxStatusEl.className = "badge bg-warning text-dark";
                taxStatusEl.innerText = "Thiếu MST";
            } else {
                taxCodeEl.innerText = taxCode;
                taxCodeEl.classList.add('fs-5');
                taxCodeEl.classList.remove('text-muted');
                taxStatusEl.className = "badge bg-success";
                taxStatusEl.innerText = "Đã cập nhật";
            }
            
            document.getElementById('detailTotalIncome').innerText = currencyFormat.format(totalIncome);
            document.getElementById('detailTaxableIncome').innerText = currencyFormat.format(taxableIncome);
            document.getElementById('detailDeduction').innerText = "-" + currencyFormat.format(deduction);
            document.getElementById('detailTaxWithheld').innerText = currencyFormat.format(taxWithheld);
            
            // Open Offcanvas
            var myOffcanvas = new bootstrap.Offcanvas(document.getElementById('taxDetailDrawer'));
            myOffcanvas.show();
        }

        function reconcileTax() {
            let btn = document.getElementById('btnReconcile');
            let originalContent = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Đang đối chiếu...';
            btn.disabled = true;
            
            fetch('/PayrollTaxReport/Reconcile', { method: 'POST' })
                .then(response => response.json())
                .then(data => {
                    btn.innerHTML = originalContent;
                    btn.disabled = false;
                    
                    if (data.success) {
                        alert(data.message);
                    } else {
                        alert("Có lỗi xảy ra khi đối chiếu dữ liệu thuế.");
                    }
                })
                .catch(error => {
                    btn.innerHTML = originalContent;
                    btn.disabled = false;
                    alert("Lỗi kết nối tới server.");
                });
        }
    </script>
}
