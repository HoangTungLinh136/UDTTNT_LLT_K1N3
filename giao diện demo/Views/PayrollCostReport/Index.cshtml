@model IEnumerable<giao_dien_demo.Models.Salary>
@{
    ViewData["Title"] = "Báo cáo chi phí";
    
    // Build JSON cho Chart.js
    var deptData = ViewBag.DepartmentData as IEnumerable<dynamic>;
    
    var chartLabels = new List<string>();
    var chartCosts = new List<double>();
    
    if (deptData != null)
    {
        foreach (var item in deptData)
        {
            chartLabels.Add(item.DepartmentName);
            chartCosts.Add(item.TotalCost);
        }
    }
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="mb-1 fw-bold text-dark">Báo cáo chi phí</h3>
        <p class="text-muted mb-0">Phân tích tổng chi phí nhân sự theo kỳ lương.</p>
    </div>
    <div class="d-flex gap-2">
        <a href="/PayrollCostReport/ExportExcel?period=@ViewBag.FilterPeriod&department=@ViewBag.FilterDepartment" class="btn btn-outline-success">
            <i class="fas fa-file-excel me-2"></i>Xuất Excel
        </a>
        <button onclick="window.print()" class="btn btn-primary">
            <i class="fas fa-print me-2"></i>In báo cáo
        </button>
    </div>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-md">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
            <div class="card-body p-3 d-flex align-items-center">
                <div class="rounded-circle bg-primary bg-opacity-10 p-3 me-3 text-primary">
                    <i class="fas fa-money-bill-wave fs-4"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1 text-uppercase fw-semibold" style="font-size:0.75rem">Tổng chi phí</h6>
                    <h4 class="mb-0 fw-bold text-dark">@string.Format("{0:N0}", ViewBag.TotalCost ?? 0) ₫</h4>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
            <div class="card-body p-3 d-flex align-items-center">
                <div class="rounded-circle bg-success bg-opacity-10 p-3 me-3 text-success">
                    <i class="fas fa-wallet fs-4"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1 text-uppercase fw-semibold" style="font-size:0.75rem">Tổng lương</h6>
                    <h4 class="mb-0 fw-bold text-dark">@string.Format("{0:N0}", ViewBag.TotalPerformanceSalary ?? 0) ₫</h4>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
            <div class="card-body p-3 d-flex align-items-center">
                <div class="rounded-circle bg-warning bg-opacity-10 p-3 me-3 text-warning">
                    <i class="fas fa-clock fs-4"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1 text-uppercase fw-semibold" style="font-size:0.75rem">Tổng OT</h6>
                    <h4 class="mb-0 fw-bold text-dark">@string.Format("{0:N0}", ViewBag.TotalOT ?? 0) ₫</h4>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
            <div class="card-body p-3 d-flex align-items-center">
                <div class="rounded-circle bg-info bg-opacity-10 p-3 me-3 text-info">
                    <i class="fas fa-hand-holding-usd fs-4"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1 text-uppercase fw-semibold" style="font-size:0.75rem">Tổng phụ cấp</h6>
                    <h4 class="mb-0 fw-bold text-dark">@string.Format("{0:N0}", ViewBag.TotalAllowance ?? 0) ₫</h4>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
            <div class="card-body p-3 d-flex align-items-center">
                <div class="rounded-circle bg-danger bg-opacity-10 p-3 me-3 text-danger">
                    <i class="fas fa-gift fs-4"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1 text-uppercase fw-semibold" style="font-size:0.75rem">Tổng thưởng</h6>
                    <h4 class="mb-0 fw-bold text-dark">@string.Format("{0:N0}", ViewBag.TotalBonus ?? 0) ₫</h4>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm rounded-4 mb-4 d-print-none">
    <div class="card-body p-3">
        <form method="get" action="/PayrollCostReport/Index" class="row g-2 align-items-center">
            <!-- Kỳ lương -->
            <div class="col-md-2">
                <select name="period" class="form-select bg-light text-muted">
                    <option value="">-- Kỳ lương --</option>
                    @for (int i = 0; i < 5; i++)
                    {
                        var periodVal = DateTime.Now.AddMonths(-i).ToString("MM/yyyy");
                        <!option value="@periodVal" @(ViewBag.FilterPeriod == periodVal ? "selected" : "")>Kỳ @periodVal</!option>
                    }
                </select>
            </div>
            
            <!-- Từ ngày -->
            <div class="col-md-2">
                <input type="date" name="fromDate" class="form-control bg-light" value="@ViewBag.FilterFromDate" placeholder="Từ ngày">
            </div>
            <!-- Đến ngày -->
            <div class="col-md-2">
                <input type="date" name="toDate" class="form-control bg-light" value="@ViewBag.FilterToDate" placeholder="Đến ngày">
            </div>
            
            <!-- Phòng ban -->
            <div class="col-md-2">
                <select name="department" class="form-select bg-light text-muted">
                    <option value="">-- Tất cả phòng ban --</option>
                    @if (ViewBag.Departments != null)
                    {
                        foreach (var dept in ViewBag.Departments)
                        {
                            <!option value="@dept" @(ViewBag.FilterDepartment == dept ? "selected" : "")>@dept</!option>
                        }
                    }
                </select>
            </div>

            <!-- Nhân viên -->
            <div class="col-md-2">
                <input type="text" name="employee" class="form-control bg-light" placeholder="Tên nhân viên..." value="@ViewBag.FilterEmployee">
            </div>

            <div class="col-md-auto ms-auto">
                <button type="submit" class="btn btn-primary px-4 rounded-3">Lọc</button>
                <a href="/PayrollCostReport/Index" class="btn btn-light px-4 rounded-3 ms-2">Đặt lại</a>
            </div>
        </form>
    </div>
</div>

<!-- Charts Section -->
<div class="row g-4 mb-4">
    <!-- Trend Chart -->
    <div class="col-md-8">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                <h6 class="fw-bold mb-0">Xu hướng chi phí theo Phòng ban</h6>
            </div>
            <div class="card-body">
                @if (chartCosts.Any(c => c > 0))
                {
                    <canvas id="trendChart" style="height: 300px; width: 100%;"></canvas>
                }
                else
                {
                    <div class="d-flex justify-content-center align-items-center h-100 text-muted">
                        <div class="text-center">
                            <i class="fas fa-chart-bar fs-2 mb-2"></i>
                            <p>Chưa có dữ liệu để hiển thị biểu đồ.</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
    
    <!-- Structure Chart -->
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                <h6 class="fw-bold mb-0">Cơ cấu chi phí</h6>
            </div>
            <div class="card-body d-flex justify-content-center align-items-center">
                @if (ViewBag.TotalCost != null && ViewBag.TotalCost > 0)
                {
                    <canvas id="structureChart" style="max-height: 250px;"></canvas>
                }
                else
                {
                    <div class="text-center text-muted">
                        <i class="fas fa-chart-pie fs-2 mb-2"></i>
                        <p>Chưa có dữ liệu để hiển thị biểu đồ.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Data Table -->
<div class="card border-0 shadow-sm rounded-4">
    <div class="card-header bg-white border-bottom pt-4 pb-3">
        <h6 class="fw-bold mb-0">Tổng hợp chi phí theo Phòng ban</h6>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size:0.95rem">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4 py-3 text-muted fw-semibold">Phòng ban</th>
                        <th class="py-3 text-end text-muted fw-semibold">Số nhân viên</th>
                        <th class="py-3 text-end text-muted fw-semibold">Lương</th>
                        <th class="py-3 text-end text-muted fw-semibold">Chi phí OT</th>
                        <th class="py-3 text-end text-muted fw-semibold">Phụ cấp</th>
                        <th class="py-3 text-end text-muted fw-semibold">Thưởng</th>
                        <th class="pe-4 py-3 text-end fw-bold text-dark">Tổng chi phí</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @if (deptData != null && deptData.Any())
                    {
                        foreach (var dept in deptData)
                        {
                            <tr class="border-bottom">
                                <td class="ps-4 fw-bold text-primary">@dept.DepartmentName</td>
                                <td class="text-end">@dept.EmployeeCount</td>
                                <td class="text-end">@string.Format("{0:N0}", dept.SalaryCost)</td>
                                <td class="text-end">@string.Format("{0:N0}", dept.OvertimeCost)</td>
                                <td class="text-end">@string.Format("{0:N0}", dept.AllowanceCost)</td>
                                <td class="text-end">@string.Format("{0:N0}", dept.BonusCost)</td>
                                <td class="pe-4 text-end fw-bold text-danger bg-light">@string.Format("{0:N0}", dept.TotalCost) ₫</td>
                            </tr>
                        }
                        
                        <tr class="bg-light fw-bold border-top" style="border-top-width: 2px !important;">
                            <td class="ps-4">TỔNG CỘNG</td>
                            <td class="text-end">@Model.Select(m => m.EmployeeId).Distinct().Count()</td>
                            <td class="text-end">@string.Format("{0:N0}", ViewBag.TotalPerformanceSalary)</td>
                            <td class="text-end">@string.Format("{0:N0}", ViewBag.TotalOT)</td>
                            <td class="text-end">@string.Format("{0:N0}", ViewBag.TotalAllowance)</td>
                            <td class="text-end">@string.Format("{0:N0}", ViewBag.TotalBonus)</td>
                            <td class="pe-4 text-end text-danger fs-6">@string.Format("{0:N0}", ViewBag.TotalCost) ₫</td>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                <div class="text-muted mb-2"><i class="fas fa-inbox fs-2"></i></div>
                                <h6 class="fw-bold mb-1">Chưa có dữ liệu báo cáo.</h6>
                                <p class="text-muted mb-0 small">Không có dữ liệu chi phí nào thỏa mãn bộ lọc hiện tại.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            
            // Format Tooltip as Currency
            const currencyFormat = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' });

            // 1. Trend Chart (Xu hướng theo phòng ban)
            @if (chartCosts.Any(c => c > 0))
            {
                <text>
                const trendCtx = document.getElementById('trendChart').getContext('2d');
                new Chart(trendCtx, {
                    type: 'bar',
                    data: {
                        labels: @Html.Raw(Json.Serialize(chartLabels)),
                        datasets: [{
                            label: 'Tổng chi phí',
                            data: @Html.Raw(Json.Serialize(chartCosts)),
                            backgroundColor: 'rgba(54, 162, 235, 0.6)',
                            borderColor: 'rgba(54, 162, 235, 1)',
                            borderWidth: 1,
                            borderRadius: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        return currencyFormat.format(context.raw);
                                    }
                                }
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    callback: function(value) {
                                        if (value >= 1000000) return (value / 1000000) + 'M';
                                        if (value >= 1000) return (value / 1000) + 'k';
                                        return value;
                                    }
                                }
                            }
                        }
                    }
                });
                </text>
            }

            // 2. Structure Chart (Cơ cấu chi phí)
            @if (ViewBag.TotalCost != null && ViewBag.TotalCost > 0)
            {
                <text>
                const structCtx = document.getElementById('structureChart').getContext('2d');
                new Chart(structCtx, {
                    type: 'doughnut',
                    data: {
                        labels: ['Lương', 'OT', 'Phụ cấp', 'Thưởng'],
                        datasets: [{
                            data: [
                                @ViewBag.TotalPerformanceSalary, 
                                @ViewBag.TotalOT, 
                                @ViewBag.TotalAllowance, 
                                @ViewBag.TotalBonus
                            ],
                            backgroundColor: [
                                '#198754', // Success (Lương)
                                '#ffc107', // Warning (OT)
                                '#0dcaf0', // Info (Phụ cấp)
                                '#dc3545'  // Danger (Thưởng)
                            ],
                            borderWidth: 2,
                            hoverOffset: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '65%',
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: {
                                    padding: 20,
                                    usePointStyle: true,
                                    boxWidth: 8
                                }
                            },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        let val = context.raw;
                                        let total = context.chart._metasets[context.datasetIndex].total;
                                        let percentage = Math.round((val / total) * 100) + '%';
                                        return context.label + ': ' + currencyFormat.format(val) + ' (' + percentage + ')';
                                    }
                                }
                            }
                        }
                    }
                });
                </text>
            }
        });
    </script>
}
