@model giao_dien_demo.Models.LateReportViewModel

@{
    ViewData["Title"] = "Báo cáo đi muộn";
    
    var trendLabels = Html.Raw(Json.Serialize(Model?.DailyTrend.Select(d => d.DateLabel)));
    var trendData = Html.Raw(Json.Serialize(Model?.DailyTrend.Select(d => d.LateOccurrences)));

    var deptLabels = Html.Raw(Json.Serialize(Model?.DepartmentRates.Select(d => d.DepartmentName)));
    var deptData = Html.Raw(Json.Serialize(Model?.DepartmentRates.Select(d => d.LateRate)));
}

<div class="hrms-page-header">
    <div class="hrms-page-header-left">
        <h1 class="hrms-page-title">
            <span class="hrms-page-icon text-danger"><i class="fa-solid fa-person-running"></i></span>
            Báo cáo đi muộn
        </h1>
        <p class="text-muted mb-0" style="font-size: 14px; margin-top: 4px;">Tổng hợp tình hình đi muộn của nhân viên theo tháng và bộ lọc.</p>
</div>
    <div class="hrms-page-header-actions">
        <a href="@Url.Action("ExportExcel", "LeaderAttendance", new { month = Model?.CurrentMonth, department = Model?.SelectedDepartment })" class="hrms-btn hrms-btn-secondary">
            <i class="fa-solid fa-file-excel text-success"></i> Xuất Excel
        </a>
    </div>
</div>

<!-- KÍCH BẢN BỘ LỌC -->
<div class="hrms-filter-section mb-4">
    <form method="get" action="@Url.Action("LateReport", "LeaderAttendance")" class="row g-3 align-items-end">
        <div class="col-md-2">
            <label class="form-label">Tháng</label>
            <input type="text" name="month" class="form-control" value="@Model?.CurrentMonth" placeholder="MM/yyyy" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Phòng ban</label>
            <select name="department" class="form-select">
                <option value="">Tất cả phòng ban</option>
                @if(Model?.Departments != null)
                {
                    foreach (var d in Model.Departments)
                    {
                        if(d == Model.SelectedDepartment)
                        {
                            <option value="@d" selected>@d</option>
                        }
                        else
                        {
                            <option value="@d">@d</option>
                        }
                    }
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Nhân viên</label>
            <input type="text" name="searchEmployee" class="form-control" value="@Model?.SearchEmployee" placeholder="Tên hoặc mã NV..." />
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button type="submit" class="hrms-btn hrms-btn-primary">
                <i class="fa-solid fa-filter"></i> Lọc dữ liệu
            </button>
            <a href="@Url.Action("LateReport", "LeaderAttendance")" class="hrms-btn hrms-btn-secondary">
                <i class="fa-solid fa-rotate-right"></i> Đặt lại
            </a>
        </div>
    </form>
</div>

<!-- KÍCH BẢN 4 KPI CARDS -->
<div class="hrms-kpi-grid hrms-kpi-grid-4 mb-4">
    <div class="hrms-kpi-card kpi-red">
        <div class="hrms-kpi-top">
            <div class="hrms-kpi-icon"><i class="fa-solid fa-circle-exclamation"></i></div>
            <div class="hrms-kpi-value">@(Model?.TotalLateOccurrences ?? 0)</div>
        </div>
        <div class="hrms-kpi-body mt-2">
            <div class="hrms-kpi-label">Tổng lượt đi muộn</div>
        </div>
    </div>

    <div class="hrms-kpi-card kpi-orange">
        <div class="hrms-kpi-top">
            <div class="hrms-kpi-icon"><i class="fa-solid fa-stopwatch"></i></div>
            <div class="hrms-kpi-value">@(Model?.TotalLateMinutes ?? 0)</div>
        </div>
        <div class="hrms-kpi-body mt-2">
            <div class="hrms-kpi-label">Tổng phút đi muộn</div>
        </div>
    </div>

    <div class="hrms-kpi-card kpi-blue">
        <div class="hrms-kpi-top">
            <div class="hrms-kpi-icon"><i class="fa-solid fa-users"></i></div>
            <div class="hrms-kpi-value">@(Model?.TotalEmployeesWithLate ?? 0)</div>
        </div>
        <div class="hrms-kpi-body mt-2">
            <div class="hrms-kpi-label">Số nhân viên vi phạm</div>
        </div>
    </div>

    <div class="hrms-kpi-card kpi-purple">
        <div class="hrms-kpi-top">
            <div class="hrms-kpi-icon"><i class="fa-solid fa-building"></i></div>
            <div class="hrms-kpi-value" style="font-size: 20px; line-height: 36px;">@(Model?.HighestRateDepartment ?? "—")</div>
        </div>
        <div class="hrms-kpi-body mt-2">
            <div class="hrms-kpi-label">Phòng tỷ lệ cao nhất</div>
        </div>
    </div>
</div>

<!-- CHARTS -->
<div class="row mb-4">
    <div class="col-md-6">
        <div class="hrms-card h-100">
            <div class="hrms-card-header">
                <h3 class="hrms-card-title">Xu hướng đi muộn theo ngày (lượt)</h3>
            </div>
            <div class="hrms-card-body">
                @if(Model != null && Model.TotalLateOccurrences > 0)
                {
                    <canvas id="chartTrend" height="250"></canvas>
                }
                else
                {
                    <div class="hrms-empty-state">
                        <div class="empty-icon"><i class="fa-solid fa-chart-line text-muted"></i></div>
                        <div class="empty-title">Chưa có dữ liệu biểu đồ.</div>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="hrms-card h-100">
            <div class="hrms-card-header">
                <h3 class="hrms-card-title">Tỷ lệ đi muộn theo phòng ban (%)</h3>
            </div>
            <div class="hrms-card-body">
                @if(Model != null && Model.DepartmentRates.Any(d => d.LateRate > 0))
                {
                    <canvas id="chartDept" height="250"></canvas>
                }
                else
                {
                    <div class="hrms-empty-state">
                        <div class="empty-icon"><i class="fa-solid fa-chart-bar text-muted"></i></div>
                        <div class="empty-title">Chưa có dữ liệu biểu đồ.</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- KÍCH BẢN EMPLOYEE LATE REPORT TABLE -->
<div class="hrms-card mb-4">
    <div class="hrms-card-header">
        <h3 class="hrms-card-title">Danh sách nhân viên đi muộn</h3>
    </div>
    <div class="hrms-card-body p-0">
        @if(Model?.EmployeeSummaries != null && Model.EmployeeSummaries.Any())
        {
            <div class="table-responsive">
                <table class="hrms-table">
                    <thead>
                        <tr>
                            <th>Nhân viên</th>
                            <th>Phòng ban</th>
                            <th class="text-center">Số lần</th>
                            <th class="text-center">Tổng phút</th>
                            <th class="text-center">Trung bình (phút/lần)</th>
                            <th class="text-center">Lần gần nhất</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach(var emp in Model.EmployeeSummaries)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold">@emp.EmployeeName</div>
                                    <div class="text-muted small">@emp.EmployeeCode</div>
                                </td>
                                <td>@emp.DepartmentName</td>
                                <td class="text-center fw-bold text-danger">@emp.LateCount</td>
                                <td class="text-center text-warning fw-bold">@emp.TotalLateMinutes</td>
                                <td class="text-center">@emp.AverageLateMinutes</td>
                                <td class="text-center">@(emp.LatestLateDate?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-outline-primary hrms-btn-icon" title="Xem chi tiết" onclick="openLateDetailDrawer(@emp.EmployeeId, '@emp.EmployeeName', '@emp.EmployeeCode', '@emp.DepartmentName', @emp.LateCount, @emp.TotalLateMinutes, @emp.AverageLateMinutes)">
                                        <i class="fa-solid fa-eye"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="hrms-empty-state p-5">
                <div class="empty-icon"><i class="fa-regular fa-folder-open"></i></div>
                <div class="empty-title">Chưa có dữ liệu phù hợp với bộ lọc.</div>
                <div class="empty-desc">Không tìm thấy nhân viên nào đi muộn trong khoảng thời gian này.</div>
            </div>
        }
    </div>
</div>

<!-- LATE DETAIL DRAWER (OFFCANVAS) -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="lateDetailDrawer" aria-labelledby="lateDetailDrawerLabel" style="width: 500px;">
    <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title" id="lateDetailDrawerLabel">Chi tiết đi muộn</h5>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body p-0">
        <!-- HEADER INFO -->
        <div class="p-3 bg-light border-bottom">
            <div class="d-flex align-items-center mb-2">
                <div class="me-3">
                    <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; font-size: 20px;">
                        <i class="fa-solid fa-user"></i>
                    </div>
                </div>
                <div>
                    <h5 class="mb-0 fw-bold" id="drawerEmpName">--</h5>
                    <div class="text-muted small"><span id="drawerEmpCode">--</span> | <span id="drawerEmpDept">--</span></div>
                </div>
            </div>
            <div class="row text-center mt-3 g-2">
                <div class="col-4">
                    <div class="border rounded p-2 bg-white">
                        <div class="small text-muted">Số lần</div>
                        <div class="fw-bold text-danger" id="drawerLateCount">0</div>
                    </div>
                </div>
                <div class="col-4">
                    <div class="border rounded p-2 bg-white">
                        <div class="small text-muted">Tổng phút</div>
                        <div class="fw-bold text-warning" id="drawerTotalMins">0</div>
                    </div>
                </div>
                <div class="col-4">
                    <div class="border rounded p-2 bg-white">
                        <div class="small text-muted">TB (phút/lần)</div>
                        <div class="fw-bold text-primary" id="drawerAvgMins">0</div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- CONTENT -->
        <div class="p-3">
            <h6 class="mb-3 fw-bold">Danh sách ngày đi muộn (Tháng @Model?.CurrentMonth)</h6>
            
            <div id="drawerLoading" class="text-center py-4 d-none">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <div class="mt-2 text-muted">Đang tải dữ liệu...</div>
            </div>
            
            <div id="drawerError" class="text-center py-4 d-none">
                <i class="fa-solid fa-triangle-exclamation text-danger mb-2" style="font-size: 24px;"></i>
                <div class="text-danger fw-bold">Không thể tải chi tiết đi muộn.</div>
                <button class="btn btn-sm btn-outline-secondary mt-2" onclick="retryLoadDetail()">Thử lại</button>
            </div>
            
            <div id="drawerEmpty" class="text-center py-4 d-none">
                <div class="text-muted">Không có ngày đi muộn trong tháng này.</div>
            </div>
            
            <div id="drawerList" class="d-none">
                <!-- List items will be injected here via JS -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // CHARTS SETUP
        document.addEventListener("DOMContentLoaded", function() {
            var trendLabels = @trendLabels;
            var trendData = @trendData;
            var deptLabels = @deptLabels;
            var deptData = @deptData;
            
            if (document.getElementById('chartTrend') && trendLabels && trendData) {
                new Chart(document.getElementById('chartTrend'), {
                    type: 'line',
                    data: {
                        labels: trendLabels,
                        datasets: [{
                            label: 'Lượt đi muộn',
                            data: trendData,
                            borderColor: '#ef4444',
                            backgroundColor: 'rgba(239, 68, 68, 0.1)',
                            tension: 0.3,
                            fill: true
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: { y: { beginAtZero: true, suggestedMax: 5, ticks: { stepSize: 1 } } }
                    }
                });
            }

            if (document.getElementById('chartDept') && deptLabels && deptData) {
                new Chart(document.getElementById('chartDept'), {
                    type: 'bar',
                    data: {
                        labels: deptLabels,
                        datasets: [{
                            label: 'Tỷ lệ đi muộn (%)',
                            data: deptData,
                            backgroundColor: '#8b5cf6',
                            borderRadius: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: { y: { beginAtZero: true, max: 100 } }
                    }
                });
            }
        });

        // LATE DETAIL DRAWER LOGIC
        var currentEmployeeId = 0;
        var currentMonth = '@Model?.CurrentMonth';

        function openLateDetailDrawer(empId, empName, empCode, deptName, lateCount, totalMins, avgMins) {
            currentEmployeeId = empId;
            
            // Populate Header Info
            document.getElementById('drawerEmpName').innerText = empName;
            document.getElementById('drawerEmpCode').innerText = empCode;
            document.getElementById('drawerEmpDept').innerText = deptName;
            document.getElementById('drawerLateCount').innerText = lateCount;
            document.getElementById('drawerTotalMins').innerText = totalMins;
            document.getElementById('drawerAvgMins').innerText = avgMins;

            // Reset States
            showDrawerState('loading');
            
            // Open Drawer
            var bsOffcanvas = new bootstrap.Offcanvas(document.getElementById('lateDetailDrawer'));
            bsOffcanvas.show();

            // Fetch Data
            fetchLateDetails();
        }

        function fetchLateDetails() {
            showDrawerState('loading');
            
            fetch('@Url.Action("GetLateDetails", "LeaderAttendance")?employeeId=' + currentEmployeeId + '&month=' + encodeURIComponent(currentMonth))
                .then(response => {
                    if(!response.ok) throw new Error('API Error');
                    return response.json();
                })
                .then(data => {
                    if(data && data.length > 0) {
                        renderDetailList(data);
                        showDrawerState('list');
                    } else {
                        showDrawerState('empty');
                    }
                })
                .catch(error => {
                    console.error('Error fetching details:', error);
                    showDrawerState('error');
                });
        }

        function retryLoadDetail() {
            fetchLateDetails();
        }

        function showDrawerState(state) {
            document.getElementById('drawerLoading').classList.add('d-none');
            document.getElementById('drawerError').classList.add('d-none');
            document.getElementById('drawerEmpty').classList.add('d-none');
            document.getElementById('drawerList').classList.add('d-none');
            
            if(state === 'loading') document.getElementById('drawerLoading').classList.remove('d-none');
            if(state === 'error') document.getElementById('drawerError').classList.remove('d-none');
            if(state === 'empty') document.getElementById('drawerEmpty').classList.remove('d-none');
            if(state === 'list') document.getElementById('drawerList').classList.remove('d-none');
        }

        function renderDetailList(data) {
            var html = '';
            data.forEach(function(item) {
                // Parse date
                var dateObj = new Date(item.date);
                var dateStr = String(dateObj.getDate()).padStart(2, '0') + '/' + String(dateObj.getMonth() + 1).padStart(2, '0') + '/' + dateObj.getFullYear();
                
                var actualCheckIn = item.actualCheckIn ? new Date(item.actualCheckIn).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) : '--:--';
                var scheduledStart = item.scheduledStart ? item.scheduledStart.substring(0, 5) : '08:00'; // Defaulting format

                var badgeHtml = item.isAdjusted ? '<span class="badge bg-success-subtle text-success border border-success-subtle ms-2" style="font-size: 10px;">Đã điều chỉnh</span>' : '';
                var noteHtml = item.statusNote ? '<div class="text-muted small mt-1"><i class="fa-solid fa-note-sticky me-1"></i>' + item.statusNote + '</div>' : '';

                html += `
                <div class="card mb-2 shadow-sm border-0">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div class="fw-bold"><i class="fa-regular fa-calendar me-2"></i>${dateStr} ${badgeHtml}</div>
                            <div class="badge bg-danger-subtle text-danger rounded-pill px-2 py-1">Trễ ${item.lateMinutes} phút</div>
                        </div>
                        <div class="d-flex justify-content-between text-muted small">
                            <div><i class="fa-solid fa-clock me-1"></i>Giờ vào ca: ${scheduledStart}</div>
                            <div class="fw-bold text-dark"><i class="fa-solid fa-person-walking-arrow-right me-1"></i>Thực tế: ${actualCheckIn}</div>
                        </div>
                        ${noteHtml}
                    </div>
                </div>
                `;
            });
            document.getElementById('drawerList').innerHTML = html;
        }
    </script>
}
