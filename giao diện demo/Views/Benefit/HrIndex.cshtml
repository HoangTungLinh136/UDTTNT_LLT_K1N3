@{ ViewData["Title"] = "Phúc lợi"; }
<style>.hrms-status-badge{display:inline-flex;align-items:center;padding:3px 10px;border-radius:999px;font-size:12px;font-weight:600}.status-approved{background:#ecfdf5;color:#047857}.status-pending{background:#fffbeb;color:#92400e}.status-rejected{background:#fef2f2;color:#b91c1c}.status-cancelled{background:#f1f5f9;color:#475569}</style>
<div class="hrms-page-header"><div class="hrms-page-header-main"><h1 class="hrms-page-title"><span class="hrms-page-icon green"><i class="fa-solid fa-hand-holding-heart"></i></span>Phúc lợi</h1><p class="hrms-page-subtitle">Quản lý đăng ký và quyền lợi phúc lợi của nhân viên.</p></div></div>
<div class="hrms-kpi-grid hrms-kpi-grid-4"><div class="hrms-kpi-card kpi-blue"><div class="hrms-kpi-top"><div class="hrms-kpi-icon"><i class="fa-solid fa-list-check"></i></div></div><div class="hrms-kpi-body"><div class="hrms-kpi-label">Tổng đăng ký</div><div class="hrms-kpi-value kpi-blue" id="total">0</div></div></div><div class="hrms-kpi-card kpi-yellow"><div class="hrms-kpi-top"><div class="hrms-kpi-icon"><i class="fa-solid fa-clock"></i></div></div><div class="hrms-kpi-body"><div class="hrms-kpi-label">Chờ xử lý</div><div class="hrms-kpi-value kpi-yellow" id="pending">0</div></div></div><div class="hrms-kpi-card kpi-green"><div class="hrms-kpi-top"><div class="hrms-kpi-icon"><i class="fa-solid fa-circle-check"></i></div></div><div class="hrms-kpi-body"><div class="hrms-kpi-label">Đã duyệt</div><div class="hrms-kpi-value kpi-green" id="approved">0</div></div></div><div class="hrms-kpi-card kpi-purple"><div class="hrms-kpi-top"><div class="hrms-kpi-icon"><i class="fa-solid fa-gift"></i></div></div><div class="hrms-kpi-body"><div class="hrms-kpi-label">Quyền lợi hiệu lực</div><div class="hrms-kpi-value kpi-purple" id="active">0</div></div></div></div>
<form id="benefit-filter" class="hrms-filter-bar" onsubmit="loadBenefits(event)"><div class="hrms-search-wrap"><i class="fa-solid fa-search search-icon"></i><input id="benefit-search" name="search" class="hrms-search-input" placeholder="Tìm mã/tên nhân viên hoặc chương trình" /></div><select id="benefit-status" name="status" class="hrms-filter-select"><option value="">Tất cả trạng thái</option><option value="PENDING_APPROVAL">Chờ xử lý</option><option value="APPROVED">Đã duyệt</option><option value="REJECTED">Từ chối</option><option value="CANCELLED">Đã hủy</option></select><button type="submit" class="hrms-btn hrms-btn-primary"><i class="fa-solid fa-filter"></i> Lọc</button><button type="button" class="hrms-btn hrms-btn-secondary" onclick="resetBenefits()"><i class="fa-solid fa-rotate-left"></i> Đặt lại</button></form>
<section class="hrms-card"><div class="hrms-card-header"><h2 class="hrms-card-title"><i class="fa-solid fa-table-list card-title-icon"></i>Danh sách đăng ký <span class="notification-badge" id="record-count">0</span></h2></div><div class="hrms-card-body p-0"><div class="hrms-table-wrap"><table class="hrms-table"><thead><tr><th>Nhân viên</th><th>Chương trình</th><th>Ngày đăng ký</th><th>Trạng thái</th><th>Quyền lợi</th><th>Thao tác</th></tr></thead><tbody id="benefit-rows"></tbody></table></div></div></section>
<form id="benefit-csrf">@Html.AntiForgeryToken()</form>
<script>
const total=document.getElementById('total'),pending=document.getElementById('pending'),approved=document.getElementById('approved'),active=document.getElementById('active');const benefitToken=()=>document.querySelector('#benefit-csrf input[name="__RequestVerificationToken"]').value;const escBenefit=value=>String(value??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
function loadBenefits(event){if(event)event.preventDefault();const q=new URLSearchParams({search:document.getElementById('benefit-search').value,status:document.getElementById('benefit-status').value});fetch('/Benefit/GetHrEnrollments?'+q).then(r=>r.ok?r.json():[]).then(items=>{total.textContent=items.length;pending.textContent=items.filter(x=>x.status==='PENDING_APPROVAL').length;approved.textContent=items.filter(x=>x.status==='APPROVED').length;active.textContent=items.filter(x=>x.entitlement).length;document.getElementById('record-count').textContent=items.length;document.getElementById('benefit-rows').innerHTML=items.length?items.map(x=>`<tr><td>${escBenefit(x.employee)}</td><td>${escBenefit(x.program)}</td><td>${new Date(x.registrationDate).toLocaleDateString('vi-VN')}</td><td><span class="hrms-status-badge ${x.status==='APPROVED'?'status-approved':x.status==='REJECTED'?'status-rejected':x.status==='CANCELLED'?'status-cancelled':'status-pending'}">${escBenefit(x.status)}</span></td><td>${x.entitlement?'<span class="text-success">Đang hiệu lực</span>':'—'}</td><td>${x.status==='PENDING_APPROVAL'?`<button type="button" class="hrms-btn hrms-btn-sm hrms-btn-success" onclick="decideBenefit('/Benefit/ApproveEnrollment',${x.id})">Duyệt</button> <button type="button" class="hrms-btn hrms-btn-sm hrms-btn-danger" onclick="decideBenefit('/Benefit/RejectEnrollment',${x.id})">Từ chối</button>`:'—'}</td></tr>`).join(''):'<tr><td colspan="6"><div class="hrms-empty-state"><div class="hrms-empty-icon"><i class="fa-solid fa-hand-holding-heart"></i></div><h3 class="hrms-empty-title">Không có đăng ký phúc lợi</h3><p class="hrms-empty-desc">Không có hồ sơ phù hợp với bộ lọc hiện tại.</p></div></td></tr>';});}
function resetBenefits(){document.getElementById('benefit-filter').reset();loadBenefits();}function decideBenefit(url,id){fetch(url,{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded','RequestVerificationToken':benefitToken()},body:new URLSearchParams({id})}).then(()=>loadBenefits());}loadBenefits();
</script>
