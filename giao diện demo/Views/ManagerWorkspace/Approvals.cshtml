@model giao_dien_demo.Models.ManagerListViewModel<giao_dien_demo.Models.ManagerApprovalRow>
@{ var type = (string)(ViewBag.ApprovalType ?? "LEAVE"); var isLeave = type == "LEAVE"; ViewData["Title"] = isLeave ? "Assigned Leave Approvals" : "Assigned Attendance Adjustments"; }
<div class="hrms-page-header"><div class="hrms-page-header-main"><h1 class="hrms-page-title"><span class="hrms-page-icon blue"><i class="fa-solid @(isLeave ? "fa-umbrella-beach" : "fa-clock-rotate-left")"></i></span>@(isLeave ? "Duyệt nghỉ phép" : "Duyệt giải trình công")</h1><p class="hrms-page-subtitle">Các yêu cầu đang chờ bạn xử lý trong phạm vi quản lý.</p></div></div>
<div class="hrms-card"><div class="hrms-card-header"><form method="get" class="manager-filter"><input class="form-control" name="search" value="@Model.Search" placeholder="Mã đơn, tên hoặc mã nhân viên"/><button class="hrms-btn hrms-btn-primary">Tìm kiếm</button></form><span class="text-muted">@Model.TotalItems yêu cầu được giao</span></div><div class="hrms-card-body p-0"><div class="hrms-table-wrap"><table class="hrms-table"><thead><tr><th>Mã</th><th>Nhân viên</th><th>Đơn vị</th><th>Nội dung</th><th>Gửi lúc</th><th>Thao tác</th></tr></thead><tbody>@foreach(var x in Model.Items){<tr><td><b>@x.Code</b></td><td>@x.EmployeeName<br/><span class="text-muted">@x.EmployeeCode</span></td><td>@x.Department</td><td class="manager-detail">@x.Summary</td><td>@x.SubmittedAt.ToString("dd/MM/yyyy HH:mm")</td><td><button class="hrms-btn hrms-btn-sm hrms-btn-info" onclick="showDetail('@x.Type',@x.Id)">Chi tiết</button> <button class="hrms-btn hrms-btn-sm hrms-btn-primary" onclick="decide('@x.Type',@x.Id,'APPROVE')">Duyệt</button> <button class="hrms-btn hrms-btn-sm hrms-btn-danger" onclick="reject('@x.Type',@x.Id)">Từ chối</button>@if(!isLeave){ <button class="hrms-btn hrms-btn-sm hrms-btn-secondary" onclick="requestRevision('@x.Type',@x.Id)">Yêu cầu bổ sung</button> }</td></tr>}</tbody></table></div>@if(!Model.Items.Any()){<div class="hrms-empty-state manager-empty"><div class="hrms-empty-icon"><i class="fa-solid fa-inbox"></i></div><div class="hrms-empty-state-title">@(Model.HasManagerScope ? (string.IsNullOrWhiteSpace(Model.Search) ? "Không có yêu cầu được giao đang chờ xử lý" : "Không tìm thấy yêu cầu phù hợp với bộ lọc") : "Bạn chưa được phân công phạm vi quản lý")</div><div class="hrms-empty-state-desc">@(Model.HasManagerScope ? (string.IsNullOrWhiteSpace(Model.Search) ? "Các yêu cầu mới sẽ xuất hiện tại đây khi được giao cho bạn." : "Thử điều chỉnh từ khóa tìm kiếm.") : "Liên hệ HR để được thiết lập đơn vị phụ trách.")</div></div>}<partial name="_Pagination" model="Model" /></div></div>
<form id="approvalToken">@Html.AntiForgeryToken()</form>
@section Scripts{<script>
const token=()=>document.querySelector('#approvalToken input').value;
const escapeHtml=value=>String(value??'').replace(/[&<>"']/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));
async function showDetail(type,id){const r=await fetch(`/ManagerWorkspace/ApprovalDetail?type=${encodeURIComponent(type)}&id=${encodeURIComponent(id)}`);if(!r.ok){Swal.fire('Không thể mở','Yêu cầu không còn thuộc phạm vi xử lý của bạn.','error');return;}const x=await r.json();Swal.fire({title:escapeHtml(x.code),html:`<div style="text-align:left"><b>${escapeHtml(x.employeeName)}</b> (${escapeHtml(x.employeeCode)})<br>${escapeHtml(x.department)}<hr>${escapeHtml(x.summary)}<br><small>Gửi lúc ${escapeHtml(new Date(x.submittedAt).toLocaleString('vi-VN'))}</small></div>`});}
async function sendDecision(type,id,decision,reason=''){const body=new URLSearchParams({type,id,decision,reason});const r=await fetch('/ManagerWorkspace/Decide',{method:'POST',headers:{'RequestVerificationToken':token(),'Content-Type':'application/x-www-form-urlencoded'},body});if(r.ok)location.reload();else{let m='Không thể xử lý yêu cầu.';try{m=(await r.json()).message||m}catch{}Swal.fire('Bị từ chối',m,'error');}}
function decide(type,id,decision){Swal.fire({title:'Xác nhận phê duyệt?',icon:'question',showCancelButton:true,confirmButtonText:'Duyệt',cancelButtonText:'Hủy'}).then(x=>{if(x.isConfirmed)sendDecision(type,id,decision)});}
function reject(type,id){Swal.fire({title:'Lý do từ chối',input:'textarea',showCancelButton:true,confirmButtonText:'Từ chối',preConfirm:v=>{if(!v)Swal.showValidationMessage('Vui lòng nhập lý do');return v}}).then(x=>{if(x.isConfirmed)sendDecision(type,id,'REJECT',x.value)});}
function requestRevision(type,id){Swal.fire({title:'Nội dung yêu cầu bổ sung',input:'textarea',showCancelButton:true,confirmButtonText:'Gửi yêu cầu',cancelButtonText:'Hủy',preConfirm:v=>{if(!v)Swal.showValidationMessage('Vui lòng nhập nội dung yêu cầu');return v}}).then(x=>{if(x.isConfirmed)sendDecision(type,id,'REQUEST_REVISION',x.value)});}
</script>}
