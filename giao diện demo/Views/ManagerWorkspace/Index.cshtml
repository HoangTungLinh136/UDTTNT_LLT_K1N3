@model giao_dien_demo.Models.ManagerWorkspaceViewModel
@{ ViewData["Title"] = "Tổng quan quản lý"; }
<div class="hrms-page-header"><div class="hrms-page-header-left"><h1 class="hrms-page-title"><span class="hrms-page-icon blue"><i class="fa-solid fa-gauge-high"></i></span>Tổng quan quản lý</h1><div class="hrms-breadcrumb manager-scope-note"><i class="fa-solid fa-shield-halved"></i><span>Phạm vi quản lý:</span><strong>@(Model.OrganizationalUnits.Any() ? string.Join(", ", Model.OrganizationalUnits) : "Chưa được phân công đơn vị")</strong></div></div></div>
<div class="hrms-kpi-grid hrms-kpi-grid-4 mb-4">
    <div class="hrms-kpi-card hrms-kpi-horizontal kpi-blue"><div class="hrms-kpi-top"><div class="hrms-kpi-icon"><i class="fa-solid fa-users"></i></div></div><div class="hrms-kpi-body"><div class="hrms-kpi-label">Nhân viên trong phạm vi</div><div class="hrms-kpi-value kpi-blue">@Model.ManagedEmployeeCount</div></div></div>
    <div class="hrms-kpi-card hrms-kpi-horizontal kpi-green"><div class="hrms-kpi-top"><div class="hrms-kpi-icon"><i class="fa-solid fa-user-check"></i></div></div><div class="hrms-kpi-body"><div class="hrms-kpi-label">Có mặt hôm nay</div><div class="hrms-kpi-value kpi-green">@Model.PresentTodayCount</div></div></div>
    <div class="hrms-kpi-card hrms-kpi-horizontal kpi-purple"><div class="hrms-kpi-top"><div class="hrms-kpi-icon"><i class="fa-solid fa-umbrella-beach"></i></div></div><div class="hrms-kpi-body"><div class="hrms-kpi-label">Nghỉ phép được giao</div><div class="hrms-kpi-value kpi-purple">@Model.AssignedLeavePendingCount</div></div></div>
    <div class="hrms-kpi-card hrms-kpi-horizontal kpi-red"><div class="hrms-kpi-top"><div class="hrms-kpi-icon"><i class="fa-solid fa-clock-rotate-left"></i></div></div><div class="hrms-kpi-body"><div class="hrms-kpi-label">Điều chỉnh công được giao</div><div class="hrms-kpi-value kpi-red">@Model.AssignedAdjustmentPendingCount</div></div></div>
</div>
<div class="hrms-card mb-4">
    <div class="hrms-card-header"><h3 class="hrms-card-title"><i class="fa-solid fa-chart-simple card-title-icon"></i>Tình trạng đội nhóm</h3></div>
    <div class="hrms-card-body"><div class="row g-3">
        <div class="col-md-6"><div class="d-flex align-items-center gap-3"><span class="hrms-kpi-icon green"><i class="fa-solid fa-person-walking-luggage"></i></span><div><div class="text-muted small">Đang nghỉ hôm nay</div><div class="fs-4 fw-bold">@Model.OnLeaveTodayCount</div></div></div></div>
        <div class="col-md-6"><div class="d-flex align-items-center gap-3"><span class="hrms-kpi-icon purple"><i class="fa-solid fa-chart-line"></i></span><div><div class="text-muted small">KPI đã hoàn tất</div><div class="fs-4 fw-bold">@Model.CompletedKpiCount</div></div></div></div>
    </div></div>
</div>
<div class="hrms-card"><div class="hrms-card-header"><h3 class="hrms-card-title">Việc cần xử lý</h3><div><a asp-action="LeaveApprovals" class="hrms-btn hrms-btn-primary">Xử lý nghỉ phép</a> <a asp-action="AttendanceAdjustments" class="hrms-btn hrms-btn-secondary">Xử lý chấm công</a></div></div><div class="hrms-card-body p-0">
@if(Model.RecentApprovals.Any()){<div class="hrms-table-wrap"><table class="hrms-table"><thead><tr><th>Mã</th><th>Nhân viên</th><th>Đơn vị</th><th>Nội dung</th><th>Gửi lúc</th><th></th></tr></thead><tbody>@foreach(var x in Model.RecentApprovals){<tr><td><b>@x.Code</b></td><td>@x.EmployeeName</td><td>@x.Department</td><td class="manager-detail">@x.Summary</td><td>@x.SubmittedAt.ToString("dd/MM/yyyy HH:mm")</td><td><a class="hrms-btn hrms-btn-sm hrms-btn-primary" href="@(x.Type == "LEAVE" ? Url.Action("LeaveApprovals") : Url.Action("AttendanceAdjustments"))">Xem</a></td></tr>}</tbody></table></div>}else{<div class="hrms-empty-state manager-empty"><div class="hrms-empty-icon"><i class="fa-regular fa-circle-check"></i></div><div class="hrms-empty-state-title">Không có yêu cầu được giao đang chờ xử lý</div><div class="hrms-empty-state-desc">Các yêu cầu mới sẽ xuất hiện tại đây khi được giao cho bạn.</div></div>}
</div></div>
