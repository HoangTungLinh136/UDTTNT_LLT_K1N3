@model giao_dien_demo.Models.ManagerListViewModel<giao_dien_demo.Models.ManagerAttendanceRow>
@{ ViewData["Title"] = "Attendance"; }
<div class="hrms-page-header"><div class="hrms-page-header-main"><h1 class="hrms-page-title"><span class="hrms-page-icon green"><i class="fa-solid fa-calendar-check"></i></span>Chấm công đội nhóm</h1><p class="hrms-page-subtitle">Theo dõi dữ liệu chấm công trong phạm vi quản lý.</p></div></div>
<div class="hrms-card"><div class="hrms-card-header"><form method="get" class="manager-filter"><input class="form-control" name="search" value="@Model.Search" placeholder="Tên hoặc mã nhân viên"/><select class="form-control" name="department" aria-label="Đơn vị" onchange="this.form.submit()"><option value="">Tất cả đơn vị trong phạm vi</option>@foreach (var unit in Model.OrganizationalUnits){if (string.Equals(Model.Filter, unit, StringComparison.Ordinal)){<option value="@unit" selected>@unit</option>}else{<option value="@unit">@unit</option>}}</select><button class="hrms-btn hrms-btn-primary">Lọc</button></form><span class="text-muted">@Model.TotalItems bản ghi</span></div><div class="hrms-card-body p-0"><div class="hrms-table-wrap"><table class="hrms-table"><thead><tr><th>Nhân viên</th><th>Đơn vị</th><th>Ngày</th><th>Vào</th><th>Ra</th><th>Trạng thái</th></tr></thead><tbody>@foreach(var x in Model.Items){<tr><td><b>@x.EmployeeName</b><br/><span class="text-muted">@x.EmployeeCode</span></td><td>@x.Department</td><td>@x.CheckIn.ToString("dd/MM/yyyy")</td><td>@x.CheckIn.ToString("HH:mm")</td><td>@(x.CheckOut?.ToString("HH:mm") ?? "—")</td><td><span class="hrms-badge @(x.Status == "OnTime" || x.Status == "Đúng giờ" ? "hrms-badge-success" : (x.Status == "Late" || x.Status == "Đi muộn" ? "hrms-badge-warning" : "hrms-badge-neutral"))">@x.Status</span></td></tr>}</tbody></table></div>@if(!Model.Items.Any()){<div class="hrms-empty-state manager-empty"><div class="hrms-empty-icon"><i class="fa-solid fa-calendar-xmark"></i></div><div class="hrms-empty-state-title">@(Model.HasManagerScope ? (string.IsNullOrWhiteSpace(Model.Search) && string.IsNullOrWhiteSpace(Model.Filter) ? "Chưa có dữ liệu chấm công" : "Không có dữ liệu phù hợp với bộ lọc") : "Bạn chưa được phân công phạm vi quản lý")</div><div class="hrms-empty-state-desc">@(Model.HasManagerScope ? "Dữ liệu chấm công sẽ hiển thị khi có lượt ghi nhận." : "Liên hệ HR để được thiết lập đơn vị phụ trách.")</div></div>}<partial name="_Pagination" model="Model" /></div></div>
