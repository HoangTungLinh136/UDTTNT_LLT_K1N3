@model giao_dien_demo.Models.ManagerListViewModel<giao_dien_demo.Models.Employee>
@{ ViewData["Title"] = "Managed Employees"; }
<div class="hrms-page-header"><div class="hrms-page-header-main"><h1 class="hrms-page-title"><span class="hrms-page-icon blue"><i class="fa-solid fa-users"></i></span>Nhân viên trực thuộc</h1><p class="hrms-page-subtitle">Danh sách nhân viên trong các đơn vị đang được phân công quản lý.</p></div></div>
<div class="hrms-card"><div class="hrms-card-header"><form method="get" class="manager-filter"><input class="form-control" name="search" value="@Model.Search" placeholder="Tên hoặc mã nhân viên"/><input class="form-control" name="department" value="@Model.Filter" placeholder="Đơn vị"/><button class="hrms-btn hrms-btn-primary">Tìm kiếm</button></form><div class="d-flex align-items-center gap-2"><a href="@Url.Action("Hierarchy", "Employee")" class="hrms-btn hrms-btn-secondary btn-sm"><i class="fa-solid fa-diagram-project me-1"></i> Cây phân cấp nhóm</a><span class="text-muted">@Model.TotalItems kết quả</span></div></div><div class="hrms-card-body p-0"><div class="hrms-table-wrap"><table class="hrms-table"><thead><tr><th>Mã NV</th><th>Họ tên</th><th>Đơn vị</th><th>Chức danh</th><th>Quản lý trực tiếp</th><th>Trạng thái</th><th>Liên hệ</th></tr></thead><tbody>@foreach(var e in Model.Items){<tr><td><b>@(string.IsNullOrWhiteSpace(e.EmployeeCode) ? "Chưa được cấp mã" : e.EmployeeCode)</b></td><td>@e.Name</td><td>@e.Department</td><td>@e.JobTitle</td><td>@(e.Manager != null ? $"{e.Manager.Name}" : "---")</td><td><span class="hrms-badge @(e.Status == "Active" || e.Status == "Đang làm việc" ? "hrms-badge-success" : "hrms-badge-neutral")">@e.Status</span></td><td>@e.Email<br/><span class="text-muted">@e.PhoneNumber</span></td></tr>}</tbody></table></div>@if(!Model.Items.Any()){<div class="hrms-empty-state manager-empty"><div class="hrms-empty-icon"><i class="fa-solid fa-users-slash"></i></div><div class="hrms-empty-state-title">@(Model.HasManagerScope ? (string.IsNullOrWhiteSpace(Model.Search) && string.IsNullOrWhiteSpace(Model.Filter) ? "Chưa có nhân viên trong phạm vi" : "Không có nhân viên phù hợp với bộ lọc") : "Bạn chưa được phân công phạm vi quản lý")</div><div class="hrms-empty-state-desc">@(Model.HasManagerScope ? "Thử điều chỉnh từ khóa hoặc đơn vị để xem dữ liệu khác." : "Liên hệ HR để được thiết lập đơn vị phụ trách.")</div></div>}<partial name="_Pagination" model="Model" /></div></div>
