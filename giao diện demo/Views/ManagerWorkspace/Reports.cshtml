@model giao_dien_demo.Models.ManagerListViewModel<giao_dien_demo.Models.ManagerReportRow>
@{ ViewData["Title"] = "Team Reports"; }
<div class="hrms-page-header"><div class="hrms-page-header-main"><h1 class="hrms-page-title"><span class="hrms-page-icon purple"><i class="fa-solid fa-chart-column"></i></span>Báo cáo đội nhóm</h1><p class="hrms-page-subtitle">Tổng hợp theo phạm vi quản lý được cấp.</p></div></div>
<div class="hrms-card"><div class="hrms-card-header"><form method="get" class="manager-filter"><input class="form-control" name="search" value="@Model.Search" placeholder="Tìm đơn vị"/><button class="hrms-btn hrms-btn-primary">Lọc</button></form><span class="text-muted">Tổng hợp theo phạm vi quản lý</span></div><div class="hrms-card-body p-0"><div class="hrms-table-wrap"><table class="hrms-table"><thead><tr><th>Đơn vị</th><th>Nhân viên</th><th>Có mặt hôm nay</th><th>Đi muộn</th><th>Nghỉ phép chờ</th><th>Điều chỉnh chờ</th></tr></thead><tbody>@foreach(var x in Model.Items){<tr><td><b>@x.Department</b></td><td>@x.Employees</td><td>@x.PresentToday</td><td>@x.LateToday</td><td>@x.PendingLeaves</td><td>@x.PendingAdjustments</td></tr>}</tbody></table></div>@if(!Model.Items.Any()){<div class="hrms-empty-state manager-empty"><div class="hrms-empty-icon"><i class="fa-solid fa-chart-column"></i></div><div class="hrms-empty-state-title">@(Model.HasManagerScope ? (string.IsNullOrWhiteSpace(Model.Search) ? "Chưa có dữ liệu báo cáo" : "Không có dữ liệu phù hợp với bộ lọc") : "Bạn chưa được phân công phạm vi quản lý")</div><div class="hrms-empty-state-desc">@(Model.HasManagerScope ? "Báo cáo được tổng hợp từ dữ liệu trong phạm vi quản lý." : "Liên hệ HR để được thiết lập đơn vị phụ trách.")</div></div>}<partial name="_Pagination" model="Model" /></div></div>
