@model giao_dien_demo.Models.ManagerListViewModel<giao_dien_demo.Controllers.ThongBaoTam>
@{ ViewData["Title"] = "Thông báo"; }
<div class="hrms-page-header"><div class="hrms-page-header-main"><h1 class="hrms-page-title"><span class="hrms-page-icon blue"><i class="fa-solid fa-bell"></i></span>Thông báo</h1><p class="hrms-page-subtitle">Thông báo được gửi tới tài khoản quản lý của bạn.</p></div></div>
<div class="hrms-card"><div class="hrms-card-header"><form method="get" class="manager-filter"><input class="form-control" name="search" value="@Model.Search" placeholder="Tìm nội dung thông báo"/><button class="hrms-btn hrms-btn-primary">Tìm kiếm</button></form><span class="text-muted">@Model.TotalItems thông báo</span></div><div class="hrms-card-body p-0"><div class="hrms-table-wrap"><table class="hrms-table"><thead><tr><th>Thời gian</th><th>Nội dung</th><th>Người gửi</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(var x in Model.Items){<tr><td>@x.NgayTao.ToString("dd/MM/yyyy HH:mm")</td><td class="manager-detail">@x.NoiDung</td><td>@x.NguoiGui</td><td>@(x.IsRead ? "Đã đọc" : "Chưa đọc")</td><td>@if(!string.IsNullOrWhiteSpace(x.TargetUrl)){<a class="hrms-btn hrms-btn-sm hrms-btn-info" href="@x.TargetUrl">Mở</a>}</td></tr>}</tbody></table></div>@if(!Model.Items.Any()){<div class="hrms-empty-state manager-empty"><div class="hrms-empty-icon"><i class="fa-solid fa-bell-slash"></i></div><div class="hrms-empty-state-title">@(string.IsNullOrWhiteSpace(Model.Search) ? "Chưa có thông báo" : "Không có thông báo phù hợp")</div><div class="hrms-empty-state-desc">Thông báo được gửi tới tài khoản của bạn sẽ hiển thị tại đây.</div></div>}<partial name="_Pagination" model="Model" /></div></div>
