@{
    ViewData["Title"] = "Bảng điều khiển Lãnh đạo";
    
    int totalHeadcount = ViewBag.TotalHeadcount ?? 0;
    int newHires = ViewBag.NewHires ?? 0;
    decimal totalCost = ViewBag.TotalCost ?? 0m;
    int activeLeaves = ViewBag.ActiveLeaves ?? 0;
    int expiringContracts = ViewBag.ExpiringContracts ?? 0;
    string latestSalaryMonth = ViewBag.LatestSalaryMonth ?? "N/A";
    var deptStats = ViewBag.DeptStats as IEnumerable<dynamic>;
}

<div class="hrms-page-header mb-4">
    <div class="hrms-page-header-main">
        <h1 class="hrms-page-title">
            <span class="hrms-page-icon"><i class="fa-solid fa-chart-pie"></i></span>
            Executive Dashboard
        </h1>
        <div class="hrms-page-subtitle">Tổng quan điều hành, nhân sự và các chỉ số hoạt động then chốt.</div>
    </div>
    <div class="hrms-page-header-actions">
        <button class="hrms-btn hrms-btn-secondary" onclick="window.print()"><i class="fa-solid fa-print"></i> In Báo cáo</button>
        <button class="hrms-btn hrms-btn-secondary"><i class="fa-regular fa-calendar"></i> Hôm nay: @DateTime.Now.ToString("dd/MM/yyyy")</button>
    </div>
</div>

<div class="hrms-nav-grid mb-4">
    <a href="@Url.Action("Index", "Leader")" class="hrms-nav-card active">
        <i class="fa-solid fa-chart-pie nav-icon"></i>
        <span class="nav-title">Tổng quan</span>
    </a>
    <a href="@Url.Action("Index", "LeaderPersonnel")" class="hrms-nav-card">
        <i class="fa-solid fa-users nav-icon"></i>
        <span class="nav-title">Nhân sự</span>
    </a>
    <a href="@Url.Action("Index", "LeaderCost")" class="hrms-nav-card">
        <i class="fa-solid fa-money-bill-wave nav-icon"></i>
        <span class="nav-title">Chi phí</span>
    </a>
</div>

<div class="hrms-kpi-grid hrms-kpi-grid-4 mb-4">
    <div class="hrms-kpi-card kpi-blue">
        <div class="hrms-kpi-top">
            <div class="hrms-kpi-icon"><i class="fa-solid fa-users"></i></div>
            <div class="hrms-kpi-value">@totalHeadcount</div>
        </div>
        <div class="hrms-kpi-body mt-2">
            <div class="hrms-kpi-label">Tổng nhân sự (Active)</div>
            <div class="hrms-kpi-sub"><span class="sub-good"><i class="fa-solid fa-arrow-trend-up"></i> @newHires nhân sự mới</span></div>
        </div>
    </div>

    <div class="hrms-kpi-card kpi-purple">
        <div class="hrms-kpi-top">
            <div class="hrms-kpi-icon"><i class="fa-solid fa-money-check-dollar"></i></div>
            <div class="hrms-kpi-value">@(totalCost > 0 ? (totalCost / 1000000).ToString("N0") + "M" : "0")</div>
        </div>
        <div class="hrms-kpi-body mt-2">
            <div class="hrms-kpi-label">Chi phí lương (@latestSalaryMonth)</div>
            <div class="hrms-kpi-sub">
                @if(totalCost > 0) {
                    <span class="sub-good"><i class="fa-solid fa-circle-check"></i> Đã tính</span>
                } else {
                    <span class="sub-warn"><i class="fa-solid fa-clock"></i> Chưa có dữ liệu</span>
                }
            </div>
        </div>
    </div>

    <div class="hrms-kpi-card kpi-orange">
        <div class="hrms-kpi-top">
            <div class="hrms-kpi-icon"><i class="fa-solid fa-plane-departure"></i></div>
            <div class="hrms-kpi-value">@activeLeaves</div>
        </div>
        <div class="hrms-kpi-body mt-2">
            <div class="hrms-kpi-label">Nhân sự đang nghỉ phép</div>
            <div class="hrms-kpi-sub"><span class="sub-neutral">Hôm nay</span></div>
        </div>
    </div>

    <div class="hrms-kpi-card kpi-red">
        <div class="hrms-kpi-top">
            <div class="hrms-kpi-icon"><i class="fa-solid fa-file-signature"></i></div>
            <div class="hrms-kpi-value">@expiringContracts</div>
        </div>
        <div class="hrms-kpi-body mt-2">
            <div class="hrms-kpi-label">Hợp đồng sắp hết hạn</div>
            <div class="hrms-kpi-sub">
                @if(expiringContracts > 0) {
                    <span class="sub-warn"><i class="fa-solid fa-triangle-exclamation"></i> Cần chú ý</span>
                } else {
                    <span class="sub-good"><i class="fa-solid fa-check"></i> Đang ổn định</span>
                }
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-6">
        <div class="hrms-card h-100">
            <div class="hrms-card-header">
                <h3 class="hrms-card-title"><i class="fa-solid fa-sitemap card-title-icon"></i> Phân bổ nhân sự theo phòng ban</h3>
            </div>
            <div class="hrms-card-body">
                <canvas id="deptChart" height="200"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="hrms-card h-100">
            <div class="hrms-card-header">
                <h3 class="hrms-card-title"><i class="fa-solid fa-star card-title-icon"></i> Các hoạt động nổi bật</h3>
            </div>
            <div class="hrms-card-body p-0">
                <div class="hrms-table-wrap">
                    <table class="hrms-table">
                        <thead>
                            <tr>
                                <th>Chỉ số</th>
                                <th>Chi tiết</th>
                                <th class="col-actions">Hành động</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><span class="hrms-badge hrms-badge-info">Nhân sự</span></td>
                                <td>Có <strong>@newHires</strong> nhân sự mới trong thời gian này</td>
                                <td class="col-actions"><a href="@Url.Action("Index", "LeaderPersonnel")" class="hrms-btn hrms-btn-xs hrms-btn-secondary">Xem chi tiết</a></td>
                            </tr>
                            <tr>
                                <td><span class="hrms-badge hrms-badge-danger">Hợp đồng</span></td>
                                <td><strong>@expiringContracts</strong> hợp đồng cần gia hạn (30 ngày)</td>
                                <td class="col-actions"><a href="@Url.Action("Index", "LeaderContract")" class="hrms-btn hrms-btn-xs hrms-btn-secondary">Kiểm tra</a></td>
                            </tr>
                            <tr>
                                <td><span class="hrms-badge hrms-badge-warning">Nghỉ phép</span></td>
                                <td><strong>@activeLeaves</strong> nhân viên đang vắng mặt hôm nay</td>
                                <td class="col-actions"><a href="@Url.Action("Index", "LeaderLeave")" class="hrms-btn hrms-btn-xs hrms-btn-secondary">Chi tiết</a></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            var ctx = document.getElementById('deptChart').getContext('2d');
            
            var rawStats = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(deptStats));
            
            var labels = rawStats.map(item => item.Department);
            var data = rawStats.map(item => item.Headcount);

            var chart = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: labels,
                    datasets: [{
                        data: data,
                        backgroundColor: ['#3b82f6', '#10b981', '#f59e0b', '#ef4444', '#8b5cf6', '#06b6d4'],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'right' }
                    }
                }
            });
        });
    </script>
}
