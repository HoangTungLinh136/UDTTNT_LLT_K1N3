            <div class="compare-val"><span>Phòng ban:</span> <strong id="dt_newDept" style="color:#166534;"></strong></div>
            <div class="compare-val"><span>Chức vụ:</span> <strong id="dt_newPos" style="color:#166534;"></strong></div>
            <div class="compare-val"><span>Chức danh:</span> <strong id="dt_newTitle" style="color:#166534;"></strong></div>
