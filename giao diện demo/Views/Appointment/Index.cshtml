@section Scripts {
<script>
// =============== CREATE DRAWER LOGIC (MANAGER) ===============
function openCreateDrawer() {
    var overlay = document.getElementById('createDrawerOverlay');
    var panel = document.getElementById('createDrawerPanel');
    if (!overlay || !panel) return;
    
    overlay.classList.add('open');
    panel.classList.add('open');
    
    document.getElementById('formEmployeeId').value = '';
    document.getElementById('empSearchInput').value = '';
    document.getElementById('curDept').value = '';
    document.getElementById('curPos').value = '';
    document.getElementById('curTitle').value = '';
    document.getElementById('newDept').value = '';
    document.getElementById('newPos').value = '';
    document.getElementById('newTitle').value = '';
    document.getElementById('decisionNum').value = '';
    document.getElementById('decisionDate').value = '';
    document.getElementById('effectiveDate').value = '';
    document.getElementById('reason').value = '';
    document.getElementById('notes').value = '';
}

function closeCreateDrawer() {
    var overlay = document.getElementById('createDrawerOverlay');
    var panel = document.getElementById('createDrawerPanel');
    if (overlay) overlay.classList.remove('open');
    if (panel) panel.classList.remove('open');
}

const empSearchInput = document.getElementById('empSearchInput');
const empDropdown = document.getElementById('empDropdown');
let searchTimeout = null;

if (empSearchInput && empDropdown) {
    empSearchInput.addEventListener('input', function() {
        clearTimeout(searchTimeout);
        const q = this.value.trim();
        if (q.length < 2) {
            empDropdown.classList.remove('show');
            return;
        }
        
        searchTimeout = setTimeout(() => {
            fetch(`/Appointment/GetEmployees?q=${encodeURIComponent(q)}`)
                .then(res => res.json())
                .then(data => {
                    empDropdown.innerHTML = '';
                    if (data.length === 0) {
                        empDropdown.innerHTML = '<div style="padding: 10px 14px; color: #64748b;">Không tìm thấy nhân viên trong phạm vi quản lý.</div>';
                    } else {
                        data.forEach(emp => {
                            let avHtml = emp.avatarPath ? `<img src="${emp.avatarPath}">` : (emp.name ? emp.name.charAt(0).toUpperCase() : '?');
                            let div = document.createElement('div');
                            div.className = 'emp-item';
                            div.innerHTML = `
                                <div class="emp-item-avatar">${avHtml}</div>
                                <div class="emp-item-info">
                                    <span class="emp-item-name">${emp.name}</span>
                                    <span class="emp-item-code">${emp.employeeCode} | ${emp.department || 'Không phòng ban'}</span>
                                </div>
                            `;
                            div.onclick = () => selectEmployee(emp);
                            empDropdown.appendChild(div);
                        });
                    }
                    empDropdown.classList.add('show');
                });
        }, 350);
    });

    document.addEventListener('click', function(e) {
        if (!empSearchInput.contains(e.target) && !empDropdown.contains(e.target)) {
            empDropdown.classList.remove('show');
        }
    });
}

function selectEmployee(emp) {
    empSearchInput.value = `${emp.name} - ${emp.employeeCode}`;
    document.getElementById('formEmployeeId').value = emp.id;
    document.getElementById('curDept').value = emp.department || '';
    document.getElementById('curPos').value = emp.position || '';
    document.getElementById('curTitle').value = emp.jobTitle || '';
    
    document.getElementById('newDept').value = emp.department || '';
    document.getElementById('newPos').value = emp.position || '';
    document.getElementById('newTitle').value = emp.jobTitle || '';

    empDropdown.classList.remove('show');
}

function submitCreateForm(isSubmit) {
    const empId = document.getElementById('formEmployeeId').value;
    const newDept = document.getElementById('newDept').value;
    const newPos = document.getElementById('newPos').value;
    const effDate = document.getElementById('effectiveDate').value;
    const reason = document.getElementById('reason').value;

    if(!empId) { alert('Vui lòng chọn nhân viên.'); return; }
    if(!newDept || !newPos) { alert('Vui lòng chọn phòng ban và chức vụ mới.'); return; }
    if(!effDate) { alert('Vui lòng chọn ngày hiệu lực.'); return; }
    if(!reason.trim()) { alert('Vui lòng nhập lý do bổ nhiệm.'); return; }

    const payload = {
        employeeId: parseInt(empId),
        newDepartment: newDept,
        newPosition: newPos,
        newJobTitle: document.getElementById('newTitle').value,
        effectiveDate: effDate,
        reason: reason,
        notes: document.getElementById('notes').value,
        decisionNumber: document.getElementById('decisionNum').value,
        decisionDate: document.getElementById('decisionDate').value || null
    };

    fetch(`/Appointment/Create?isSubmit=${isSubmit}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
    })
    .then(res => res.json())
    .then(data => {
        if(data.success) {
            alert(data.message);
            window.location.reload();
        } else {
            alert('Lỗi: ' + data.message);
        }
    })
    .catch(err => {
        console.error(err);
        alert('Có lỗi xảy ra khi kết nối server.');
    });
}

// =============== DETAIL DRAWER LOGIC ===============
let currentRecordId = null;

function viewDetail(id) {
    currentRecordId = id;
    document.getElementById('detailDrawerOverlay').classList.add('open');
    document.getElementById('detailDrawerPanel').classList.add('open');
    
    const body = document.getElementById('detailBody');
    body.innerHTML = '<div style="text-align:center; padding: 40px; color:#94a3b8;"><i class="fas fa-spinner fa-spin fa-2x"></i><p>Đang tải dữ liệu...</p></div>';
    document.getElementById('detailFooter').innerHTML = '<button class="btn-ob-outline" onclick="closeDetailDrawer()">Đóng</button>';

    fetch(`/Appointment/Detail/${id}`)
    .then(res => { if(!res.ok) throw new Error(); return res.json(); })
    .then(data => {
        renderDetail(data);
    })
    .catch(err => {
        body.innerHTML = '<div style="color:#ef4444; padding:20px;">Lỗi tải dữ liệu hoặc bạn không có quyền xem hồ sơ này.</div>';
    });
}

function closeDetailDrawer() {
    document.getElementById('detailDrawerOverlay').classList.remove('open');
    document.getElementById('detailDrawerPanel').classList.remove('open');
    currentRecordId = null;
}

function renderDetail(data) {
    const template = document.getElementById('detailTemplate').content.cloneNode(true);
    
    // Avatar
    let avDiv = template.getElementById('dt_avatar');
    if (data.avatarPath) {
        avDiv.innerHTML = `<img src="${data.avatarPath}" style="width:100%; height:100%; object-fit:cover;">`;
    } else {
        avDiv.textContent = data.employeeName ? data.employeeName.charAt(0).toUpperCase() : '?';
    }

    template.getElementById('dt_empName').textContent = data.employeeName;
    template.getElementById('dt_empCode').textContent = data.employeeCode;
    
    // Status Badge
    let stHtml = '';
    if(data.approvalStatus == "DRAFT") stHtml = '<span class="badge-status badge-draft">Bản nháp</span>';
    else if(data.approvalStatus == "PENDING_HR_REVIEW") stHtml = '<span class="badge-status badge-pending-hr"><i class="fas fa-clock"></i> Chờ HR xác minh</span>';
    else if(data.approvalStatus == "PENDING_LEADER_APPROVAL") stHtml = '<span class="badge-status badge-pending-leader"><i class="fas fa-hourglass-half"></i> Chờ Lãnh đạo duyệt</span>';
    else if(data.approvalStatus == "APPROVED") stHtml = '<span class="badge-status badge-approved"><i class="fas fa-check"></i> Đã duyệt</span>';
    else if(data.approvalStatus == "EFFECTIVE") stHtml = '<span class="badge-status badge-effective"><i class="fas fa-check-double"></i> Đã hiệu lực</span>';
    else if(data.approvalStatus == "REJECTED") stHtml = '<span class="badge-status badge-rejected">Từ chối</span>';
    else stHtml = '<span class="badge-status badge-cancelled">Đã hủy</span>';
    template.getElementById('dt_statusBadge').innerHTML = stHtml;

    // Eff Badge
    let effHtml = '';
    if(data.effectiveStatus == "EFFECTIVE") effHtml = '<i class="fas fa-check-circle" style="color:#059669;"></i> Đã áp dụng';
    else if(data.effectiveStatus == "UPCOMING") effHtml = '<i class="fas fa-calendar-clock" style="color:#2563eb;"></i> Sắp hiệu lực';
    else if(data.effectiveStatus == "READY_TO_APPLY") effHtml = '<i class="fas fa-clock" style="color:#d97706;"></i> Chờ hệ thống áp dụng';
    template.getElementById('dt_effBadge').innerHTML = effHtml;

    template.getElementById('dt_oldDept').textContent = data.previousDepartment || '---';
    template.getElementById('dt_oldPos').textContent = data.previousPosition || '---';
    template.getElementById('dt_oldTitle').textContent = data.previousJobTitle || '---';

    template.getElementById('dt_newDept').textContent = data.newDepartment || '---';
    template.getElementById('dt_newPos').textContent = data.newPosition || '---';
    template.getElementById('dt_newTitle').textContent = data.newJobTitle || '---';

    template.getElementById('dt_decNum').textContent = data.decisionNumber || '---';
    template.getElementById('dt_decDate').textContent = data.decisionDate || '---';
    template.getElementById('dt_effDate').textContent = data.effectiveDate || '---';
    template.getElementById('dt_createdBy').textContent = data.createdBy || '---';
    template.getElementById('dt_createdAt').textContent = data.createdAt ? `(${data.createdAt})` : '';
    template.getElementById('dt_reason').textContent = data.reason || '---';

    if (data.approvalStatus == 'REJECTED' && data.rejectionReason) {
        template.getElementById('dt_rejectReasonBox').style.display = 'block';
        template.getElementById('dt_rejectReason').textContent = data.rejectionReason;
    }

    // Timeline History
    let histContainer = template.getElementById('dt_history');
    if (data.histories && data.histories.length > 0) {
        data.histories.forEach(h => {
            let color = "#3b82f6";
            if (h.action == "APPROVE" || h.action == "LEADER_APPROVE" || h.action == "EFFECTIVE") color = "#22c55e";
            if (h.action == "REJECT" || h.action == "CANCEL") color = "#ef4444";
            if (h.action == "HR_VERIFY") color = "#6366f1";
            
            let html = `
            <div class="timeline-item">
                <div class="timeline-dot" style="background:${color}"></div>
                <div class="timeline-time">${h.timestamp} - <b>${h.actor}</b></div>
                <div class="timeline-content">
                    <strong>${h.action}</strong>
                    <p>${h.details}</p>
                </div>
            </div>`;
            histContainer.insertAdjacentHTML('beforeend', html);
        });
    } else {
        histContainer.innerHTML = '<div style="color:#94a3b8; font-size:13px; font-style:italic;">Không có lịch sử</div>';
    }

    // Attach to DOM
    const body = document.getElementById('detailBody');
    body.innerHTML = '';
    body.appendChild(template);

    // Footer actions - Strictly aligned with Authority Matrix
    let footerHtml = '<button class="btn-ob-outline" onclick="closeDetailDrawer()">Đóng</button>';
    var currentRole = '@role';
    
    if (data.approvalStatus == 'DRAFT') {
        footerHtml += `<button class="btn-ob-primary" onclick="actionRecord('Submit', ${data.id})">Trình duyệt</button>`;
        footerHtml += `<button class="btn-ob-reset" onclick="actionRecord('Cancel', ${data.id}, true)">Hủy bỏ</button>`;
    } 
    else if (data.approvalStatus == 'PENDING_HR_REVIEW' && currentRole === 'HR') {
        // HR Processing: Verify & Forward to Leader (NOT final approve)
        footerHtml += `<button class="btn-ob-reset" onclick="actionRecord('Reject', ${data.id}, true)">Từ chối</button>`;
        footerHtml += `<button class="btn-ob-primary" style="background:#4f46e5;" onclick="actionRecord('Approve', ${data.id}, false, 'Xác nhận kiểm tra và chuyển Ban Lãnh đạo phê duyệt quyết định bổ nhiệm này?')"><i class="fas fa-check-double"></i> Xác minh & Chuyển Lãnh đạo</button>`;
    }
    else if (data.approvalStatus == 'PENDING_LEADER_APPROVAL' && currentRole === 'Leader') {
        // Leader Final Decision
        footerHtml += `<button class="btn-ob-reset" onclick="actionRecord('Reject', ${data.id}, true)">Từ chối</button>`;
        footerHtml += `<button class="btn-ob-primary" style="background:#16a34a;" onclick="actionRecord('Approve', ${data.id}, false, 'Xác nhận phê duyệt chính thức quyết định bổ nhiệm này?')"><i class="fas fa-check"></i> Phê duyệt</button>`;
    }
    
    document.getElementById('detailFooter').innerHTML = footerHtml;
}

function actionRecord(action, id, requireReason = false, customConfirm = null) {
    let url = `/Appointment/${action}/${id}`;
    
    if (requireReason) {
        let reason = prompt(`Vui lòng nhập lý do để ${action}:`);
        if (reason === null) return;
        if (reason.trim() === '') {
            alert('Lý do không được để trống.');
            return;
        }
        url += `?reason=${encodeURIComponent(reason)}`;
    } else {
        let msg = customConfirm || `Xác nhận thực hiện: ${action}?`;
        if (!confirm(msg)) return;
    }

    fetch(url, { method: 'POST' })
    .then(res => res.json())
    .then(data => {
        alert(data.message || 'Thao tác thành công');
        window.location.reload();
    })
    .catch(err => {
        console.error(err);
        alert('Có lỗi xảy ra khi gửi yêu cầu lên máy chủ.');
    });
}
</script>
}
