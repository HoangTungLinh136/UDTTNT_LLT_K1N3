@model IEnumerable<giao_dien_demo.Models.Report>
@using Microsoft.AspNetCore.Http
@{ ViewData["Title"] = "Báo cáo tổng hợp Nhân sự"; var role = Context.Session.GetString("Role"); var departments = ViewBag.Departments as List<string> ?? new List<string>(); var search = ViewBag.Search as string ?? ""; var currentDepartment = ViewBag.Department as string ?? ""; var from = ViewBag.From is DateTime f ? f.ToString("yyyy-MM-dd") : ""; var to = ViewBag.To is DateTime t ? t.ToString("yyyy-MM-dd") : ""; var total = ViewBag.Total is int n ? n : Model?.Count() ?? 0; var page = ViewBag.Page is int p ? p : 1; var pageSize = ViewBag.PageSize is int ps ? ps : 50; var totalPages = Math.Max(1, (int)Math.Ceiling(total / (double)pageSize)); }
<div class="container-fluid mt-3 mb-5">
    <div class="hrms-page-header"><div class="hrms-page-header-main"><h1 class="hrms-page-title"><span class="hrms-page-icon purple"><i class="fa-solid fa-chart-pie"></i></span>Báo cáo tổng hợp Nhân sự</h1><p class="hrms-page-subtitle">Tổng hợp chỉ số nhân sự từ dữ liệu Employee, Salary và Leave đã được phê duyệt.</p></div><div class="hrms-page-header-actions"><a href="@Url.Action("Export", "Report", new { search, department = currentDepartment, from = ViewBag.From, to = ViewBag.To })" class="hrms-btn hrms-btn-primary"><i class="fa-solid fa-file-export"></i> Xuất CSV</a></div></div>
    <form method="get" action="@Url.Action("Index", "Report")" class="hrms-filter-bar"><div class="hrms-search-wrap"><i class="fa-solid fa-search search-icon"></i><input name="search" value="@search" class="hrms-search-input" placeholder="Tìm mã hoặc tên nhân viên" /></div><select name="department" class="hrms-filter-select"><option value="">Tất cả phòng ban</option>@foreach(var d in departments){if(d == currentDepartment){<option value="@d" selected>@d</option>}else{<option value="@d">@d</option>}}</select><input type="date" name="from" value="@from" class="hrms-form-control" aria-label="Từ ngày" /><input type="date" name="to" value="@to" class="hrms-form-control" aria-label="Đến ngày" /><button type="submit" class="hrms-btn hrms-btn-primary"><i class="fa-solid fa-filter"></i> Lọc</button><a href="@Url.Action("Index", "Report")" class="hrms-btn hrms-btn-secondary">Đặt lại</a></form>
    <section class="hrms-card"><div class="hrms-card-header"><h2 class="hrms-card-title"><i class="fa-solid fa-table-list card-title-icon"></i>Kết quả báo cáo <span class="notification-badge">@total</span></h2><span class="text-muted small">Trang @(page) / @(totalPages)</span></div><div class="hrms-card-body p-0"><div class="hrms-table-wrap"><table class="hrms-table"><thead><tr><th>Mã NV</th><th>Nhân viên</th><th>Thưởng lễ</th><th>Chuyên cần</th><th>Khen thưởng</th><th>Kỷ luật</th><th>Nghỉ phép</th><th>KPI</th>@if(role == "HR"){<th>Thao tác</th>}</tr></thead><tbody>@if(Model != null && Model.Any()){foreach(var item in Model){<tr><td>@(string.IsNullOrWhiteSpace(item.EmployeeCode) ? "Chưa được cấp mã" : item.EmployeeCode)</td><td><strong>@item.EmployeeName</strong><br/><small class="text-muted">@item.Department</small></td><td>@item.HolidayBonus</td><td>@item.DiligenceBonus</td><td>@item.Reward</td><td>@item.Discipline</td><td>@item.LeaveDays ngày <small class="text-muted">(@item.LeaveType)</small></td><td><span class="hrms-badge hrms-badge-info">@item.TaskStatus</span></td>@if(role == "HR"){<td><a asp-action="Edit" asp-route-id="@item.Id" class="hrms-btn hrms-btn-sm hrms-btn-secondary"><i class="fa-solid fa-pen"></i> Sửa</a></td>}</tr>}}else{<tr><td colspan="@(role == "HR" ? 9 : 8)"><div class="hrms-empty-state"><div class="hrms-empty-icon"><i class="fa-solid fa-chart-pie"></i></div><h3 class="hrms-empty-title">Chưa có dữ liệu báo cáo</h3><p class="hrms-empty-desc">Thử điều chỉnh bộ lọc hoặc quay lại khi hệ thống có dữ liệu nhân sự.</p></div></td></tr>}</tbody></table></div></div>@if(totalPages > 1){<div class="hrms-pagination"><span class="hrms-pagination-info">Hiển thị @(((page - 1) * pageSize) + 1)-@Math.Min(page * pageSize, total) trên @total</span><div class="hrms-pagination-pages">@if(page > 1){<a class="hrms-page-link" href="@Url.Action("Index", new { search, department = currentDepartment, from = ViewBag.From, to = ViewBag.To, page = page - 1 })">‹</a>}@if(page < totalPages){<a class="hrms-page-link" href="@Url.Action("Index", new { search, department = currentDepartment, from = ViewBag.From, to = ViewBag.To, page = page + 1 })">›</a>}</div></div>}</section>
</div>
