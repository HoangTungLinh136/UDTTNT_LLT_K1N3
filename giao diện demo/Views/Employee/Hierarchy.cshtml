@model giao_dien_demo.Models.OrganizationHierarchyViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Cây phân cấp";
    var currentUserRole = Model.CurrentUserRole;
    var isAdminOrHr = currentUserRole == "Admin" || currentUserRole == "HR";

    // Flatten all scoped nodes for instant drawer lookup
    var allNodesList = new List<giao_dien_demo.Models.HierarchyNodeViewModel>();
    void Flatten(giao_dien_demo.Models.HierarchyNodeViewModel n)
    {
        allNodesList.Add(n);
        if (n.DirectReports != null)
        {
            foreach (var c in n.DirectReports) Flatten(c);
        }
    }
    foreach (var r in Model.RootNodes) Flatten(r);

    // Build safe JSON payload for client-side instant drawer interaction
    var clientData = allNodesList.ToDictionary(n => n.Id, n => new {
        id = n.Id,
        employeeCode = n.EmployeeCode,
        name = n.Name,
        jobTitle = n.JobTitle ?? n.Position ?? "Nhân viên",
        department = n.Department ?? "Chưa phân phòng",
        position = n.Position ?? "Chính thức",
        status = n.Status ?? "Active",
        managerId = n.ManagerId,
        managerName = n.ManagerName,
        managerCode = n.ManagerCode,
        avatarPath = n.AvatarPath,
        email = n.Email ?? "Chưa cập nhật",
        phoneNumber = n.PhoneNumber ?? "Chưa cập nhật",
        joinDateFormatted = n.JoinDateFormatted ?? "Chưa cập nhật",
        isCurrentUser = n.IsCurrentUser,
        isManagerOutsideScope = n.IsManagerOutsideScope,
        hierarchyState = n.HierarchyState,
        canViewDetails = n.CanViewDetails,
        canManageManager = n.CanManageManager,
        directReports = n.DirectReports.Select(c => new {
            id = c.Id,
            employeeCode = c.EmployeeCode,
            name = c.Name,
            jobTitle = c.JobTitle ?? c.Position ?? "Nhân viên",
            department = c.Department ?? "Chưa phân phòng",
            avatarPath = c.AvatarPath
        }).ToList(),
        reportingHistories = n.ReportingHistories.Select(h => new {
            id = h.Id,
            previousManagerName = h.PreviousManagerName,
            previousManagerCode = h.PreviousManagerCode,
            newManagerName = h.NewManagerName,
            newManagerCode = h.NewManagerCode,
            changeReason = h.ChangeReason,
            effectiveDate = h.EffectiveDate.ToString("dd/MM/yyyy"),
            changedByName = h.ChangedByName
        }).ToList()
    });

    var serializedData = JsonSerializer.Serialize(clientData);
}

