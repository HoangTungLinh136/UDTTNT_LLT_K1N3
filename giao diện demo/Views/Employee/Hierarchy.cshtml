    height: 18px;
    background: #e2e8f0;
    margin: 0 2px;
}

/* Floating Navigation Hint */
.tree-pan-instruction {
    position: absolute;
    bottom: 14px;
    left: 14px;
    z-index: 30;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border: 1px solid rgba(226, 232, 240, 0.85);
    border-radius: 20px;
    padding: 5px 12px;
    font-size: 11.5px;
    font-weight: 500;
    color: #64748b;
    pointer-events: none;
    box-shadow: 0 2px 6px rgba(15, 23, 42, 0.04);
}

/* Pure CSS Hierarchical Tree Structure */
.org-chart-root {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 40px;
}
.org-chart-root:last-child {
    margin-bottom: 0;
}
.tree-children-list {
    display: flex;
    justify-content: center;
    position: relative;
    padding: 24px 0 0 0;
    margin: 0;
    list-style: none;
}
.tree-node-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    padding: 24px 14px 0 14px;
}

/* Connectors using ::before and ::after */
.tree-node-item::before, .tree-node-item::after {
    content: '';
    position: absolute;
    top: 0;
    right: 50%;
    border-top: 2px solid #cbd5e1;
    width: 50%;
    height: 24px;
}
.tree-node-item::after {
    right: auto;
    left: 50%;
    border-left: 2px solid #cbd5e1;
}
.tree-node-item:only-child::after, .tree-node-item:only-child::before {
    display: none;
}
.tree-node-item:only-child {
    padding-top: 0;
}
.tree-node-item:first-child::before {
    border: 0 none;
}
.tree-node-item:last-child::after {
    border: 0 none;
}
.tree-node-item:last-child::before {
    border-right: 2px solid #cbd5e1;
    border-radius: 0 6px 0 0;
}
.tree-node-item:first-child::after {
    border-radius: 6px 0 0 0;
}
/* Downward stem from parent node */
.tree-children-list::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    border-left: 2px solid #cbd5e1;
    width: 0;
    height: 24px;
}

