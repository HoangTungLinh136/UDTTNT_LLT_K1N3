    max-height: calc(100vh - 40px);
}
@@media (max-width: 991px) {
    .hierarchy-main-layout { display: block; }
    .hierarchy-drawer-column {
        position: fixed;
        right: 0;
        top: 0;
        bottom: 0;
        width: 380px;
        z-index: 1050;
        box-shadow: -6px 0 25px rgba(0,0,0,0.15);
        display: none;
        max-height: 100vh;
    }
    .hierarchy-drawer-column.mobile-open {
        display: block;
    }
}

/* --- Tree Viewport & Pan-Zoom Canvas --- */
.tree-viewport {
    position: relative;
    overflow: hidden !important;
    min-height: 580px;
    height: calc(100vh - 290px);
    max-height: 820px;
    background-color: #fafbfe;
    background-image: radial-gradient(#cbd5e1 1.2px, transparent 1.2px);
    background-size: 22px 22px;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
    touch-action: none;
    transition: background-color 0.2s ease;
}

.tree-viewport:active,
.tree-viewport.is-panning {
    cursor: grabbing !important;
}

.tree-canvas-content {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    padding: 40px 60px 100px 60px;
    transform-origin: 0 0;
    will-change: transform;
    min-width: 100%;
}

/* Ensure interactive elements keep normal cursor */
.tree-canvas-content .node-card,
.tree-canvas-content .org-card,
.tree-canvas-content .org-node-toggle,
.tree-canvas-content button,
.tree-canvas-content a {
    cursor: pointer !important;
    user-select: auto;
}

/* Floating Zoom Toolbar */
.tree-zoom-toolbar {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 30;
    display: flex;
    align-items: center;
    gap: 3px;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    padding: 4px 6px;
    border-radius: 10px;
    border: 1px solid rgba(226, 232, 240, 0.9);
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.08);
}

.zoom-tool-btn {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    border-radius: 7px;
    color: #475569;
    font-size: 13px;
    cursor: pointer;
    transition: all 0.15s ease;
}

.zoom-tool-btn:hover {
    background: #f1f5f9;
