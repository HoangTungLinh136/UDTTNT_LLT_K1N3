}
.switch-control {
    position: relative;
    display: inline-block;
    width: 40px;
    height: 22px;
}
.switch-control input {
    opacity: 0;
    width: 0;
    height: 0;
}
.switch-slider {
    position: absolute;
    cursor: pointer;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: #cbd5e1;
    transition: .3s;
    border-radius: 24px;
}
.switch-slider:before {
    position: absolute;
    content: "";
    height: 16px;
    width: 16px;
    left: 3px;
    bottom: 3px;
    background-color: white;
    transition: .3s;
    border-radius: 50%;
}
.switch-control input:checked + .switch-slider {
    background-color: #2563eb;
}
.switch-control input:checked + .switch-slider:before {
    transform: translateX(18px);
}

/* Toolbar Buttons */
.btn-tool {
    border-radius: 8px;
    font-size: 12.5px;
    font-weight: 500;
    padding: 7px 14px;
    display: inline-flex;
    align-items: center;
