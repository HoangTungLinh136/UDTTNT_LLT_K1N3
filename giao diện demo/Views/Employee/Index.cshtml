@model List<giao_dien_demo.Models.Employee>

@{
    ViewData["Title"] = "Quản lý nhân viên";
    var departments = ViewBag.Departments as List<string> ?? new List<string>();
    string searchName = ViewBag.CurrentSearch as string ?? "";
    string currentDept = ViewBag.CurrentDept as string ?? "";
    string currentStatus = Context.Request.Query["status"].ToString() ?? "Active";
}

<style>
/* Module Nhân viên — Domain-specific enhancements */
.table-employee tbody tr.row-removed { transform: translateX(50px); opacity: 0; transition: all 0.5s ease; }
.emp-name-cell { display: flex; align-items: center; gap: 12px; }
.emp-avatar {
    width: 38px; height: 38px; border-radius: 50%; background: linear-gradient(135deg, #e2e8f0, #cbd5e1);
    display: flex; align-items: center; justify-content: center; color: #475569; font-weight: 700; font-size: 14px; flex-shrink: 0;
}
.emp-info-wrap { display: flex; flex-direction: column; }
.emp-name { font-weight: 700; color: #0f172a; font-size: 13.5px; text-decoration: none; }
.emp-name:hover { color: var(--color-primary, #2563eb); text-decoration: underline; }
.emp-id { font-size: 11.5px; color: #64748b; margin-top: 2px; }
.money-cell { font-variant-numeric: tabular-nums; font-weight: 600; color: #0f172a; }
.btn-action-group { display: flex; gap: 4px; align-items: center; justify-content: center; }
</style>

<div>
    @* ============= PAGE HEADER ============= *@
    <div class="hrms-page-header mb-4">
        <div class="hrms-page-header-main">
            <h1 class="hrms-page-title">
                <span class="hrms-page-icon"><i class="fas fa-users"></i></span>
                Quản lý nhân viên
            </h1>
            <p class="hrms-page-subtitle">Quản lý thông tin, phòng ban và chức vụ của nhân sự hệ thống</p>
        </div>
        <div class="hrms-page-header-actions">
            <a href="/Employee/Create" class="hrms-btn hrms-btn-primary">
                <i class="fas fa-plus me-1"></i> Thêm nhân viên
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success mb-3" role="alert"><i class="fas fa-check-circle me-2"></i>@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger mb-3" role="alert"><i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]</div>
    }

    @* ============= SEARCH / FILTER ============= *@
    <div class="hrms-filter-bar mb-4">
        <form method="get" asp-action="Index" style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;width:100%;">
            <div class="hrms-search-input-wrap" style="flex:1;min-width:250px;max-width:360px;">
                <i class="fas fa-search search-icon"></i>
                <input type="text" name="searchName" value="@searchName" placeholder="Tên hoặc mã nhân viên (VD: NV001)..." class="hrms-search-input" autocomplete="off" />
            </div>
            
            <select name="department" class="hrms-filter-select" style="min-width:200px;">
                <option value="">-- Tất cả phòng ban --</option>
                @foreach (var dept in departments)
                {
                    <option value="@dept" selected="@(dept == currentDept ? "selected" : null)">@dept</option>
                }
            </select>
            
            <select name="status" class="hrms-filter-select" style="min-width:180px;">
                <option value="All" selected="@(currentStatus == "All" ? "selected" : null)">-- Tất cả trạng thái --</option>
                <option value="Active" selected="@(currentStatus == "Active" ? "selected" : null)">Đang làm việc</option>
                <option value="OnLeave" selected="@(currentStatus == "OnLeave" ? "selected" : null)">Nghỉ phép</option>
                <option value="Terminated" selected="@(currentStatus == "Terminated" ? "selected" : null)">Đã nghỉ việc</option>
            </select>

            <button type="submit" class="hrms-btn hrms-btn-primary">
                Lọc dữ liệu
            </button>
            @if (!string.IsNullOrWhiteSpace(searchName) || !string.IsNullOrWhiteSpace(currentDept))
            {
                <a href="/Employee/Index" class="hrms-btn hrms-btn-secondary">
                    Xóa lọc
                </a>
            }
        </form>
    </div>

    @* ============= TABLE CARD ============= *@
    <div class="hrms-card">
        <div class="hrms-card-header d-flex justify-content-between align-items-center">
            <h3 class="hrms-card-title d-flex align-items-center gap-2">
                <i class="fas fa-list text-primary"></i>
                Danh sách nhân sự
                <span class="hrms-badge hrms-badge-info">@(Model?.Count ?? 0) nhân viên</span>
            </h3>
        </div>

        <div class="hrms-card-body p-0">
            <div class="hrms-table-wrap">
                <table class="hrms-table" id="employeeTable">
                    <thead>
                        <tr>
                            <th style="width: 50px; text-align: center;">STT</th>
                            <th style="text-align: left;">Thông tin nhân viên</th>
                            <th style="text-align: left;">Phòng ban</th>
                            <th style="text-align: left;">Chức vụ</th>
                            <th style="text-align: left;">Trình độ</th>
                            <th style="text-align: center;">Trạng thái</th>
                            <th style="text-align: right;" class="col-money">Mức lương CB</th>
                            <th style="width: 130px; text-align: center;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody id="employeeTableBody">
                        @if (Model != null && Model.Any())
                        {
                            int stt = 1;
                            foreach (var item in Model)
                            {
                                <tr id="row-@item.Id">
                                    <td class="stt-cell text-center text-muted fw-medium">@stt</td>
                                    <td>
                                        <div class="emp-name-cell">
                                            <div class="emp-avatar">
                                                @(string.IsNullOrEmpty(item.Name) ? "?" : item.Name.Substring(0, 1).ToUpper())
                                            </div>
                                            <div class="emp-info-wrap">
                                                <a asp-action="Details" asp-route-id="@item.Id" class="emp-name">@item.Name</a>
                                                <div class="emp-id">@(string.IsNullOrWhiteSpace(item.EmployeeCode) ? "Chưa được cấp mã" : item.EmployeeCode)</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td><span class="hrms-badge hrms-badge-neutral">@(string.IsNullOrEmpty(item.Department) ? "---" : item.Department)</span></td>
                                    <td><span class="hrms-badge hrms-badge-info">@(string.IsNullOrEmpty(item.Position) ? "---" : item.Position)</span></td>
                                    <td><span class="hrms-badge hrms-badge-purple">@(string.IsNullOrEmpty(item.AcademicLevel) ? "---" : item.AcademicLevel)</span></td>
                                    <td style="text-align: center;">
                                        @if(item.Status == "Active") { <span class="hrms-badge hrms-badge-success">Đang làm việc</span> }
                                        else if(item.Status == "Terminated") { <span class="hrms-badge hrms-badge-danger">Đã nghỉ việc</span> }
                                        else if(item.Status == "OnLeave") { <span class="hrms-badge hrms-badge-warning">Nghỉ phép</span> }
                                        else { <span class="hrms-badge hrms-badge-neutral">@item.Status</span> }
                                    </td>
                                    <td style="text-align: right;" class="col-money">
                                        <div class="money-cell">@item.Salary.ToString("N0") ₫</div>
                                    </td>
                                    <td>
                                        <div class="btn-action-group">
                                            <a asp-action="Details" asp-route-id="@item.Id" class="hrms-btn hrms-btn-xs hrms-btn-ghost" title="Xem chi tiết">
                                                <i class="fas fa-eye text-primary"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="hrms-btn hrms-btn-xs hrms-btn-ghost" title="Chỉnh sửa">
                                                <i class="fas fa-edit text-warning"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                                stt++;
                            }
                        }
                        else
                        {
                            <tr id="emptyRow">
                                <td colspan="8">
                                    <div class="hrms-empty-state py-5 text-center">
                                        <div class="hrms-empty-state-icon mb-2"><i class="fas fa-user-slash fa-2x text-muted"></i></div>
                                        <div class="hrms-empty-state-title fw-bold">Không tìm thấy dữ liệu</div>
                                        <div class="hrms-empty-state-text text-muted small">Vui lòng kiểm tra lại từ khóa hoặc phân loại phòng ban.</div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<form id="employeeCsrf" hidden>@Html.AntiForgeryToken()</form>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        const connection = window.HRMSSignalRConnection;

        connection.on("ContractApproved", function (employeeName) {
            Swal.fire({
                toast: true, position: 'top-end', icon: 'success',
                title: `Hệ thống: ${employeeName} đã được thêm vào danh sách!`,
                showConfirmButton: false, timer: 3000
            });
            setTimeout(() => { location.reload(); }, 1500);
        });

        function updateSTT() {
            const rows = document.querySelectorAll("#employeeTableBody tr:not(#emptyRow)");
            rows.forEach((row, index) => {
                let sttCell = row.querySelector(".stt-cell");
                if (sttCell) sttCell.innerText = index + 1;
            });
            if (rows.length === 0) {
                document.getElementById("employeeTableBody").innerHTML = '<tr id="emptyRow"><td colspan="8"><div class="hrms-empty-state py-5 text-center"><div class="hrms-empty-state-icon mb-2"><i class="fas fa-user-slash fa-2x text-muted"></i></div><div class="hrms-empty-state-title fw-bold">Danh sách hiện đang trống</div></div></td></tr>';
            }
        }

    </script>
}
