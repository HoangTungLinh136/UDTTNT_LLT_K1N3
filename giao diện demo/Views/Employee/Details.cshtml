@model giao_dien_demo.Models.Employee
@using giao_dien_demo.Models

@{
    ViewData["Title"] = "Hồ sơ chi tiết nhân viên";
    var contracts = ViewBag.Contracts as IEnumerable<Contract> ?? Enumerable.Empty<Contract>();
    var appointments = ViewBag.Appointments as IEnumerable<AppointmentRecord> ?? Enumerable.Empty<AppointmentRecord>();
    var transfers = ViewBag.Transfers as IEnumerable<TransferRecord> ?? Enumerable.Empty<TransferRecord>();
    var dismissals = ViewBag.Dismissals as IEnumerable<DismissalRecord> ?? Enumerable.Empty<DismissalRecord>();
    var rewards = ViewBag.Rewards as IEnumerable<RewardRecord> ?? Enumerable.Empty<RewardRecord>();
    var leaves = ViewBag.Leaves as IEnumerable<Leave> ?? Enumerable.Empty<Leave>();
    var reportingHistories = ViewBag.ReportingHistories as IEnumerable<EmployeeReportingHistory> ?? Enumerable.Empty<EmployeeReportingHistory>();
    var eligibleManagers = ViewBag.EligibleManagers as IEnumerable<Employee> ?? Enumerable.Empty<Employee>();
}

<style>
    /* ============================================================
   MODULE NHÂN VIÊN — DETAILS PAGE STYLES
   ============================================================ */
    .employee-page {
        padding: 0;
    }

    .employee-page-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 24px;
    }

    .employee-header-left {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .employee-page-title {
        font-size: 22px;
        font-weight: 700;
        color: #0f172a;
        margin: 0;
        letter-spacing: -0.3px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .employee-page-title .employee-icon {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        background: linear-gradient(135deg, #8b5cf6, #6366f1);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 17px;
        flex-shrink: 0;
    }

    .employee-back-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 13.5px;
        font-weight: 600;
        color: #64748b;
        text-decoration: none;
        transition: 0.2s;
    }

    .employee-back-link:hover {
        color: #3b82f6;
    }

    /* --- PROFILE CARD --- */
    .profile-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 1px 6px rgba(0, 0, 0, 0.06);
        border: 1px solid #f1f5f9;
        overflow: hidden;
        max-width: 900px;
        margin: 0 auto;
    }

    .profile-header {
        background: linear-gradient(135deg, #1e293b, #334155);
        color: white;
        padding: 40px 20px 30px;
        text-align: center;
        position: relative;
    }

    .avatar-wrapper {
        width: 100px;
        height: 100px;
        background: white;
        border-radius: 50%;
        margin: 0 auto 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 40px;
        color: #64748b;
        font-weight: 700;
        border: 4px solid rgba(255, 255, 255, 0.15);
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
        overflow: hidden;
    }

    .avatar-wrapper img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .profile-name {
        font-size: 24px;
        font-weight: 800;
        margin-bottom: 8px;
        letter-spacing: -0.5px;
    }

    .profile-badges {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        margin-bottom: 12px;
    }

    .badge-role-main {
        background: rgba(255, 255, 255, 0.15);
        color: #fff;
        padding: 4px 12px;
        border-radius: 20px;
        font-weight: 600;
        font-size: 13px;
        backdrop-filter: blur(4px);
    }

    .badge-code {
        background: #3b82f6;
        color: #fff;
        padding: 4px 12px;
        border-radius: 20px;
        font-weight: 700;
        font-size: 13px;
    }

    .profile-body {
        padding: 32px;
    }

    .section-title {
        font-size: 16px;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 8px;
        padding-bottom: 10px;
        border-bottom: 2px solid #f1f5f9;
    }

    .section-title i {
        color: #6366f1;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
        margin-bottom: 30px;
    }

    .info-item {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .info-label {
        color: #64748b;
        font-size: 12.5px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .info-value {
        color: #0f172a;
        font-weight: 600;
        font-size: 15px;
    }

    .badge-status {
        background: #dcfce7;
        color: #166534;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 13px;
        font-weight: 600;
        display: inline-block;
    }

    .profile-footer {
        padding: 16px 32px;
        border-top: 1px solid #f1f5f9;
        background: #f8fafc;
        display: flex;
        justify-content: flex-end;
        gap: 12px;
    }

    @@media (max-width: 768px) {
        .info-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="employee-page">

    <div class="employee-page-header">
        <div class="employee-header-left">
            <a href="/Employee/Index" class="employee-back-link">
                <i class="fas fa-arrow-left"></i> Quay lại danh sách
            </a>
            <h1 class="employee-page-title">
                <span class="employee-icon"><i class="fas fa-id-card"></i></span>
                Hồ sơ chi tiết
            </h1>
        </div>
        <div class="employee-header-actions">
            <a href="/Employee/Edit/@Model.Id" class="btn btn-outline-primary"
               style="border-radius:10px; font-weight: 600;">
                <i class="fas fa-edit me-1"></i> Chỉnh sửa
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success mb-3"><i class="fas fa-check-circle me-2"></i>@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger mb-3"><i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]</div>
    }

    <div class="profile-card">
        <div class="profile-header">
            <div class="avatar-wrapper">
                @if (!string.IsNullOrEmpty(Model.AvatarPath))
                {
                    <img src="@Model.AvatarPath" alt="Avatar" />
                }
                else
                {
                    <text>@(string.IsNullOrEmpty(Model.Name) ? "?" : Model.Name.Substring(0, 1).ToUpper())</text>
                }
            </div>
            <div class="profile-name">@Model.Name</div>
            <div class="profile-badges">
                <span class="badge-code">Mã NV: @(string.IsNullOrWhiteSpace(Model.EmployeeCode) ? "Chưa được cấp mã" : Model.EmployeeCode)</span>
                <span class="badge-role-main">@Model.JobTitle</span>
            </div>
        </div>

        <div class="profile-body">
            <div class="row">
                <div class="col-md-6 border-end" style="padding-right: 24px;">
                    <h5 class="section-title"><i class="fas fa-user-circle"></i> Thông tin cá nhân</h5>
                    <div class="info-grid">
                        <div class="info-item">
                            <div class="info-label">Số điện thoại</div>
                            <div class="info-value">@(Model.PhoneNumber ?? "---")</div>
                        </div>
                        <div class="info-item">
                            <div class="info-label">Email liên hệ</div>
                            <div class="info-value">@(Model.Email ?? "---")</div>
                        </div>
                        <div class="info-item">
                            <div class="info-label">Giới tính</div>
                            <div class="info-value">@(Model.Gender ?? "---")</div>
                        </div>
                        <div class="info-item">
                            <div class="info-label">Ngày sinh</div>
                            <div class="info-value">@(Model.BirthDate?.ToString("dd/MM/yyyy") ?? "---")</div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6" style="padding-left: 24px;">
                    <h5 class="section-title"><i class="fas fa-briefcase"></i> Thông tin công việc</h5>
                    <div class="info-grid">
                        <div class="info-item">
                            <div class="info-label">Phòng ban</div>
                            <div class="info-value">@(Model.Department ?? "---")</div>
                        </div>
                        <div class="info-item">
                            <div class="info-label">Loại hợp đồng</div>
                            <div class="info-value"><span class="badge-status">@Model.Position</span></div>
                        </div>
                        <div class="info-item">
                            <div class="info-label">Trình độ học vấn</div>
                            <div class="info-value">@(Model.AcademicLevel ?? "---")</div>
                        </div>
                        <div class="info-item">
                            <div class="info-label">Lương cơ bản</div>
                            <div class="info-value" style="color: #2ecc71;">@Model.Salary.ToString("N0") ₫</div>
                        </div>
                        <div class="info-item">
                            <div class="info-label">Quản lý trực tiếp</div>
                            <div class="info-value">
                                @if (Model.Manager != null)
                                {
                                    <span class="text-primary fw-bold">@Model.Manager.Name</span>
                                    <small class="text-muted">(@Model.Manager.EmployeeCode)</small>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Chưa phân công</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TABS CHO CÁC THÔNG TIN LIÊN QUAN -->
            <div class="mt-4 pt-3 border-top">
                <ul class="nav nav-pills mb-3" id="pills-tab" role="tablist">
                  <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="pills-contracts-tab" data-bs-toggle="pill" data-bs-target="#pills-contracts" type="button" role="tab" aria-controls="pills-contracts" aria-selected="true"><i class="fas fa-file-contract"></i> Hợp đồng (@contracts.Count())</button>
                  </li>
                  <li class="nav-item" role="presentation">
                    <button class="nav-link" id="pills-history-tab" data-bs-toggle="pill" data-bs-target="#pills-history" type="button" role="tab" aria-controls="pills-history" aria-selected="false"><i class="fas fa-history"></i> Quá trình công tác</button>
                  </li>
                  <li class="nav-item" role="presentation">
                    <button class="nav-link" id="pills-rewards-tab" data-bs-toggle="pill" data-bs-target="#pills-rewards" type="button" role="tab" aria-controls="pills-rewards" aria-selected="false"><i class="fas fa-award"></i> Khen thưởng (@rewards.Count())</button>
                  </li>
                  <li class="nav-item" role="presentation">
                    <button class="nav-link" id="pills-leaves-tab" data-bs-toggle="pill" data-bs-target="#pills-leaves" type="button" role="tab" aria-controls="pills-leaves" aria-selected="false"><i class="fas fa-umbrella-beach"></i> Nghỉ phép (@leaves.Count())</button>
                  </li>
                  <li class="nav-item" role="presentation">
                    <button class="nav-link" id="pills-reporting-tab" data-bs-toggle="pill" data-bs-target="#pills-reporting" type="button" role="tab" aria-controls="pills-reporting" aria-selected="false"><i class="fas fa-sitemap"></i> Quản lý trực tiếp (@reportingHistories.Count())</button>
                  </li>
                </ul>
                <div class="tab-content" id="pills-tabContent">
                  
                  <!-- TAB HỢP ĐỒNG -->
                  <div class="tab-pane fade show active" id="pills-contracts" role="tabpanel" aria-labelledby="pills-contracts-tab">
                      @if(contracts.Any()) {
                          <table class="table table-sm table-hover align-middle">
                              <thead class="table-light">
                                  <tr>
                                      <th>Số HĐ</th>
                                      <th>Thời hạn</th>
                                      <th>Từ ngày</th>
                                      <th>Đến ngày</th>
                                      <th>Trạng thái</th>
                                  </tr>
                              </thead>
                              <tbody>
                                  @foreach(var c in contracts) {
                                      <tr>
                                          <td><a href="/Contract/Details/@c.Id" class="text-decoration-none fw-bold">HĐ-@c.Id.ToString("D4")</a></td>
                                          <td>@(string.IsNullOrEmpty(c.Duration) ? "Hợp đồng lao động" : c.Duration)</td>
                                          <td>@c.StartDate.ToString("dd/MM/yyyy")</td>
                                          <td>@c.EndDate.ToString("dd/MM/yyyy")</td>
                                          <td>
                                              @if(c.Status == "Active" || c.Status == "Có hiệu lực" || c.Status == "Đã duyệt") { <span class="badge bg-success">@c.Status</span> }
                                              else if(c.Status == "Expired" || c.Status == "Hết hạn") { <span class="badge bg-secondary">@c.Status</span> }
                                              else { <span class="badge bg-warning text-dark">@c.Status</span> }
                                          </td>
                                      </tr>
                                  }
                              </tbody>
                          </table>
                      } else {
                          <p class="text-muted fst-italic">Chưa có hợp đồng nào.</p>
                      }
                  </div>
                  
                  <!-- TAB QUÁ TRÌNH CÔNG TÁC (Bổ nhiệm, Miễn nhiệm, Thuyên chuyển) -->
                  <div class="tab-pane fade" id="pills-history" role="tabpanel" aria-labelledby="pills-history-tab">
                      <ul class="list-group list-group-flush">
                          @if(appointments.Any()) {
                              @foreach(var a in appointments) {
                                  <li class="list-group-item d-flex justify-content-between align-items-center">
                                      <div>
                                          <span class="badge bg-primary me-2">Bổ nhiệm</span>
                                          <strong>@(a.NewJobTitle ?? a.NewPosition ?? "Bổ nhiệm chức vụ")</strong> <span class="text-muted">(@(a.NewDepartment ?? a.PreviousDepartment ?? "Chưa phân bổ"))</span>
                                      </div>
                                      <span class="text-muted small">@a.EffectiveDate.ToString("dd/MM/yyyy")</span>
                                  </li>
                              }
                          }
                          @if(transfers.Any()) {
                              @foreach(var t in transfers) {
                                  <li class="list-group-item d-flex justify-content-between align-items-center">
                                      <div>
                                          <span class="badge bg-info me-2">Thuyên chuyển</span>
                                          <span class="text-muted">Từ</span> @(t.CurrentDepartmentSnapshot ?? "Chưa phân phòng") <i class="fas fa-arrow-right mx-1 text-muted"></i> <strong>@(t.TargetDepartment ?? "Chưa phân phòng")</strong>
                                      </div>
                                      <span class="text-muted small">@t.EffectiveDate.ToString("dd/MM/yyyy")</span>
                                  </li>
                              }
                          }
                          @if(dismissals.Any()) {
                              @foreach(var d in dismissals) {
                                  <li class="list-group-item d-flex justify-content-between align-items-center">
                                      <div>
                                          <span class="badge bg-danger me-2">Miễn nhiệm</span>
                                          Thôi giữ chức <strong>@(d.CurrentJobTitleSnapshot ?? d.CurrentPositionSnapshot ?? "Chức vụ cũ")</strong>
                                      </div>
                                      <span class="text-muted small">@d.EffectiveDate.ToString("dd/MM/yyyy")</span>
                                  </li>
                              }
                          }
                          @if(!appointments.Any() && !transfers.Any() && !dismissals.Any()) {
                              <li class="list-group-item text-muted fst-italic">Không có lịch sử công tác.</li>
                          }
                      </ul>
                  </div>

                  <!-- TAB KHEN THƯỞNG -->
                  <div class="tab-pane fade" id="pills-rewards" role="tabpanel" aria-labelledby="pills-rewards-tab">
                      @if(rewards.Any()) {
                          <table class="table table-sm table-hover">
                              <thead class="table-light">
                                  <tr>
                                      <th>Số QĐ</th>
                                      <th>Hình thức</th>
                                      <th>Nội dung / Lý do</th>
                                      <th>Ngày hiệu lực</th>
                                  </tr>
                              </thead>
                              <tbody>
                                  @foreach(var r in rewards) {
                                      <tr>
                                          <td>@(r.DecisionNumber ?? "—")</td>
                                          <td>@(r.RewardType ?? "Khen thưởng")</td>
                                          <td>@(r.Achievement ?? r.Title ?? r.Description ?? "Khen thưởng")</td>
                                          <td>@(r.EffectiveDate?.ToString("dd/MM/yyyy") ?? r.ProposedDate.ToString("dd/MM/yyyy"))</td>
                                      </tr>
                                  }
                              </tbody>
                          </table>
                      } else {
                          <p class="text-muted fst-italic">Chưa có thông tin khen thưởng.</p>
                      }
                  </div>

                  <!-- TAB NGHỈ PHÉP -->
                  <div class="tab-pane fade" id="pills-leaves" role="tabpanel" aria-labelledby="pills-leaves-tab">
                      @if(leaves.Any()) {
                          <table class="table table-sm table-hover">
                              <thead class="table-light">
                                  <tr>
                                      <th>Từ ngày</th>
                                      <th>Đến ngày</th>
                                      <th>Lý do</th>
                                      <th>Trạng thái</th>
                                  </tr>
                              </thead>
                              <tbody>
                                  @foreach(var l in leaves) {
                                      <tr>
                                          <td>@l.FromDate.ToString("dd/MM/yyyy")</td>
                                          <td>@l.ToDate.ToString("dd/MM/yyyy")</td>
                                          <td>@(l.Reason ?? l.LeaveType ?? "Nghỉ phép")</td>
                                          <td>@l.Status</td>
                                      </tr>
                                  }
                              </tbody>
                          </table>
                      } else {
                          <p class="text-muted fst-italic">Chưa có thông tin nghỉ phép.</p>
                      }
                  </div>

                  <!-- TAB QUẢN LÝ TRỰC TIẾP & LỊCH SỬ BÁO CÁO (OD-07, OD-08, OD-09, OD-11, BD-06) -->
                  <div class="tab-pane fade" id="pills-reporting" role="tabpanel" aria-labelledby="pills-reporting-tab">
                      @if (User.IsInRole("HR") || User.IsInRole("Admin"))
                      {
                          <div class="card mb-4 border-0 shadow-sm" style="background: #f8fafc; border-radius: 12px;">
                              <div class="card-body p-4">
                                  <h6 class="fw-bold mb-3 text-dark"><i class="fas fa-user-edit text-primary me-2"></i>Thay đổi Người quản lý trực tiếp</h6>
                                  <form asp-action="ChangeDirectManager" method="post">
                                      @Html.AntiForgeryToken()
                                      <input type="hidden" name="EmployeeId" value="@Model.Id" />
                                      <input type="hidden" name="RowVersionString" value="@(Model.RowVersion != null ? Convert.ToBase64String(Model.RowVersion) : "")" />

                                      <div class="row g-3">
                                          <div class="col-md-6">
                                              <label class="form-label fw-semibold text-secondary">Người quản lý trực tiếp mới</label>
                                              <select name="NewManagerId" id="newManagerSelect" class="form-select">
                                                  <option value="">-- Chọn người quản lý --</option>
                                                  @if (eligibleManagers.Any())
                                                  {
                                                      foreach (var m in eligibleManagers)
                                                      {
                                                          <!option value="@m.Id" @(Model.ManagerId == m.Id ? "selected" : "")>@m.Name (@m.EmployeeCode) - @(m.Department ?? "Chưa xếp phòng")</!option>
                                                      }
                                                  }
                                              </select>
                                          </div>
                                          <div class="col-md-6">
                                              <label class="form-label fw-semibold text-secondary">Lý do thay đổi</label>
                                              <input type="text" name="Reason" class="form-control" placeholder="Nhập lý do thay đổi quan hệ quản lý..." required />
                                          </div>
                                          <div class="col-12">
                                              <div class="form-check">
                                                  <input class="form-check-input" type="checkbox" name="AllowNullManagerException" value="true" id="allowNullExceptionCheck" onchange="toggleNullReason(this)">
                                                  <label class="form-check-label text-secondary fw-semibold" for="allowNullExceptionCheck">
                                                      Phê duyệt ngoại lệ không có người quản lý trực tiếp (OD-11)
                                                  </label>
                                              </div>
                                          </div>
                                          <div class="col-md-12 d-none" id="nullReasonGroup">
                                              <label class="form-label fw-semibold text-danger">Lý do phê duyệt ngoại lệ NULL *</label>
                                              <input type="text" name="NullManagerReason" id="nullReasonInput" class="form-control" placeholder="Ví dụ: Lãnh đạo cao nhất hoặc quyết định phê duyệt đặc biệt của CEO..." />
                                          </div>
                                          <div class="col-12 text-end">
                                              <button type="submit" class="btn btn-primary px-4" style="border-radius: 8px;">
                                                  <i class="fas fa-save me-1"></i> Lưu thay đổi
                                              </button>
                                          </div>
                                      </div>
                                  </form>
                              </div>
                          </div>
                      }

                      <h6 class="fw-bold mb-3 text-secondary"><i class="fas fa-history me-2"></i>Lịch sử quan hệ quản lý trực tiếp (Append-Only)</h6>
                      @if (reportingHistories.Any())
                      {
                          <table class="table table-sm table-hover align-middle">
                              <thead class="table-light">
                                  <tr>
                                      <th>Ngày hiệu lực</th>
                                      <th>Quản lý trước</th>
                                      <th>Quản lý mới</th>
                                      <th>Lý do</th>
                                      <th>Người thực hiện</th>
                                  </tr>
                              </thead>
                              <tbody>
                                  @foreach (var h in reportingHistories)
                                  {
                                      <tr>
                                          <td>@h.EffectiveDate.ToString("dd/MM/yyyy HH:mm")</td>
                                          <td>@(h.PreviousManager != null ? $"{h.PreviousManager.Name} ({h.PreviousManager.EmployeeCode})" : "---")</td>
                                          <td>@(h.NewManager != null ? $"{h.NewManager.Name} ({h.NewManager.EmployeeCode})" : "<span class='text-muted fst-italic'>Không có (NULL)</span>")</td>
                                          <td>@h.ChangeReason</td>
                                          <td>@(h.ChangedByUser?.FullName ?? h.ChangedByUser?.Username ?? "Hệ thống")</td>
                                      </tr>
                                  }
                              </tbody>
                          </table>
                      }
                      else
                      {
                          <p class="text-muted fst-italic">Chưa có bản ghi lịch sử quản lý trực tiếp nào.</p>
                      }
                  </div>
                </div>
            </div>
        </div>

<script>
    function toggleNullReason(checkbox) {
        var group = document.getElementById('nullReasonGroup');
        var select = document.getElementById('newManagerSelect');
        if (checkbox.checked) {
            group.classList.remove('d-none');
            select.value = '';
        } else {
            group.classList.add('d-none');
        }
    }

    document.addEventListener('DOMContentLoaded', function() {
        var urlParams = new URLSearchParams(window.location.search);
        var tab = urlParams.get('tab');
        if (tab === 'reporting' || window.location.hash === '#pills-reporting') {
            var tabBtn = document.getElementById('pills-reporting-tab');
            if (tabBtn) {
                if (window.bootstrap && window.bootstrap.Tab) {
                    new bootstrap.Tab(tabBtn).show();
                } else {
                    tabBtn.click();
                }
            }
        }
    });
</script>

        @{ var managerScope = ViewBag.ManagerScope as giao_dien_demo.Models.ManagerAssignmentDetailsViewModel; }
        @if (managerScope?.IsManager == true)
        {
            <div class="p-4 border-top" id="manager-scope-card">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                    <div>
                        <h5 class="section-title mb-1"><i class="fas fa-sitemap"></i> Phạm vi quản lý</h5>
                        <div class="text-muted small">Phạm vi dữ liệu được cấp cho tài khoản Manager của nhân viên này.</div>
                    </div>
                    <button type="button" class="btn btn-primary" onclick="openManagerScopeForm('create')" style="border-radius:10px; font-weight:600;">
                        <i class="fas fa-plus me-1"></i> Phân công đơn vị
                    </button>
                </div>

                @if (managerScope.Assignments.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light"><tr><th>Đơn vị</th><th>Hiệu lực từ</th><th>Hiệu lực đến</th><th>Trạng thái</th><th>Người phân công</th><th class="text-end">Thao tác</th></tr></thead>
                            <tbody>
                            @foreach (var assignment in managerScope.Assignments)
                            {
                                var badgeClass = assignment.Status == "Đang hiệu lực" ? "bg-success" : assignment.Status == "Sắp hiệu lực" ? "bg-warning text-dark" : "bg-secondary";
                                <tr>
                                    <td class="fw-semibold">@assignment.OrganizationalUnit</td>
                                    <td>@assignment.EffectiveFrom.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@(assignment.EffectiveTo?.ToString("dd/MM/yyyy HH:mm") ?? "Không thời hạn")</td>
                                    <td><span class="badge @badgeClass">@assignment.Status</span></td>
                                    <td>@(string.IsNullOrWhiteSpace(assignment.AssignedBy) ? "---" : assignment.AssignedBy)</td>
                                    <td class="text-end">
                                        @if (assignment.CanEdit)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-primary me-1" onclick="openManagerScopeForm('edit', @assignment.Id, '@assignment.OrganizationalUnit.Replace("'", "\\'")', '@assignment.EffectiveFrom.ToString("yyyy-MM-ddTHH:mm")', '@(assignment.EffectiveTo?.ToString("yyyy-MM-ddTHH:mm") ?? "")')"><i class="fas fa-edit"></i></button>
                                        }
                                        @if (assignment.CanEnd)
                                        {
                                            <form method="post" action="/Employee/EndManagerAssignment" class="d-inline" onsubmit="return confirm('Kết thúc phạm vi quản lý này? Lịch sử sẽ được giữ nguyên.');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="employeeId" value="@Model.Id" />
                                                <input type="hidden" name="assignmentId" value="@assignment.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fas fa-stop-circle"></i></button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-info mb-0 d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <span><i class="fas fa-info-circle me-2"></i>Manager chưa được phân công phạm vi quản lý.</span>
                        <button type="button" class="btn btn-sm btn-primary" onclick="openManagerScopeForm('create')">Phân công đơn vị</button>
                    </div>
                }
            </div>

            <div class="modal fade" id="managerScopeModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
                    <form id="managerScopeForm" method="post" action="/Employee/CreateManagerAssignment" onsubmit="this.querySelector('button[type=submit]').disabled=true;">
                        @Html.AntiForgeryToken()
                        <div class="modal-header"><h5 class="modal-title" id="managerScopeModalTitle">Phân công phạm vi quản lý</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div>
                        <div class="modal-body">
                            <input type="hidden" name="EmployeeId" value="@Model.Id" />
                            <input type="hidden" name="AssignmentId" id="managerAssignmentId" />
                            <div class="mb-3"><label class="form-label">Đơn vị quản lý <span class="text-danger">*</span></label><select class="form-select" name="OrganizationalUnit" id="managerAssignmentUnit" required><option value="">Chọn đơn vị</option>@foreach (var unit in managerScope.AvailableUnits) { <option value="@unit">@unit</option> }</select></div>
                            <div class="row g-3"><div class="col-md-6"><label class="form-label">Hiệu lực từ <span class="text-danger">*</span></label><input class="form-control" type="datetime-local" name="EffectiveFrom" id="managerAssignmentFrom" required /></div><div class="col-md-6"><label class="form-label">Hiệu lực đến</label><input class="form-control" type="datetime-local" name="EffectiveTo" id="managerAssignmentTo" /></div></div>
                        </div>
                        <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button><button type="submit" class="btn btn-primary">Lưu phân công</button></div>
                    </form>
                </div></div>
            </div>
            <script>
                function openManagerScopeForm(mode, id, unit, from, to) {
                    const form = document.getElementById('managerScopeForm');
                    const isEdit = mode === 'edit';
                    form.action = isEdit ? '/Employee/UpdateManagerAssignment' : '/Employee/CreateManagerAssignment';
                    document.getElementById('managerScopeModalTitle').textContent = isEdit ? 'Cập nhật phạm vi quản lý' : 'Phân công phạm vi quản lý';
                    document.getElementById('managerAssignmentId').value = isEdit ? id : '';
                    document.getElementById('managerAssignmentUnit').value = isEdit ? unit : '';
                    document.getElementById('managerAssignmentFrom').value = isEdit ? from : '@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")';
                    document.getElementById('managerAssignmentTo').value = isEdit ? to : '';
                    bootstrap.Modal.getOrCreateInstance(document.getElementById('managerScopeModal')).show();
                }
            </script>
        }

        <div class="profile-footer">
            <button onclick="window.print()" class="btn btn-outline-secondary"
                    style="border-radius:10px; font-weight: 500;">
                <i class="fas fa-print me-1"></i> In hồ sơ
            </button>
        </div>
    </div>
</div>
