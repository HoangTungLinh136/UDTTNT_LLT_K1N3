@model Tuple<giao_dien_demo.Models.PayrollValidationSummaryDto, List<giao_dien_demo.Models.PayrollValidationIssueDto>>
@{
    ViewData["Title"] = "Kiểm tra dữ liệu lương";
    var summary = Model.Item1;
    var issues = Model.Item2;
    var currentFilterPeriod = ViewBag.FilterPeriod;
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="mb-1 fw-bold text-dark">Kiểm tra dữ liệu lương</h3>
        <p class="text-muted mb-0">Kiểm tra lỗi và cảnh báo trước khi chạy tính lương.</p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-secondary" onclick="window.location.reload();">
            <i class="fas fa-sync-alt me-2"></i>Kiểm tra lại dữ liệu
        </button>
        <form method="post" action="/PayrollValidation/RunPayroll">
            <input type="hidden" name="period" value="@ViewBag.FilterPeriod" />
            <button type="submit" class="btn @(summary.IsReadyForPayroll ? "btn-success" : "btn-secondary disabled")" @(summary.IsReadyForPayroll ? "" : "disabled")>
                <i class="fas fa-play me-2"></i>Chạy tính lương
            </button>
        </form>
    </div>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
            <div class="card-body p-3 d-flex align-items-center">
                <div class="rounded-circle @(summary.IsReadyForPayroll ? "bg-success" : "bg-secondary") bg-opacity-10 p-3 me-3 @(summary.IsReadyForPayroll ? "text-success" : "text-secondary")">
                    <i class="fas fa-check-circle fs-4"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1 text-uppercase fw-semibold" style="font-size:0.75rem">Sẵn sàng tính lương</h6>
                    <h4 class="mb-0 fw-bold @(summary.IsReadyForPayroll ? "text-success" : "text-secondary")">
                        @(summary.IsReadyForPayroll ? "Sẵn sàng" : "Chưa sẵn sàng")
                    </h4>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
            <div class="card-body p-3 d-flex align-items-center">
                <div class="rounded-circle bg-danger bg-opacity-10 p-3 me-3 text-danger">
                    <i class="fas fa-times-circle fs-4"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1 text-uppercase fw-semibold" style="font-size:0.75rem">Lỗi (Blocking)</h6>
                    <h4 class="mb-0 fw-bold text-dark">@summary.ErrorCount</h4>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
            <div class="card-body p-3 d-flex align-items-center">
                <div class="rounded-circle bg-warning bg-opacity-10 p-3 me-3 text-warning">
                    <i class="fas fa-exclamation-triangle fs-4"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1 text-uppercase fw-semibold" style="font-size:0.75rem">Cảnh báo</h6>
                    <h4 class="mb-0 fw-bold text-dark">@summary.WarningCount</h4>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
            <div class="card-body p-3 d-flex align-items-center">
                <div class="rounded-circle bg-primary bg-opacity-10 p-3 me-3 text-primary">
                    <i class="fas fa-list-ul fs-4"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1 text-uppercase fw-semibold" style="font-size:0.75rem">Tổng vấn đề</h6>
                    <h4 class="mb-0 fw-bold text-dark">@summary.TotalIssues</h4>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Main Content Area -->
<div class="card border-0 shadow-sm rounded-4">
    <div class="card-header bg-white border-bottom pt-3 pb-0 px-4">
        <ul class="nav nav-underline gap-4">
            <li class="nav-item">
                <a class="nav-link @(string.IsNullOrEmpty(ViewBag.FilterSeverity) ? "active fw-bold text-primary" : "text-muted")" href="/PayrollValidation/Index?period=@currentFilterPeriod&source=@ViewBag.FilterSource&employee=@ViewBag.FilterEmployee">Tất cả</a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewBag.FilterSeverity == "ERROR" ? "active fw-bold text-danger" : "text-muted")" href="/PayrollValidation/Index?period=@currentFilterPeriod&severity=ERROR&source=@ViewBag.FilterSource&employee=@ViewBag.FilterEmployee">Lỗi (@summary.ErrorCount)</a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewBag.FilterSeverity == "WARNING" ? "active fw-bold text-warning" : "text-muted")" href="/PayrollValidation/Index?period=@currentFilterPeriod&severity=WARNING&source=@ViewBag.FilterSource&employee=@ViewBag.FilterEmployee">Cảnh báo (@summary.WarningCount)</a>
            </li>
        </ul>
    </div>
    
    <div class="card-body p-4">
        <!-- Filters -->
        <form method="get" action="/PayrollValidation/Index" class="row g-2 align-items-center mb-4">
            <input type="hidden" name="severity" value="@ViewBag.FilterSeverity" />
            
            <div class="col-md-2">
                <select name="period" class="form-select bg-light">
                    @for (int i = 0; i < 5; i++)
                    {
                        var periodVal = DateTime.Now.AddMonths(-i).ToString("MM/yyyy");
                        <!option value="@periodVal" @(currentFilterPeriod == periodVal ? "selected" : "")>Kỳ @periodVal</!option>
                    }
                </select>
            </div>
            
            <div class="col-md-3">
                <select name="source" class="form-select bg-light">
                    <option value="">-- Nguồn dữ liệu --</option>
                    @if (ViewBag.Sources != null)
                    {
                        foreach (var src in ViewBag.Sources)
                        {
                            <!option value="@src" @(ViewBag.FilterSource == src ? "selected" : "")>@src</!option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-3">
                <input type="text" name="employee" class="form-control bg-light" placeholder="Mã hoặc tên nhân viên..." value="@ViewBag.FilterEmployee">
            </div>

            <div class="col-md-auto ms-auto">
                <button type="submit" class="btn btn-primary px-4 rounded-3">Lọc</button>
                <a href="/PayrollValidation/Index" class="btn btn-light px-4 rounded-3 ms-2">Đặt lại</a>
            </div>
        </form>

        <!-- Table -->
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-3 py-3 text-muted fw-semibold">Mức độ</th>
                        <th class="py-3 text-muted fw-semibold">Nhân viên</th>
                        <th class="py-3 text-muted fw-semibold">Vấn đề</th>
                        <th class="py-3 text-muted fw-semibold">Nguồn</th>
                        <th class="py-3 text-muted fw-semibold">Thành phần</th>
                        <th class="pe-3 py-3 text-center text-muted fw-semibold">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @if (issues.Any())
                    {
                        foreach (var issue in issues)
                        {
                            <tr class="border-bottom">
                                <td class="ps-3">
                                    @if (issue.Severity == "ERROR")
                                    {
                                        <span class="badge bg-danger text-white px-2 py-1"><i class="fas fa-times-circle me-1"></i>Lỗi</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark px-2 py-1"><i class="fas fa-exclamation-triangle me-1"></i>Cảnh báo</span>
                                    }
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@issue.EmployeeName</div>
                                    <div class="text-muted small">@issue.EmployeeCode</div>
                                </td>
                                <td>
                                    <span class="text-dark">@issue.Message</span>
                                </td>
                                <td><span class="text-muted">@issue.SourceModule</span></td>
                                <td><span class="text-muted">@issue.Component</span></td>
                                <td class="pe-3 text-center">
                                    <button class="btn btn-sm btn-light text-primary rounded-circle"
                                            title="Xem chi tiết kiểm tra"
                                            onclick="openDetailDrawer('@issue.Id', '@issue.Severity', '@issue.Message', '@issue.EmployeeName', '@issue.EmployeeCode', '@issue.SourceModule', '@issue.Component', '@issue.CurrentValue', '@issue.ExpectedValue', '@issue.ResolutionHint', '@issue.TargetUrl')">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                @if (summary.TotalIssues == 0)
                                {
                                    <div class="text-success mb-2"><i class="fas fa-check-circle fs-1"></i></div>
                                    <h6 class="fw-bold mb-1">Dữ liệu đã sẵn sàng.</h6>
                                    <p class="text-muted mb-0 small">Không phát hiện lỗi hoặc cảnh báo trong kỳ lương này.</p>
                                }
                                else
                                {
                                    <div class="text-muted mb-2"><i class="fas fa-inbox fs-2"></i></div>
                                    <h6 class="fw-bold mb-1">Không có dữ liệu.</h6>
                                    <p class="text-muted mb-0 small">Chưa có vấn đề nào phù hợp với bộ lọc đã chọn.</p>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Offcanvas Detail Panel -->
<div class="offcanvas offcanvas-end shadow" tabindex="-1" id="validationDetailDrawer" style="width: 450px;">
    <div class="offcanvas-header border-bottom bg-light">
        <h5 class="offcanvas-title fw-bold">Chi tiết kiểm tra</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body p-0 d-flex flex-column h-100">
        
        <div id="valDetailEmpty" class="text-center py-5">
            <div class="text-muted mb-2"><i class="fas fa-hand-pointer fs-2"></i></div>
            <p class="text-muted">Chọn một vấn đề để xem chi tiết.</p>
        </div>

        <div id="valDetailContent" class="d-none d-flex flex-column h-100">
            <div class="p-4 flex-grow-1 overflow-auto">
                <!-- Thông tin lỗi -->
                <div class="mb-4">
                    <div id="detailSeverityBadge" class="badge mb-2 px-2 py-1 fs-6"></div>
                    <h5 class="fw-bold text-dark mb-1" id="detailMessage">Message here</h5>
                    
                    <div class="d-flex align-items-center mt-3 p-3 bg-light rounded-3 border">
                        <div class="rounded-circle bg-primary bg-opacity-10 p-2 me-3 text-primary">
                            <i class="fas fa-user"></i>
                        </div>
                        <div>
                            <div class="fw-bold text-dark" id="detailEmpName">Emp Name</div>
                            <div class="text-muted small" id="detailEmpCode">Emp Code</div>
                        </div>
                    </div>
                </div>

                <!-- Nguồn dữ liệu & Thành phần -->
                <div class="mb-4">
                    <h6 class="fw-bold text-muted text-uppercase" style="font-size:0.8rem">Nguồn dữ liệu & Thành phần</h6>
                    <ul class="list-group list-group-flush border-top border-bottom">
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                            <span class="text-muted">Nguồn</span>
                            <span class="fw-bold text-dark" id="detailSource">Hồ sơ</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                            <span class="text-muted">Thành phần liên quan</span>
                            <span class="fw-bold text-dark" id="detailComponent">Lương</span>
                        </li>
                    </ul>
                </div>

                <!-- So sánh Giá trị -->
                <div class="mb-4">
                    <h6 class="fw-bold text-muted text-uppercase" style="font-size:0.8rem">Kiểm tra giá trị</h6>
                    <div class="row g-2">
                        <div class="col-6">
                            <div class="p-3 bg-light rounded-3 border h-100">
                                <span class="d-block text-muted small mb-1">Hiện tại</span>
                                <span class="fw-bold text-danger" id="detailCurrentValue">0</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-3 bg-success bg-opacity-10 rounded-3 border border-success border-opacity-25 h-100">
                                <span class="d-block text-success small mb-1">Mong đợi</span>
                                <span class="fw-bold text-success" id="detailExpectedValue">> 0</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Hướng xử lý -->
                <div class="mb-4">
                    <h6 class="fw-bold text-muted text-uppercase" style="font-size:0.8rem">Hướng xử lý</h6>
                    <div class="p-3 bg-primary bg-opacity-10 rounded-3 border border-primary border-opacity-25 text-primary">
                        <i class="fas fa-info-circle me-2"></i><span id="detailResolution">Hint here</span>
                    </div>
                </div>
            </div>

            <!-- Action Bar Bottom -->
            <div class="p-3 border-top bg-white mt-auto">
                <a href="#" id="btnGoToSource" class="btn btn-primary w-100 py-2 rounded-3 fw-semibold">
                    <i class="fas fa-external-link-alt me-2"></i>Đi tới hồ sơ
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openDetailDrawer(id, severity, message, empName, empCode, source, component, currentValue, expectedValue, resolution, targetUrl) {
            // Hide empty, show content
            document.getElementById('valDetailEmpty').classList.add('d-none');
            document.getElementById('valDetailContent').classList.remove('d-none');

            // Populate badge
            let badgeEl = document.getElementById('detailSeverityBadge');
            if (severity === 'ERROR') {
                badgeEl.className = 'badge bg-danger text-white mb-2 px-2 py-1 fs-6';
                badgeEl.innerHTML = '<i class="fas fa-times-circle me-1"></i>Lỗi (Blocking)';
            } else {
                badgeEl.className = 'badge bg-warning text-dark mb-2 px-2 py-1 fs-6';
                badgeEl.innerHTML = '<i class="fas fa-exclamation-triangle me-1"></i>Cảnh báo';
            }

            document.getElementById('detailMessage').innerText = message;
            document.getElementById('detailEmpName').innerText = empName || "N/A";
            document.getElementById('detailEmpCode').innerText = empCode || "N/A";
            
            document.getElementById('detailSource').innerText = source;
            document.getElementById('detailComponent').innerText = component;
            
            document.getElementById('detailCurrentValue').innerText = currentValue || "Trống";
            document.getElementById('detailExpectedValue').innerText = expectedValue || "N/A";
            
            document.getElementById('detailResolution').innerText = resolution;
            document.getElementById('btnGoToSource').href = targetUrl;

            // Show drawer
            var myOffcanvas = new bootstrap.Offcanvas(document.getElementById('validationDetailDrawer'));
            myOffcanvas.show();
        }
    </script>
}
