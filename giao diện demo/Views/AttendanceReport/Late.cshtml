@model giao_dien_demo.Models.LateReportViewModel
@{
    ViewData["Title"] = "Báo cáo đi muộn";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="mb-1 fw-bold text-dark">Báo cáo đi muộn</h3>
        <p class="text-muted mb-0">Thống kê tình hình đi muộn tháng @Model.CurrentMonth</p>
    </div>
</div>

<!-- Thống kê tổng quan -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-1">Số lượt đi muộn</p>
                        <h4 class="fw-bold mb-0 text-danger">@Model.TotalLateOccurrences</h4>
                    </div>
                    <div class="bg-danger bg-opacity-10 p-3 rounded-3 text-danger">
                        <i class="fa-solid fa-clock-rotate-left"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-1">Tổng thời gian (phút)</p>
                        <h4 class="fw-bold mb-0 text-warning">@Model.TotalLateMinutes</h4>
                    </div>
                    <div class="bg-warning bg-opacity-10 p-3 rounded-3 text-warning">
                        <i class="fa-solid fa-stopwatch"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-1">Số nhân viên vi phạm</p>
                        <h4 class="fw-bold mb-0 text-info">@Model.TotalEmployeesWithLate</h4>
                    </div>
                    <div class="bg-info bg-opacity-10 p-3 rounded-3 text-info">
                        <i class="fa-solid fa-users"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-1">Phòng ban vi phạm nhiều nhất</p>
                        <h5 class="fw-bold mb-0 text-primary mt-1">@Model.HighestRateDepartment</h5>
                    </div>
                    <div class="bg-primary bg-opacity-10 p-3 rounded-3 text-primary">
                        <i class="fa-solid fa-building"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bảng chi tiết -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-4">
        <h5 class="fw-bold mb-3">Danh sách nhân viên đi muộn</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Mã NV</th>
                        <th>Họ tên</th>
                        <th>Phòng ban</th>
                        <th class="text-center">Số lượt</th>
                        <th class="text-center">Tổng thời gian</th>
                        <th class="text-center">Trung bình (phút/lượt)</th>
                        <th>Lần gần nhất</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.EmployeeSummaries.Any())
                    {
                        foreach (var emp in Model.EmployeeSummaries)
                        {
                            <tr>
                                <td><span class="badge bg-secondary">@emp.EmployeeCode</span></td>
                                <td class="fw-medium">@emp.EmployeeName</td>
                                <td>@emp.DepartmentName</td>
                                <td class="text-center text-danger fw-bold">@emp.LateCount</td>
                                <td class="text-center">@emp.TotalLateMinutes phút</td>
                                <td class="text-center">@Math.Round(emp.AverageLateMinutes, 1)</td>
                                <td>@(emp.LatestLateDate.HasValue ? emp.LatestLateDate.Value.ToString("dd/MM/yyyy HH:mm") : "-")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">Không có dữ liệu đi muộn trong tháng này.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
