@{ ViewData["Title"] = "Đào tạo"; }
<style>.hrms-status-badge{display:inline-flex;align-items:center;padding:3px 10px;border-radius:999px;font-size:12px;font-weight:600}.status-approved{background:#ecfdf5;color:#047857}.status-pending{background:#fffbeb;color:#92400e}.status-rejected{background:#fef2f2;color:#b91c1c}.status-info{background:#eff6ff;color:#1d4ed8}.hrms-progress-track{height:7px;width:90px;background:#e2e8f0;border-radius:99px;overflow:hidden;display:inline-block;vertical-align:middle}.hrms-progress-fill{height:100%;background:#3b82f6;border-radius:99px}</style>
<div class="hrms-page-header"><div class="hrms-page-header-main"><h1 class="hrms-page-title"><span class="hrms-page-icon blue"><i class="fa-solid fa-graduation-cap"></i></span>Đào tạo</h1><p class="hrms-page-subtitle">Quản lý đăng ký và quá trình đào tạo của nhân viên.</p></div></div>
<div class="hrms-kpi-grid hrms-kpi-grid-4"><div class="hrms-kpi-card kpi-blue"><div class="hrms-kpi-top"><div class="hrms-kpi-icon"><i class="fa-solid fa-list-check"></i></div></div><div class="hrms-kpi-body"><div class="hrms-kpi-label">Tổng đăng ký</div><div class="hrms-kpi-value kpi-blue" id="training-total">0</div></div></div><div class="hrms-kpi-card kpi-yellow"><div class="hrms-kpi-top"><div class="hrms-kpi-icon"><i class="fa-solid fa-clock"></i></div></div><div class="hrms-kpi-body"><div class="hrms-kpi-label">Chờ xử lý</div><div class="hrms-kpi-value kpi-yellow" id="training-pending">0</div></div></div><div class="hrms-kpi-card kpi-cyan"><div class="hrms-kpi-top"><div class="hrms-kpi-icon"><i class="fa-solid fa-book-open"></i></div></div><div class="hrms-kpi-body"><div class="hrms-kpi-label">Đang học</div><div class="hrms-kpi-value kpi-cyan" id="training-active">0</div></div></div><div class="hrms-kpi-card kpi-green"><div class="hrms-kpi-top"><div class="hrms-kpi-icon"><i class="fa-solid fa-certificate"></i></div></div><div class="hrms-kpi-body"><div class="hrms-kpi-label">Hoàn thành</div><div class="hrms-kpi-value kpi-green" id="training-done">0</div></div></div></div>
<form id="training-filter" class="hrms-filter-bar" onsubmit="loadTraining(event)"><div class="hrms-search-wrap"><i class="fa-solid fa-search search-icon"></i><input id="training-search" name="search" class="hrms-search-input" placeholder="Tìm mã/tên nhân viên hoặc khóa học" /></div><select id="training-status" name="status" class="hrms-filter-select"><option value="">Tất cả trạng thái</option><option value="PendingApproval">Chờ xử lý</option><option value="Enrolled">Đã đăng ký</option><option value="InProgress">Đang học</option><option value="Completed">Hoàn thành</option><option value="Nominated">Được đề cử</option></select><button type="submit" class="hrms-btn hrms-btn-primary"><i class="fa-solid fa-filter"></i> Lọc</button><button type="button" class="hrms-btn hrms-btn-secondary" onclick="resetTraining()"><i class="fa-solid fa-rotate-left"></i> Đặt lại</button></form>
<section class="hrms-card"><div class="hrms-card-header"><h2 class="hrms-card-title"><i class="fa-solid fa-table-list card-title-icon"></i>Danh sách đăng ký <span class="notification-badge" id="training-count">0</span></h2></div><div class="hrms-card-body p-0"><div class="hrms-table-wrap"><table class="hrms-table"><thead><tr><th>Nhân viên</th><th>Khóa học</th><th>Ngày đăng ký</th><th>Trạng thái</th><th>Tiến độ</th><th>Chứng chỉ</th><th>Thao tác</th></tr></thead><tbody id="training-rows"></tbody></table></div></div></section>
<form id="training-csrf">@Html.AntiForgeryToken()</form>
<script>
const trainingToken=()=>document.querySelector('#training-csrf input[name="__RequestVerificationToken"]').value;const escTraining=value=>String(value??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
function loadTraining(event){if(event)event.preventDefault();const q=new URLSearchParams({search:document.getElementById('training-search').value,status:document.getElementById('training-status').value});fetch('/Training/GetHrEnrollments?'+q).then(r=>r.ok?r.json():[]).then(items=>{trainingTotal.textContent=items.length;trainingPending.textContent=items.filter(x=>x.status==='PendingApproval').length;trainingActive.textContent=items.filter(x=>['Enrolled','InProgress'].includes(x.status)).length;trainingDone.textContent=items.filter(x=>x.status==='Completed').length;document.getElementById('training-count').textContent=items.length;document.getElementById('training-rows').innerHTML=items.length?items.map(x=>{const p=Math.min(100,Math.max(0,Number(x.progressPercent)||0));const badge=x.status==='Completed'?'status-approved':x.status==='Rejected'?'status-rejected':x.status==='PendingApproval'?'status-pending':'status-info';return `<tr><td>${escTraining(x.employee)}</td><td>${escTraining(x.course)}</td><td>${new Date(x.registrationDate).toLocaleDateString('vi-VN')}</td><td><span class="hrms-status-badge ${badge}">${escTraining(x.status)}</span></td><td><span class="hrms-progress-track"><span class="hrms-progress-fill" style="width:${p}%"></span></span> <small>${p}%</small></td><td>${x.certificate?'<span class="text-success"><i class="fa-solid fa-certificate"></i> Đã cấp</span>':'—'}</td><td>${x.status==='PendingApproval'?`<button type="button" class="hrms-btn hrms-btn-sm hrms-btn-success" onclick="decideTraining('/Training/ApproveEnrollment',${x.id})">Duyệt</button> <button type="button" class="hrms-btn hrms-btn-sm hrms-btn-danger" onclick="decideTraining('/Training/RejectEnrollment',${x.id})">Từ chối</button>`:'—'}</td></tr>`;}).join(''):'<tr><td colspan="7"><div class="hrms-empty-state"><div class="hrms-empty-icon"><i class="fa-solid fa-graduation-cap"></i></div><h3 class="hrms-empty-title">Không có đăng ký đào tạo</h3><p class="hrms-empty-desc">Không có hồ sơ phù hợp với bộ lọc hiện tại.</p></div></td></tr>';});}
function resetTraining(){document.getElementById('training-filter').reset();loadTraining();}function decideTraining(url,id){fetch(url,{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded','RequestVerificationToken':trainingToken()},body:new URLSearchParams({id})}).then(()=>loadTraining());}const trainingTotal=document.getElementById('training-total'),trainingPending=document.getElementById('training-pending'),trainingActive=document.getElementById('training-active'),trainingDone=document.getElementById('training-done');loadTraining();
</script>
