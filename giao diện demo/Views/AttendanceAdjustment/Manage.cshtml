@model IEnumerable<giao_dien_demo.Models.AttendanceAdjustmentRequest>
@{
    ViewData["Title"] = "Xác nhận công";
    var role = Context.Session.GetString("Role");
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="mb-1 fw-bold text-dark">Xác nhận công</h3>
        <p class="text-muted mb-0">Xem xét và xử lý các yêu cầu xác nhận sai lệch hoặc bất thường chấm công.</p>
    </div>
    <div>
        <a href="/AttendanceAdjustment/ExportExcel" class="btn btn-outline-success">
            <i class="fas fa-file-excel me-2"></i>Xuất Excel
        </a>
    </div>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
            <div class="card-body p-3 d-flex align-items-center">
                <div class="rounded-circle bg-warning bg-opacity-10 p-3 me-3 text-warning">
                    <i class="fas fa-clock fs-4"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1 text-uppercase fw-semibold" style="font-size:0.8rem">Chờ xử lý</h6>
                    <h3 class="mb-0 fw-bold text-dark">@ViewBag.TotalPending</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
            <div class="card-body p-3 d-flex align-items-center">
                <div class="rounded-circle bg-success bg-opacity-10 p-3 me-3 text-success">
                    <i class="fas fa-check-circle fs-4"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1 text-uppercase fw-semibold" style="font-size:0.8rem">Đã xác nhận</h6>
                    <h3 class="mb-0 fw-bold text-dark">@ViewBag.TotalApproved</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
            <div class="card-body p-3 d-flex align-items-center">
                <div class="rounded-circle bg-danger bg-opacity-10 p-3 me-3 text-danger">
                    <i class="fas fa-times-circle fs-4"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1 text-uppercase fw-semibold" style="font-size:0.8rem">Từ chối</h6>
                    <h3 class="mb-0 fw-bold text-dark">@ViewBag.TotalRejected</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
            <div class="card-body p-3 d-flex align-items-center">
                <div class="rounded-circle bg-info bg-opacity-10 p-3 me-3 text-info">
                    <i class="fas fa-exclamation-circle fs-4"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1 text-uppercase fw-semibold" style="font-size:0.8rem">Cần bổ sung</h6>
                    <h3 class="mb-0 fw-bold text-dark">@ViewBag.TotalRevision</h3>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" action="/AttendanceAdjustment/Manage" class="row g-2 align-items-center">
            <div class="col-md-3">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="fas fa-search text-muted"></i></span>
                    <input type="text" name="employee" class="form-control border-start-0 bg-light" placeholder="Tìm mã nhân viên..." value="@Context.Request.Query["employee"]">
                </div>
            </div>
            <div class="col-md-2">
                <select name="status" class="form-select bg-light text-muted">
                    <option value="">-- Trạng thái --</option>
                    <!option value="PENDING" @(Context.Request.Query["status"] == "PENDING" ? "selected" : "")>Chờ xử lý</!option>
                    <!option value="APPROVED" @(Context.Request.Query["status"] == "APPROVED" ? "selected" : "")>Đã xác nhận</!option>
                    <!option value="REJECTED" @(Context.Request.Query["status"] == "REJECTED" ? "selected" : "")>Từ chối</!option>
                    <!option value="NEEDS_REVISION" @(Context.Request.Query["status"] == "NEEDS_REVISION" ? "selected" : "")>Cần bổ sung</!option>
                </select>
            </div>
            <div class="col-md-2">
                <input type="text" name="handler" class="form-control bg-light" placeholder="Người xử lý..." value="@Context.Request.Query["handler"]">
            </div>
            <div class="col-md-auto ms-auto">
                <button type="submit" class="btn btn-primary px-4 rounded-3">Lọc</button>
                <a href="/AttendanceAdjustment/Manage" class="btn btn-light px-4 rounded-3 ms-2">Đặt lại</a>
            </div>
        </form>
    </div>
</div>

<!-- Data Table -->
<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size:0.95rem">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4 py-3 text-muted fw-semibold">Mã NV</th>
                        <th class="py-3 text-muted fw-semibold">Yêu cầu gốc (#ID)</th>
                        <th class="py-3 text-muted fw-semibold">Dữ liệu đề nghị</th>
                        <th class="py-3 text-muted fw-semibold">Người xử lý</th>
                        <th class="py-3 text-muted fw-semibold">Thời gian tạo</th>
                        <th class="py-3 text-muted fw-semibold">Trạng thái</th>
                        <th class="pe-4 py-3 text-end text-muted fw-semibold">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var req in Model)
                        {
                            var hlClass = ViewBag.HighlightId == req.Id ? "bg-warning bg-opacity-10" : "";
                            <tr class="@hlClass border-bottom" id="req-@req.Id">
                                <td class="ps-4 fw-bold text-dark">@req.EmployeeCode</td>
                                <td>
                                    <span class="text-muted">Chấm công #@req.AttendanceId</span>
                                </td>
                                <td>
                                    <div class="d-flex flex-column">
                                        <span class="text-success"><i class="fas fa-arrow-right me-1" style="font-size:0.8rem"></i> In: @(req.RequestedCheckIn?.ToString(@"hh\:mm") ?? "---")</span>
                                        <span class="text-success"><i class="fas fa-arrow-right me-1" style="font-size:0.8rem"></i> Out: @(req.RequestedCheckOut?.ToString(@"hh\:mm") ?? "---")</span>
                                    </div>
                                </td>
                                <td>@(string.IsNullOrEmpty(req.ReviewedBy) ? "—" : req.ReviewedBy)</td>
                                <td class="text-muted">@req.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    @if (req.Status == "PENDING") { <span class="badge rounded-pill bg-warning text-dark px-3 py-2 fw-medium"><i class="fas fa-circle me-1" style="font-size:0.6rem"></i> Chờ xử lý</span> }
                                    else if (req.Status == "APPROVED") { <span class="badge rounded-pill bg-success bg-opacity-10 text-success px-3 py-2 fw-medium"><i class="fas fa-circle me-1" style="font-size:0.6rem"></i> Đã duyệt</span> }
                                    else if (req.Status == "REJECTED") { <span class="badge rounded-pill bg-danger bg-opacity-10 text-danger px-3 py-2 fw-medium"><i class="fas fa-circle me-1" style="font-size:0.6rem"></i> Từ chối</span> }
                                    else if (req.Status == "NEEDS_REVISION") { <span class="badge rounded-pill bg-info bg-opacity-10 text-info px-3 py-2 fw-medium"><i class="fas fa-circle me-1" style="font-size:0.6rem"></i> Cần bổ sung</span> }
                                </td>
                                <td class="pe-4 text-end">
                                    <button class="btn btn-light btn-sm rounded-circle shadow-sm" style="width:32px; height:32px;" onclick="openDetailDrawer(@req.Id)" title="Xem chi tiết" aria-label="Xem chi tiết">
                                        <i class="fas fa-eye text-primary"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                <div class="text-muted mb-2"><i class="fas fa-inbox fs-2"></i></div>
                                <h6 class="fw-bold mb-1">Chưa có yêu cầu xác nhận công</h6>
                                <p class="text-muted mb-0 small">Hiện tại chưa có yêu cầu xác nhận công nào theo bộ lọc này.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Offcanvas Detail Drawer -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="detailDrawer" aria-labelledby="detailDrawerLabel" style="width: 500px; border-left: 1px solid #e2e8f0; box-shadow: -5px 0 25px rgba(0,0,0,0.05);">
    <div class="offcanvas-header border-bottom bg-light">
        <div>
            <h5 class="offcanvas-title fw-bold" id="detailDrawerLabel">Chi tiết xác nhận công</h5>
            <div id="drawerSubtitle" class="text-muted small"></div>
        </div>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    
    <div class="offcanvas-body p-0 d-flex flex-column h-100 bg-white" style="overflow-y: auto;">
        
        <!-- Loading Skeleton -->
        <div id="drawerLoading" class="p-4">
            <p class="placeholder-glow"><span class="placeholder col-7"></span></p>
            <p class="placeholder-glow"><span class="placeholder col-4"></span> <span class="placeholder col-6"></span></p>
            <p class="placeholder-glow"><span class="placeholder col-12" style="height: 100px;"></span></p>
        </div>

        <!-- Content Area -->
        <div id="drawerContent" class="d-none">
            
            <!-- Section 1: Thông tin nhân viên & Yêu cầu -->
            <div class="p-4 border-bottom">
                <div class="d-flex align-items-center mb-3">
                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center fw-bold me-3" style="width:48px; height:48px; font-size:1.2rem">
                        <i class="fas fa-user"></i>
                    </div>
                    <div>
                        <h6 class="mb-1 fw-bold text-dark" id="detEmpName">---</h6>
                        <span class="badge bg-light text-dark border" id="detEmpCode">---</span>
                    </div>
                </div>
            </div>

            <!-- Section 2: So sánh Dữ liệu -->
            <div class="p-4 border-bottom bg-light bg-opacity-50">
                <h6 class="fw-bold mb-3"><i class="fas fa-balance-scale text-muted me-2"></i> So sánh Dữ liệu</h6>
                <div class="table-responsive rounded-3 border bg-white">
                    <table class="table table-bordered mb-0 text-center" style="font-size:0.9rem">
                        <thead class="table-light text-muted">
                            <tr>
                                <th class="fw-medium text-start">Trường dữ liệu</th>
                                <th class="fw-medium">Dữ liệu hệ thống</th>
                                <th class="fw-medium">Dữ liệu đề nghị</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="text-start fw-medium text-secondary">Giờ Check-in</td>
                                <td class="fw-bold text-danger" id="detCiOrig">---</td>
                                <td class="fw-bold text-success" id="detCiReq">---</td>
                            </tr>
                            <tr>
                                <td class="text-start fw-medium text-secondary">Giờ Check-out</td>
                                <td class="fw-bold text-danger" id="detCoOrig">---</td>
                                <td class="fw-bold text-success" id="detCoReq">---</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Section 3: Lý do -->
            <div class="p-4 border-bottom">
                <h6 class="fw-bold mb-3"><i class="fas fa-comment-alt text-muted me-2"></i> Lý do / Giải trình</h6>
                <div class="bg-light p-3 rounded-3 border" style="font-size:0.95rem" id="detReason">---</div>
            </div>

            <!-- Section 4: Minh chứng -->
            <div class="p-4 border-bottom">
                <h6 class="fw-bold mb-3"><i class="fas fa-paperclip text-muted me-2"></i> Minh chứng đính kèm</h6>
                <div id="detFiles" class="d-flex flex-column gap-2">
                    <!-- Files injected here -->
                </div>
            </div>

        </div>
    </div>
    
    <!-- Action Footer (HR/Leader: Read-Only Monitoring) -->
    <div class="offcanvas-footer border-top p-3 bg-white" id="drawerActions">
        <div class="alert alert-info py-2 px-3 mb-0 small w-100 text-center">
            <i class="fas fa-info-circle me-1"></i> Yêu cầu điều chỉnh công thuộc thẩm quyền phê duyệt của Quản lý trực tiếp (Manager). HR/Leader theo dõi giám sát.
        </div>
    </div>
</div>

<!-- Modal: Từ chối -->
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-bottom-0">
                <h5 class="modal-title fw-bold">Từ chối Yêu cầu</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-0">
                <label class="form-label fw-medium">Lý do từ chối <span class="text-danger">*</span></label>
                <textarea class="form-control rounded-3" id="rejectReasonInput" rows="3" placeholder="Nhập lý do chi tiết để nhân viên hiểu rõ..."></textarea>
            </div>
            <div class="modal-footer border-top-0 pt-0">
                <button type="button" class="btn btn-light rounded-3" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-danger rounded-3" onclick="submitReject()">Từ chối</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Yêu cầu bổ sung -->
<div class="modal fade" id="revisionModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-bottom-0">
                <h5 class="modal-title fw-bold text-info">Yêu cầu bổ sung</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-0">
                <label class="form-label fw-medium">Nội dung cần bổ sung <span class="text-danger">*</span></label>
                <textarea class="form-control rounded-3" id="revisionReasonInput" rows="3" placeholder="Nhập những gì nhân viên cần cung cấp thêm (ví dụ: Hình ảnh rõ hơn, xin xác nhận leader...)..."></textarea>
            </div>
            <div class="modal-footer border-top-0 pt-0">
                <button type="button" class="btn btn-light rounded-3" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-info text-white rounded-3" onclick="submitRevision()">Gửi yêu cầu</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Html.AntiForgeryToken()
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        let detailDrawer, rejectModal, revisionModal;
        
        document.addEventListener('DOMContentLoaded', function() {
            detailDrawer = new bootstrap.Offcanvas(document.getElementById('detailDrawer'));
            rejectModal = new bootstrap.Modal(document.getElementById('rejectModal'));
            revisionModal = new bootstrap.Modal(document.getElementById('revisionModal'));
            
            @if(ViewBag.HighlightId != null) {
                <text>
                setTimeout(() => {
                    document.getElementById('req-@ViewBag.HighlightId')?.scrollIntoView({behavior: 'smooth', block: 'center'});
                    openDetailDrawer(@ViewBag.HighlightId);
                }, 500);
                </text>
            }
        });

        function openDetailDrawer(id) {
            document.getElementById('drawerLoading').classList.remove('d-none');
            document.getElementById('drawerContent').classList.add('d-none');
            document.getElementById('drawerActions').classList.add('d-none');
            document.getElementById('curReqId').value = id;
            detailDrawer.show();
            
            $.get('/AttendanceAdjustment/GetDetails?id=' + id, function(res) {
                document.getElementById('drawerLoading').classList.add('d-none');
                document.getElementById('drawerContent').classList.remove('d-none');
                
                // Section 1
                document.getElementById('detEmpName').textContent = res.attendance.employeeName || 'Unknown';
                document.getElementById('detEmpCode').textContent = res.request.employeeCode;
                document.getElementById('drawerSubtitle').textContent = 'Ngày áp dụng: ' + new Date(res.attendance.checkIn).toLocaleDateString('vi-VN');
                
                // Section 2
                document.getElementById('detCiOrig').textContent = res.attendance.checkIn ? new Date(res.attendance.checkIn).toLocaleTimeString('vi-VN', {hour:'2-digit', minute:'2-digit'}) : '---';
                document.getElementById('detCoOrig').textContent = res.attendance.checkOut ? new Date(res.attendance.checkOut).toLocaleTimeString('vi-VN', {hour:'2-digit', minute:'2-digit'}) : '---';
                
                document.getElementById('detCiReq').textContent = res.request.requestedCheckIn || 'Không đổi';
                document.getElementById('detCoReq').textContent = res.request.requestedCheckOut || 'Không đổi';
                
                // Section 3
                document.getElementById('detReason').textContent = res.request.reason || 'Không có giải trình.';
                
                // Section 4
                let fileHtml = '';
                if(res.attachments && res.attachments.length > 0) {
                    res.attachments.forEach(f => {
                        let isImg = f.fileName.match(/\.(jpeg|jpg|png)$/i) != null;
                        if(isImg) {
                            fileHtml += `<a href="${f.filePath}" target="_blank" class="d-block mb-2 text-decoration-none">
                                            <div class="border rounded-3 p-1 text-center bg-light">
                                                <img src="${f.filePath}" class="img-fluid rounded" style="max-height: 150px; object-fit: contain;">
                                                <div class="small text-muted mt-1 text-truncate px-2">${f.fileName}</div>
                                            </div>
                                         </a>`;
                        } else {
                            fileHtml += `<a href="${f.filePath}" target="_blank" class="btn btn-outline-secondary w-100 text-start text-truncate rounded-3 mb-2">
                                            <i class="fas fa-file-pdf me-2 text-danger"></i>${f.fileName}
                                         </a>`;
                        }
                    });
                } else {
                    fileHtml = '<div class="text-muted fst-italic">Không có tệp đính kèm.</div>';
                }
                document.getElementById('detFiles').innerHTML = fileHtml;
                
                // Footer actions
                if(res.request.status === 'PENDING' || res.request.status === 'NEEDS_REVISION') {
                    document.getElementById('drawerActions').classList.remove('d-none');
                }
            }).fail(function() {
                Swal.fire('Lỗi', 'Không thể tải chi tiết.', 'error');
                detailDrawer.hide();
            });
        }

        function processReq(action, reason = '') {
            let id = document.getElementById('curReqId').value;
            Swal.fire({title: 'Đang xử lý...', didOpen: () => Swal.showLoading(), allowOutsideClick: false});
            $.post('/AttendanceAdjustment/ReviewRequest', {id: id, actionType: action, rejectionReason: reason, __RequestVerificationToken: document.querySelector('input[name="__RequestVerificationToken"]').value}, function(res) {
                if(res.success) {
                    Swal.fire('Thành công', res.message, 'success').then(() => location.reload());
                } else {
                    Swal.fire('Lỗi', res.message, 'error');
                }
            });
        }

        function openRejectModal() {
            document.getElementById('rejectReasonInput').value = '';
            rejectModal.show();
        }

        function submitReject() {
            let r = document.getElementById('rejectReasonInput').value.trim();
            if(!r) {
                Swal.fire('Cảnh báo', 'Vui lòng nhập lý do từ chối', 'warning');
                return;
            }
            rejectModal.hide();
            processReq('REJECT', r);
        }

        function openRevisionModal() {
            document.getElementById('revisionReasonInput').value = '';
            revisionModal.show();
        }

        function submitRevision() {
            let r = document.getElementById('revisionReasonInput').value.trim();
            if(!r) {
                Swal.fire('Cảnh báo', 'Vui lòng nhập nội dung yêu cầu bổ sung', 'warning');
                return;
            }
            revisionModal.hide();
            processReq('REQUEST_REVISION', r);
        }
    </script>
}
