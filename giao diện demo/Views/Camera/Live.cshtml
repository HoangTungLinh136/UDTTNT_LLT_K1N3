@model giao_dien_demo.Models.CameraConfig

@{
    ViewData["Title"] = "Live Camera Feed & Tracking";
}

<form id="cameraCsrf" hidden>@Html.AntiForgeryToken()</form>

<div class="container-fluid mt-3">
    <div class="row">
        <div class="col-md-9">
            <div class="card shadow">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="fa fa-video-camera text-danger"></i> @Model.Name - Live Feed
                    </h5>
                    <span class="badge bg-success" id="ai-status">AI Tracking: Loading...</span>
                </div>
                <div class="card-body p-0 position-relative" style="background: #000; min-height: 500px; display: flex; justify-content: center; overflow: hidden;">
                    
                    <!-- HLS Video Player -->
                    <video id="camera-video" autoplay muted playsinline crossorigin="anonymous" style="max-height: 70vh; width: 100%; object-fit: contain;"></video>
                    
                    <!-- AI Tracking Canvas Overlay -->
                    <canvas id="tracking-canvas" class="position-absolute top-0" style="pointer-events: none; width: 100%; height: 100%; object-fit: contain;"></canvas>

                </div>
                <div class="card-footer bg-light text-center">
                    <button class="btn btn-outline-secondary mx-1" onclick="sendPtz('left')"><i class="fa fa-arrow-left"></i></button>
                    <button class="btn btn-outline-secondary mx-1" onclick="sendPtz('up')"><i class="fa fa-arrow-up"></i></button>
                    <button class="btn btn-outline-secondary mx-1" onclick="sendPtz('down')"><i class="fa fa-arrow-down"></i></button>
                    <button class="btn btn-outline-secondary mx-1" onclick="sendPtz('right')"><i class="fa fa-arrow-right"></i></button>
                    <button class="btn btn-outline-primary mx-3" onclick="toggleZoneMode()"><i class="fa fa-draw-polygon"></i> Draw Zone</button>
                </div>
            </div>
        </div>
        
        <div class="col-md-3">
            <div class="card shadow">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">Recent Detections</h5>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush" id="detection-list" style="max-height: 70vh; overflow-y: auto;">
                        <li class="list-group-item text-muted text-center" id="no-events-text">No recent events</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Load HLS.js for playing the stream -->
    <script src="https://cdn.jsdelivr.net/npm/hls.js@latest"></script>
    
    <!-- Load TensorFlow.js -->
    <script src="https://cdn.jsdelivr.net/npm/@@tensorflow/tfjs"></script>
    <!-- Load COCO-SSD Model for object detection -->
    <script src="https://cdn.jsdelivr.net/npm/@@tensorflow-models/coco-ssd"></script>

    <!-- Load our custom tracking script -->
    <script src="~/js/camera-tracking.js"></script>
}
