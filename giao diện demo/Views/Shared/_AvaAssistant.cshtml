#c2f7ff" stroke-width="5" stroke-linecap="round"/><g class="pet-eyes-surprised" fill="#c2f7ff"><circle cx="95" cy="100" r="13"/><circle cx="146" cy="100" r="13"/></g><path class="pet-eyes-think" d="M83 93h22m31 5h22" stroke="#c2f7ff" stroke-width="6" stroke-linecap="round"/><path class="pet-mouth-smile" d="M111 120q9 9 18 0" stroke="#a0ebeb" stroke-width="4" fill="none" stroke-linecap="round"/><ellipse class="pet-mouth-talk pet-mouth-o" cx="120" cy="124" rx="8" ry="10" fill="#a0ebeb"/><circle cx="73" cy="119" r="7" fill="#f6b4cf" opacity=".6"/><circle cx="167" cy="119" r="7" fill="#f6b4cf" opacity=".6"/></g><g class="pet-happy-sparkles" fill="#f6c65e"><path d="m35 65 4-11 4 11 11 4-11 4-4 11-4-11-11-4z"/><path d="m205 115 4-11 4 11 11 4-11 4-4 11-4-11-11-4z"/></g></g></svg></div><div class="company-hero-bubble">Bạn cần giúp gì hôm nay?</div></div></div>
                        <div class="company-quick-actions"><button type="button" class="company-pill" data-start="work">✦ Lên ý tưởng</button><button type="button" class="company-pill" data-start="translate">Dịch nhanh</button><button type="button" class="company-pill" data-start="meeting">Tóm tắt cuộc họp</button></div>
                        <div class="company-section-heading"><h2>Bắt đầu từ điều bạn cần</h2><span>Có AVA đồng hành</span></div><div class="company-feature-grid"><button type="button" class="company-feature-card" data-start="policy" data-flow="knowledge"><span class="company-feature-icon icon-blue"><i class="fa-solid fa-book-open" aria-hidden="true"></i></span><span class="company-feature-body"><strong>Kiến thức công ty</strong><p>Tra cứu chính sách, quy trình nội bộ.</p></span></button><button type="button" class="company-feature-card" data-start="document" data-flow="documents"><span class="company-feature-icon icon-purple"><i class="fa-solid fa-file-lines" aria-hidden="true"></i></span><span class="company-feature-body"><strong>Đọc & tóm tắt</strong><p>Tìm ý chính từ tài liệu đính kèm.</p></span></button><button type="button" class="company-feature-card" data-start="work" data-flow="chat"><span class="company-feature-icon icon-sky"><i class="fa-solid fa-list-check" aria-hidden="true"></i></span><span class="company-feature-body"><strong>Lập kế hoạch</strong><p>Biến ý tưởng thành các bước cụ thể.</p></span></button><button type="button" class="company-feature-card" data-start="write" data-flow="chat"><span class="company-feature-icon icon-rose"><i class="fa-solid fa-pen-nib" aria-hidden="true"></i></span><span class="company-feature-body"><strong>Soạn nội dung</strong><p>Cùng viết email, đề xuất và báo cáo.</p></span></button><button type="button" class="company-feature-card" data-start="people" data-flow="personal"><span class="company-feature-icon icon-teal"><i class="fa-solid fa-user" aria-hidden="true"></i></span><span class="company-feature-body"><strong>Thông tin của tôi</strong><p>Tra cứu trong phạm vi được cấp quyền.</p></span></button><button type="button" class="company-feature-card" data-start="data" data-flow="data"><span class="company-feature-icon icon-indigo"><i class="fa-solid fa-chart-simple" aria-hidden="true"></i></span><span class="company-feature-body"><strong>Phân tích dữ liệu</strong><p>Đọc bảng tính và giải thích kết quả.</p></span></button></div>
                        <div class="company-service-strip"><span id="company-connection-dot" class="company-connection-dot" data-state="loading"></span><span id="company-service-summary">Đang kiểm tra AI service nội bộ</span><button type="button" class="company-text-button" data-panel="connections">Chi tiết kết nối</button></div>
                    </div>
                    <div id="ava-messages" class="company-messages" role="log" aria-live="polite"></div>
                    <section id="company-panel" class="company-panel" hidden><header class="company-panel-header"><h2 id="company-panel-title"></h2><p id="company-panel-description"></p></header><div id="company-panel-body"></div></section>
                </div>
                <button id="company-scroll-latest" class="company-scroll-btn" type="button" hidden>↓ Tin nhắn mới nhất</button>
                <div id="ava-error" class="company-error-banner" role="alert" hidden></div>
                <div id="company-composer-area" class="company-composer-area">
                    <div id="ava-upload-status" class="company-upload-indicator" role="status" hidden></div><div id="ava-attachments" class="company-attachments-box"></div>
                    <form id="ava-composer" class="company-composer" autocomplete="off">
                        @Html.AntiForgeryToken()
                        <input id="ava-file-input" type="file" hidden multiple accept=".png,.jpg,.jpeg,.webp,.bmp,.pdf,.docx,.xlsx,.txt,.csv,.json,.wav,.mp3,.m4a,.ogg,.webm"/>
                        <div class="company-composer-input-row"><label for="ava-input" class="visually-hidden">Tin nhắn cho Company AI</label><textarea id="ava-input" rows="1" maxlength="8000" placeholder="Hỏi AVA hoặc chia sẻ điều bạn đang làm…"></textarea></div>
                        <div class="company-composer-bottom-bar"><div class="company-composer-tools"><button id="ava-attach" class="company-tool-btn" type="button" title="Đính kèm tệp" aria-label="Đính kèm tệp">＋</button><button id="ava-attach-alt" class="company-tool-btn" type="button" title="Chọn tài liệu" aria-label="Chọn tài liệu"><i class="fa-regular fa-file-lines" aria-hidden="true"></i></button><button id="ava-web-toggle" class="company-tool-btn" type="button" title="Kiến thức nội bộ" aria-label="Kiến thức nội bộ"><i class="fa-solid fa-book-open" aria-hidden="true"></i></button><button id="ava-mic" class="company-tool-btn" type="button" title="Ghi âm" aria-label="Ghi âm"><i class="fa-solid fa-microphone" aria-hidden="true"></i></button><button id="ava-stop-recording" class="company-tool-btn" type="button" aria-label="Dừng ghi âm" hidden>■</button><button id="ava-cancel-recording" class="company-tool-btn" type="button" aria-label="Hủy ghi âm" hidden>×</button></div><div class="company-composer-actions"><span id="company-flow-label" class="company-shortcut-hint">Shift + Enter xuống dòng</span><button id="ava-send" class="company-send-btn" type="submit" aria-label="Gửi tin nhắn">↑</button></div></div>
                    </form><button id="ava-cancel-request" class="company-cancel-btn" type="button" hidden>Hủy chờ phản hồi</button>
                </div>
            </div>
        </section>
    </div>
    <script src="~/js/company-ai-service.js" asp-append-version="true"></script>
    <script src="~/js/company-pet.js" asp-append-version="true"></script>
    <script src="~/js/company-ai.js" asp-append-version="true"></script>
}
