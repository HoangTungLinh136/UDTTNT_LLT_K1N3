@if (User?.Identity?.IsAuthenticated == true)
{
    var avaActor = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Authenticated";
    var avaIdentity = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
    <div id="ava-assistant" class="company-ai d-print-none" data-user-id="@avaIdentity" data-ava-actor="@avaActor" data-task-url="/MyRequest" data-ui-version="company-ai-v2">
        <div id="company-pet-dock" class="company-pet-dock">
            <div id="company-pet-bubble" class="company-pet-bubble" role="status"></div>
            <button id="ava-trigger" class="company-pet-trigger" type="button" aria-label="Mở Company AI. Giữ và kéo để di chuyển" aria-controls="ava-drawer" aria-expanded="false"><svg class="company-pet-art" viewBox="0 0 240 260" aria-hidden="true"><ellipse class="pet-floor-shadow" cx="120" cy="237" rx="65" ry="9" fill="#a6b4ed" opacity=".35"/><g class="pet-pose"><g class="pet-leg pet-leg-left"><rect x="86" y="195" width="25" height="34" rx="12" fill="#6582e8"/></g><g class="pet-leg pet-leg-right"><rect x="132" y="195" width="25" height="34" rx="12" fill="#6582e8"/></g><rect x="73" y="139" width="95" height="67" rx="30" fill="#bacdff"/><path d="M99 169h43" stroke="#fff" stroke-width="7" stroke-linecap="round"/><g class="pet-arm pet-arm-left"><rect x="48" y="151" width="28" height="47" rx="14" fill="#8daaf5" transform="rotate(18 62 164)"/></g><g class="pet-arm pet-arm-right"><rect x="165" y="149" width="28" height="47" rx="14" fill="#8daaf5" transform="rotate(-18 180 164)"/></g><g class="pet-head"><g class="pet-sprout"><path d="M120 52V32" stroke="#7797eb" stroke-width="6" stroke-linecap="round"/><path d="M120 35c-24 1-30-17-26-22 22-2 29 10 26 22" fill="#80d5bf"/><path d="M121 34c1-18 14-24 25-21 1 16-10 23-25 21" fill="#a7e5d2"/></g><rect x="44" y="49" width="153" height="110" rx="46" fill="#e5eeff" stroke="#9fb9f4" stroke-width="3"/><rect x="58" y="64" width="125" height="79" rx="32" fill="#344b85"/><g class="pet-blink"><g class="pet-gaze pet-eyes-normal" fill="#c2f7ff"><ellipse cx="95" cy="101" rx="9" ry="13"/><ellipse cx="146" cy="101" rx="9" ry="13"/></g></g><path class="pet-eyes-smile" d="M85 102q10-16 20 0m31 0q10-16 20 0" fill="none" stroke="#c2f7ff" stroke-width="6" stroke-linecap="round"/><path class="pet-eyes-sleep" d="M85 104h20m31 0h20" stroke="#c2f7ff" stroke-width="5" stroke-linecap="round"/><g class="pet-eyes-surprised" fill="#c2f7ff"><circle cx="95" cy="100" r="13"/><circle cx="146" cy="100" r="13"/></g><path class="pet-eyes-think" d="M83 93h22m31 5h22" stroke="#c2f7ff" stroke-width="6" stroke-linecap="round"/><path class="pet-mouth-smile" d="M111 120q9 9 18 0" stroke="#a0ebeb" stroke-width="4" fill="none" stroke-linecap="round"/><ellipse class="pet-mouth-talk pet-mouth-o" cx="120" cy="124" rx="8" ry="10" fill="#a0ebeb"/><circle cx="73" cy="119" r="7" fill="#f6b4cf" opacity=".6"/><circle cx="167" cy="119" r="7" fill="#f6b4cf" opacity=".6"/></g><g class="pet-happy-sparkles" fill="#f6c65e"><path d="m35 65 4-11 4 11 11 4-11 4-4 11-4-11-11-4z"/><path d="m205 115 4-11 4 11 11 4-11 4-4 11-4-11-11-4z"/></g></g></svg><span class="company-pet-mini-mark">✦</span><span class="company-pet-sleep">Zz</span></button>
            <button id="company-pet-options" class="company-pet-options" type="button" aria-label="Tùy chọn trợ lý" aria-expanded="false" aria-controls="company-pet-menu">···</button>
        </div>
        <button id="company-ai-reopen" class="company-ai-reopen" type="button" hidden>✦ Company AI</button>
        <div id="company-pet-menu" class="company-pet-menu" hidden>
            <div class="company-pet-menu-header"><strong>Company AI · AVA</strong><small>Người bạn đồng hành trong công việc</small></div>
            <button type="button" data-pet-action="chat">Mở trò chuyện</button><button type="button" data-pet-action="note">Ghi chú riêng</button><button type="button" data-pet-action="summary">Tóm tắt tài liệu</button><button type="button" data-pet-action="mini">Thu nhỏ / phóng to linh vật</button><button type="button" data-pet-action="hide">Ẩn linh vật</button>
        </div>
        <section id="ava-drawer" class="company-window" role="dialog" aria-label="Company AI — Trợ lý công việc" aria-hidden="true" inert>
            <aside class="company-sidebar" aria-label="Điều hướng trợ lý">
                <button id="company-sidebar-mobile-close" class="company-mobile-close" type="button" aria-label="Đóng điều hướng">×</button>
                <div class="company-brand"><span class="company-brand-icon">✦</span><span class="company-brand-text"><strong>Company AI</strong><small>YOUR WORK COMPANION</small></span><button id="company-sidebar-toggle" type="button" aria-label="Thu gọn điều hướng" aria-expanded="true">‹</button></div>
                <nav class="company-nav-list"><button id="company-new-conversation" type="button" title="Bắt đầu trò chuyện mới; hội thoại cũ vẫn được lưu trong Lịch sử"><span class="company-icon"><i class="fa-regular fa-pen-to-square" aria-hidden="true"></i></span><span>Trò chuyện mới</span></button><button type="button" data-panel="chat"><span class="company-icon"><i class="fa-solid fa-comment-dots" aria-hidden="true"></i></span><span>Trò chuyện</span></button><button type="button" data-panel="knowledge"><span class="company-icon"><i class="fa-solid fa-book-open" aria-hidden="true"></i></span><span>Kiến thức công ty</span></button><button type="button" data-panel="documents"><span class="company-icon"><i class="fa-solid fa-file-lines" aria-hidden="true"></i></span><span>Tài liệu</span></button><button type="button" data-panel="tools"><span class="company-icon"><i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i></span><span>Công cụ</span></button><button type="button" data-panel="tasks"><span class="company-icon"><i class="fa-solid fa-list-check" aria-hidden="true"></i></span><span>Ghi chú của tôi</span></button><button type="button" data-panel="history"><span class="company-icon"><i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i></span><span>Lịch sử</span></button><button type="button" data-panel="connections"><span class="company-icon"><i class="fa-solid fa-plug" aria-hidden="true"></i></span><span>Kết nối AI</span></button><button type="button" data-panel="settings"><span class="company-icon"><i class="fa-solid fa-sliders" aria-hidden="true"></i></span><span>Cài đặt</span></button><button type="button" data-panel="help"><span class="company-icon"><i class="fa-solid fa-circle-question" aria-hidden="true"></i></span><span>Hướng dẫn</span></button></nav>
                <div class="company-sidebar-footer"><div class="company-user-card"><span class="company-user-avatar"><i class="fa-solid fa-user" aria-hidden="true"></i></span><span class="company-user-info"><strong>@avaIdentity</strong><small>@avaActor</small></span></div></div>
            </aside>
            <div class="company-main">
                <header class="company-window-header"><div class="company-header-title"><button id="company-mobile-nav" type="button" class="company-icon-btn" aria-label="Mở điều hướng" aria-expanded="false">☰</button><span><strong>Company AI <span class="company-badge-saas">AVA</span></strong><small id="company-status">Đang kiểm tra kết nối…</small></span></div><div class="company-header-actions"><button id="ava-new" class="company-icon-btn" type="button" title="Hội thoại mới" aria-label="Hội thoại mới">＋</button><button id="ava-expand" class="company-icon-btn" type="button" title="Mở rộng không gian" aria-label="Mở rộng không gian" aria-pressed="false">⤢</button><button id="ava-close" class="company-icon-btn company-close-btn" type="button" aria-label="Đóng trợ lý">×</button></div></header>
                <div id="company-content" style="display:flex;flex:1;min-height:0;flex-direction:column;overflow:hidden">
