@inject giao_dien_demo.Data.ApplicationDbContext DbContext
@using Microsoft.EntityFrameworkCore
<!DOCTYPE html>
<html lang="vi" id="hrms-html-root">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HRMS</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/company-ai.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/company-pet.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
</head>
<body>

    @using Microsoft.AspNetCore.Http
    @{
        var role = Context.Session.GetString("Role");
        var currentUser = Context.Session.GetString("User") ?? "";
        var realName = Context.Session.GetString("RealName") ?? "";
        var avatarChar = (realName.Length > 0 ? realName.Substring(0, 1).ToUpper() : (currentUser.Length > 0 ? currentUser.Substring(0, 1).ToUpper() : "H"));

        var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
        
        string majorModule = "HR";
        if (role == "Employee") {
            majorModule = "Employee";
        } else if (role == "Admin") {
            majorModule = "Admin";
        } else if (role == "Manager") {
            majorModule = "Manager";
        } else if (role == "Leader") {
            majorModule = "Leadership";
        } else if (new[] { "Attendance", "AttendanceAdjustment", "Timesheet", "Approval", "Holiday", "WorkShift", "AttendanceReport", "AttendanceRule" }.Contains(currentController)) {
            majorModule = "Attendance";
        } else if (new[] { "Salary", "PayrollPayment", "PayrollInput", "PayrollValidation", "PayrollCostReport", "PayrollTaxReport", "PayrollTemplate", "PayrollComponent", "PayrollSetting" }.Contains(currentController)) {
            majorModule = "Payroll";
        }

        int soThongBao = 0;
        
        // Determine AI Name
        string aiName = majorModule == "Employee" ? "AVA Nhân viên" :
                        majorModule == "Attendance" ? "AVA Chấm công" : 
                        majorModule == "Payroll" ? "AVA Tiền lương" : "AVA HR";

        if (!string.IsNullOrEmpty(currentUser))
        {
            var currentUserId = await DbContext.Users.Where(x => x.Username == currentUser)
                .Select(x => (int?)x.Id).FirstOrDefaultAsync();
            if (currentUserId.HasValue)
            {
                soThongBao = await DbContext.Notifications
                    .CountAsync(n => n.RecipientUserId == currentUserId.Value && !n.IsRead);
            }
        }


        string activeModule = "HRMS";
        string activeSubModule = "";

        if (role == "Employee") {
            // Employee: breadcrumb theo controller
            if (currentController == "NhanVien") {
                activeModule = "Tổng quan";
            } else if (currentController == "Employee") {
                activeModule = currentAction == "Hierarchy" ? "Cây phân cấp" : "Hồ sơ của tôi";
            } else if (currentController == "Attendance" || currentController == "AttendanceAdjustment") {
                activeModule = "Chấm công";
            } else if (currentController == "MyRequest" || currentController == "Leave") {
                activeModule = "Nghỉ phép";
            } else if (currentController == "Salary" || currentController == "MyPayroll") {
                activeModule = "Tiền lương";
            } else if (currentController == "Contract") {
                activeModule = "Hợp đồng";
            } else if (currentController == "Notification") {
                activeModule = "Thông báo";
            } else if (currentController == "Benefit") {
                activeModule = "Phúc lợi";
            } else if (currentController == "Training") {
                activeModule = "Đào tạo";
            } else if (currentController == "Reward") {
                activeModule = "Khen thưởng";
            } else if (currentController == "MyKPI") {
                activeModule = "KPI của tôi";
            } else {
                activeModule = "Tổng quan";
            }
        } else if (role == "Admin") {
            // Admin: module detection riêng
            if (currentController == "Admin" && (currentAction == "Index" || currentAction == "")) {
                activeModule = "Tổng quan hệ thống";
                activeSubModule = "";
            } else if (currentController == "Admin" && (currentAction == "Users" || currentAction == "Details" || currentAction == "EditUser" || currentAction == "CreateUser")) {
                activeModule = "Người dùng";
                activeSubModule = currentAction == "Users" ? "" : currentAction == "Details" ? "Chi tiết" : currentAction == "EditUser" ? "Cập nhật" : "Thêm mới";
            } else if (currentController == "AdminRole") {
                activeModule = "Vai trò & phân quyền";
            } else if (currentController == "AdminOrg") {
                activeModule = "Đơn vị tổ chức";
            } else if (currentController == "AdminCategory") {
                activeModule = "Danh mục hệ thống";
            } else if (currentController == "AdminSecurity") {
                activeModule = "Chính sách bảo mật";
            } else if (currentController == "AdminNotificationConfig") {
                activeModule = "Cấu hình thông báo";
            } else if (currentController == "AdminIntegration") {
                activeModule = "Tích hợp hệ thống";
            } else if (currentController == "AdminAudit") {
                activeModule = "Audit Log";
            } else if (currentController == "AdminBackup") {
                activeModule = "Sao lưu & phục hồi";
            } else if (currentController == "AdminSettings") {
                activeModule = "Cấu hình hệ thống";
            } else if (currentController == "AdminMonitoring") {
                activeModule = "System Monitoring";
            } else {
                activeModule = "Tổng quan hệ thống";
            }
        } else if (majorModule == "Manager") {
            if (currentController == "ManagerKPI") {
                activeModule = "KPI / Hiệu suất";
            } else if (currentController == "Appointment") {
                activeModule = "Đề xuất nhân sự";
                activeSubModule = "Bổ nhiệm";
            } else if (currentController == "Dismissal") {
                activeModule = "Đề xuất nhân sự";
                activeSubModule = "Miễn nhiệm";
            } else if (currentController == "Transfer") {
                activeModule = "Đề xuất nhân sự";
                activeSubModule = "Điều chuyển";
            } else if (currentController == "Reward") {
                activeModule = "Đề xuất nhân sự";
                activeSubModule = "Khen thưởng";
                } else if (currentController == "ManagerWorkspace") {
                    activeModule = currentAction switch {
                    "Profile" => "Hồ sơ",
                    "Employees" => "Nhân viên trực thuộc",
                    "Attendance" => "Chấm công đội nhóm",
                    "LeaveApprovals" => "Duyệt nghỉ phép",
                    "AttendanceAdjustments" => "Duyệt giải trình công",
                    "Reports" => "Báo cáo",
                    "Notifications" => "Thông báo",
                    _ => "Tổng quan"
                };
            } else {
                activeModule = "Tổng quan";
            }
        } else if (majorModule == "Leadership") {
            if (currentController == "Leader") activeModule = "Tổng quan";
            else if (currentController == "LeaderPersonnel") activeModule = "Nhân sự";
            else if (currentController == "LeaderAttendance") activeModule = "Chấm công";
            else if (currentController == "LeaderLeave") activeModule = "Nghỉ phép";
            else if (currentController == "LeaderContract") activeModule = "Hợp đồng";
            else if (currentController == "LeaderCost") activeModule = "Chi phí nhân sự";
            else if (currentController == "LeaderKPI") activeModule = "KPI / Hiệu suất";
            else if (currentController == "LeaderAnalytics") activeModule = "Phân tích";
            else if (currentController == "LeaderReport") activeModule = "Báo cáo";
            else if (currentController == "LeaderApproval") activeModule = "Phê duyệt";
            else activeModule = "Tổng quan";
        } else {
            // HR: giữ nguyên logic cũ
            if (currentController == "HR" || (currentController == "Home" && role != "Admin" && role != "Employee" && role != "Leader")) {
                activeModule = "Tổng quan";
                activeSubModule = "";
            } else if (currentController == "Onboarding") {
                activeModule = "Hội nhập";
                activeSubModule = "Danh sách hội nhập";
            } else if (currentController == "Employee") {
                activeModule = "Quản lý Hồ sơ";
                if (currentAction == "MyProfile") activeSubModule = "Hồ sơ cá nhân";
                else if (currentAction == "Index") activeSubModule = "Danh sách nhân viên";
                else if (currentAction == "Hierarchy") activeSubModule = "Cây phân cấp";
                else if (currentAction == "Details") activeSubModule = "Chi tiết hồ sơ";
                else activeSubModule = "Hồ sơ nhân viên";
            } else if (currentController == "AdminOrg") {
                activeModule = "Quản lý Hồ sơ";
                activeSubModule = "Danh mục phòng ban";
            } else if (currentController == "Attendance" || currentController == "AttendanceAdjustment" || currentController == "Timesheet") {
                activeModule = "Chấm công";
                if (currentController == "AttendanceAdjustment") activeSubModule = "Yêu cầu điều chỉnh";
                else if (currentController == "Timesheet") activeSubModule = "Bảng chấm công";
                else if (currentAction == "Index") activeSubModule = "Tổng quan";
                else activeSubModule = "Dữ liệu chấm công";
            } else if (currentController == "AttendanceRule") {
                activeModule = "Chấm công";
                activeSubModule = "Quy tắc chấm công";
            } else if (currentController == "WorkShift") {
                activeModule = "Chấm công";
                activeSubModule = "Ca làm việc";
            } else if (currentController == "Approval") {
                activeModule = "Chấm công";
                activeSubModule = "Đơn chờ duyệt";
            } else if (currentController == "Holiday") {
                activeModule = "Chấm công";
                activeSubModule = "Ngày nghỉ lễ";
            } else if (currentController == "AttendanceReport") {
                activeModule = "Chấm công";
                activeSubModule = currentAction == "Late" ? "Báo cáo đi muộn" : "Báo cáo chấm công";
            } else if (new[] { "Salary", "PayrollPayment", "PayrollInput", "PayrollValidation", "PayrollCostReport", "PayrollTaxReport", "PayrollTemplate", "PayrollComponent", "PayrollSetting" }.Contains(currentController)) {
                activeModule = "Lương";
                if (currentController == "Salary" && currentAction == "Index") activeSubModule = "Bảng lương";
                else if (currentController == "PayrollPayment") activeSubModule = "Thanh toán lương";
                else if (currentController == "PayrollInput") activeSubModule = "Nhập liệu";
                else if (currentController == "PayrollValidation") activeSubModule = "Kiểm tra";
                else if (currentController == "PayrollCostReport") activeSubModule = "Báo cáo chi phí";
                else if (currentController == "PayrollTaxReport") activeSubModule = "Báo cáo thuế";
                else if (currentController == "PayrollTemplate") activeSubModule = "Mẫu bảng lương";
                else if (currentController == "PayrollComponent") activeSubModule = "Thành phần lương";
                else if (currentController == "PayrollSetting") activeSubModule = "Thiết lập";
                else activeSubModule = "Tổng quan";
            } else if (currentController == "Leave") {
                activeModule = "Nghỉ phép";
                activeSubModule = "Tổng quan";
            } else if (currentController == "Contract") {
                activeModule = "Hợp đồng";
                activeSubModule = "Tổng quan";
            } else if (currentController == "Appointment") {
                activeModule = "Bổ nhiệm";
                activeSubModule = "Danh sách quyết định";
            } else if (currentController == "Dismissal") {
                activeModule = "Miễn nhiệm";
                activeSubModule = "Danh sách quyết định";
            } else if (currentController == "Transfer") {
                activeModule = "Thuyên chuyển";
                activeSubModule = "Danh sách thuyên chuyển";
            } else if (currentController == "Offboarding") {
                activeModule = "Nghỉ việc";
                activeSubModule = "Danh sách nghỉ việc";
            } else if (currentController == "Reward") {
                activeModule = "Khen thưởng";
                activeSubModule = "Danh sách khen thưởng";
            } else if (currentController == "Incident") {
                activeModule = "Sự cố nhân sự";
                activeSubModule = "Quản lý sự cố";
            } else if (currentController == "Succession") {
                activeModule = "Quy hoạch";
                activeSubModule = "Quản lý quy hoạch";
            } else if (currentController == "TaskTracking") {
                activeModule = "Công việc HR";
                activeSubModule = "Quản lý công việc";
            } else if (currentController == "Proposal") {
                activeModule = "Đề xuất";
                activeSubModule = "Quản lý đề xuất";
            } else if (currentController == "Report") {
                activeModule = "Báo cáo";
                if (currentAction == "Export") activeSubModule = "Xuất báo cáo";
                else activeSubModule = "Tổng quan";
            } else if (currentController == "KPIPeriod" || currentController == "KPIConfig") {
                activeModule = "KPI / Hiệu suất";
                activeSubModule = currentController == "KPIPeriod" ? "Kỳ đánh giá KPI" : "Cấu hình hệ số";
            } else {
                activeModule = "Hệ thống";
            }
        }

        string activeModuleIcon = "fa-solid fa-circle";
        string displayModule = activeModule;
        
        if (activeModule == "Tổng quan") activeModuleIcon = "fa-solid fa-house";
        else if (activeModule == "Tổng quan hệ thống") { activeModuleIcon = "fa-solid fa-shield-halved"; displayModule = "Tổng quan hệ thống"; }
        else if (activeModule == "Người dùng") activeModuleIcon = "fa-solid fa-users";
        else if (activeModule == "Vai trò & phân quyền") activeModuleIcon = "fa-solid fa-lock";
        else if (activeModule == "Đơn vị tổ chức") activeModuleIcon = "fa-solid fa-sitemap";
        else if (activeModule == "Danh mục hệ thống") activeModuleIcon = "fa-solid fa-layer-group";
        else if (activeModule == "Chính sách bảo mật") activeModuleIcon = "fa-solid fa-shield-halved";
        else if (activeModule == "Cấu hình thông báo") activeModuleIcon = "fa-solid fa-bell-slash";
        else if (activeModule == "Tích hợp hệ thống") activeModuleIcon = "fa-solid fa-plug";
        else if (activeModule == "Audit Log") activeModuleIcon = "fa-solid fa-scroll";
        else if (activeModule == "Sao lưu & phục hồi") activeModuleIcon = "fa-solid fa-database";
        else if (activeModule == "Cấu hình hệ thống") activeModuleIcon = "fa-solid fa-gear";
        else if (activeModule == "System Monitoring") activeModuleIcon = "fa-solid fa-chart-line";
        else if (activeModule == "Hồ sơ của tôi") { activeModuleIcon = "fa-solid fa-address-card"; }
        else if (activeModule == "Hồ sơ" || activeModule == "Quản lý Hồ sơ") { activeModuleIcon = "fa-solid fa-address-card"; displayModule = "Hồ sơ"; }
        else if (activeModule == "Chấm công") activeModuleIcon = "fa-solid fa-clock-rotate-left";
        else if (activeModule == "Lương") activeModuleIcon = "fa-solid fa-money-check-dollar";
        else if (activeModule == "Nghỉ phép") activeModuleIcon = "fa-solid fa-umbrella-beach";
        else if (activeModule == "Hợp đồng") activeModuleIcon = "fa-solid fa-file-contract";
        else if (activeModule == "Bổ nhiệm") activeModuleIcon = "fa-solid fa-user-plus";
        else if (activeModule == "Miễn nhiệm") activeModuleIcon = "fa-solid fa-user-minus";
        else if (activeModule == "Thuyên chuyển") activeModuleIcon = "fa-solid fa-right-left";
        else if (activeModule == "Nghỉ việc") activeModuleIcon = "fa-solid fa-person-walking-arrow-right";
        else if (activeModule == "Nhân sự") activeModuleIcon = "fa-solid fa-users";
        else if (activeModule == "Chi phí nhân sự") activeModuleIcon = "fa-solid fa-coins";
        else if (activeModule == "KPI / Hiệu suất") activeModuleIcon = "fa-solid fa-chart-column";
        else if (activeModule == "Phân tích") activeModuleIcon = "fa-solid fa-magnifying-glass-chart";
        else if (activeModule == "Phê duyệt") activeModuleIcon = "fa-solid fa-clipboard-check";
        else if (activeModule == "Báo cáo") activeModuleIcon = "fa-solid fa-chart-line";
        else if (activeModule == "Thông báo") activeModuleIcon = "fa-solid fa-bell";
        else if (activeModule == "Phúc lợi") activeModuleIcon = "fa-solid fa-hand-holding-heart";
        else if (activeModule == "Đào tạo") activeModuleIcon = "fa-solid fa-graduation-cap";
        else if (activeModule == "Khen thưởng") activeModuleIcon = "fa-solid fa-award";
        else if (activeModule == "Sự cố" || activeModule == "Sự cố nhân sự") activeModuleIcon = "fa-solid fa-triangle-exclamation";
        else if (activeModule == "Quy hoạch") activeModuleIcon = "fa-solid fa-sitemap";
        else if (activeModule == "Đôn đốc" || activeModule == "Công việc HR") activeModuleIcon = "fa-solid fa-bullhorn";
        else if (activeModule == "Đề xuất") activeModuleIcon = "fa-solid fa-lightbulb";
        else if (activeModule == "Hội nhập") activeModuleIcon = "fa-solid fa-handshake-angle";
    }

    <div class="app-container">

        <!-- HEADER TOPBAR -->
        <header class="topbar">
            <div class="topbar-left">
                @if (role != "Employee" && role != "Admin" && role != "Leader" && role != "Manager")
                {
                    <button id="appLauncherBtn" class="app-launcher-btn" title="Chuyển đổi chức năng">
                        <div style="display: grid; grid-template-columns: repeat(2, 4px); grid-template-rows: repeat(3, 4px); gap: 3px; opacity: 0.8;">
                            <div style="width: 4px; height: 4px; background: currentColor; border-radius: 50%;"></div>
                            <div style="width: 4px; height: 4px; background: currentColor; border-radius: 50%;"></div>
                            <div style="width: 4px; height: 4px; background: currentColor; border-radius: 50%;"></div>
                            <div style="width: 4px; height: 4px; background: currentColor; border-radius: 50%;"></div>
                            <div style="width: 4px; height: 4px; background: currentColor; border-radius: 50%;"></div>
                            <div style="width: 4px; height: 4px; background: currentColor; border-radius: 50%;"></div>
                        </div>
                    </button>
                }
                <a href="/" class="topbar-logo">
                    <img src="~/images/logo.jpg" alt="Logo" style="height: 32px; border-radius: 4px; object-fit: cover; width: 32px;" />
                    HRMS
                </a>
            </div>
            
            <div class="topbar-center" style="display: flex; align-items: center; justify-content: center; flex: 1;">
                <div style="position: relative; width: 400px; max-width: 100%;">
                    <i class="fa-solid fa-magnifying-glass" style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: #94a3b8;"></i>
                    <input type="text" placeholder="@(role == "Manager" ? "Tìm nhân viên trong phạm vi..." : "Tìm kiếm thông minh, nhân viên, hợp đồng...")" style="width: 100%; height: 36px; padding: 0 16px 0 36px; border: 1px solid #e2e8f0; border-radius: 8px; background: #f8fafc; font-size: 14px; outline: none; transition: var(--transition);" onfocus="this.style.background='#fff'; this.style.borderColor='#3b82f6';" onblur="this.style.background='#f8fafc'; this.style.borderColor='#e2e8f0';" />
                </div>
            </div>

            <div class="topbar-right">
                
                
                <a asp-controller="Notification" asp-action="Index" class="topbar-action-btn" style="text-decoration:none;" title="Thông báo">
                    <i class="fa-regular fa-bell"></i>
                    @if (soThongBao > 0)
                    {
                        <span id="notificationBadge" style="position:absolute; top: -2px; right: -2px; background: #ef4444; color: white; font-size: 10px; font-weight: 700; border-radius: 50%; min-width: 18px; height: 18px; display: flex; align-items: center; justify-content: center;">@soThongBao</span>
                    }
                </a>
                
                <button class="topbar-action-btn" title="Trợ giúp">
                    <i class="fa-regular fa-circle-question"></i>
                </button>
                <button class="topbar-action-btn" title="Cài đặt">
                    <i class="fa-solid fa-gear"></i>
                </button>
                
                @if (!string.IsNullOrEmpty(realName))
                {
                    <div style="display: flex; align-items: center; gap: 10px; margin-left: 8px;">
                        <div class="topbar-avatar">@avatarChar</div>
                        <div class="topbar-user-info">
                            <span class="topbar-user-name">@realName</span>
                            <span class="topbar-user-role">@role</span>
                        </div>
                        <form asp-controller="Account" asp-action="Logout" method="post" style="display: inline; margin-left: 8px;">
                            <button type="submit" style="border: 0; background: transparent; color: #64748b; padding: 0;" title="Đăng xuất">
                                <i class="fa-solid fa-right-from-bracket"></i>
                            </button>
                        </form>
                    </div>
                }
            </div>
        </header>

        <!-- APP LAUNCHER POPOVER -->
        <div class="app-launcher-popover" id="appLauncherPopover">
            @if (role == "Employee") {
                <div style="padding: 12px 16px; font-weight: 600; color: #64748b; font-size: 13px; border-bottom: 1px solid #e2e8f0; margin-bottom: 8px;">
                    Menu nhanh
                </div>
                <a asp-controller="NhanVien" asp-action="Index" class="app-launcher-item @(currentController == "NhanVien" ? "active" : "")">
                    <div class="app-launcher-icon" style="color: #6366f1;"><i class="fa-solid fa-house"></i></div>
                    <span class="app-launcher-text">Tổng quan</span>
                </a>
                <a asp-controller="Attendance" asp-action="Index" class="app-launcher-item @(currentController == "Attendance" || currentController == "AttendanceAdjustment" ? "active" : "")">
                    <div class="app-launcher-icon" style="color: #f59e0b;"><i class="fa-solid fa-clock"></i></div>
                    <span class="app-launcher-text">Chấm công</span>
                </a>
                <a asp-controller="MyPayroll" asp-action="Index" class="app-launcher-item @(currentController == "MyPayroll" ? "active" : "")">
                    <div class="app-launcher-icon" style="color: #10b981;"><i class="fa-solid fa-money-check-dollar"></i></div>
                    <span class="app-launcher-text">Lương của tôi</span>
                </a>
                <a asp-controller="MyRequest" asp-action="Index" class="app-launcher-item @(currentController == "MyRequest" ? "active" : "")">
                    <div class="app-launcher-icon" style="color: #ec4899;"><i class="fa-solid fa-file-signature"></i></div>
                    <span class="app-launcher-text">Đơn từ</span>
                </a>
                <a asp-controller="Contract" asp-action="Index" class="app-launcher-item @(currentController == "Contract" ? "active" : "")">
                    <div class="app-launcher-icon" style="color: #8b5cf6;"><i class="fa-solid fa-file-contract"></i></div>
                    <span class="app-launcher-text">Hợp đồng</span>
                </a>
            } else {
                <div style="padding: 12px 16px; font-weight: 600; color: #64748b; font-size: 13px; border-bottom: 1px solid #e2e8f0; margin-bottom: 8px;">
                    Chuyển chức năng
                </div>
                <a asp-controller="HR" asp-action="Index" class="app-launcher-item @(majorModule == "HR" ? "active" : "")">
                    <div class="app-launcher-icon" style="color: #3b82f6;"><i class="fa-solid fa-users"></i></div>
                    <span class="app-launcher-text">Quản lý nhân sự</span>
                </a>
