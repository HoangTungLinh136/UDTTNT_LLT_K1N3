    <form id="aiCsrf" hidden>@Html.AntiForgeryToken()</form>
    <script>
        (() => {
            const token = document.querySelector('#aiCsrf input[name="__RequestVerificationToken"]')?.value;
            if (!token) return;
            const unsafe = method => /^(POST|PUT|PATCH|DELETE)$/i.test(method || 'GET');
            const sameOrigin = url => new URL(url, window.location.href).origin === window.location.origin;
            const originalFetch = window.fetch.bind(window);
            window.fetch = (input, init = {}) => {
                const method = init.method || (input instanceof Request ? input.method : 'GET');
                const url = typeof input === 'string' ? input : input.url;
                if (unsafe(method) && sameOrigin(url)) {
                    const headers = new Headers(init.headers || (input instanceof Request ? input.headers : undefined));
                    if (!headers.has('RequestVerificationToken')) headers.set('RequestVerificationToken', token);
                    init = { ...init, headers };
                }
                return originalFetch(input, init);
            };
            if (window.jQuery) {
                window.jQuery.ajaxPrefilter((options, _, xhr) => {
                    if (unsafe(options.type) && sameOrigin(options.url)) xhr.setRequestHeader('RequestVerificationToken', token);
                });
            }
        })();
    </script>
    <script>
        // Toggle App Launcher Popover (the launcher is intentionally hidden for Manager).
        const launcherBtn = document.getElementById('appLauncherBtn');
        if (launcherBtn) {
            launcherBtn.addEventListener('click', function(e) {
                e.stopPropagation();
                const popover = document.getElementById('appLauncherPopover');
                if (popover) popover.classList.toggle('show');
            });
        }
        
        // Hide popover when clicking outside
        document.addEventListener('click', function(e) {
            const popover = document.getElementById('appLauncherPopover');
            const btn = document.getElementById('appLauncherBtn');
            if (popover && popover.classList.contains('show') && !popover.contains(e.target) && (!btn || !btn.contains(e.target))) {
                popover.classList.remove('show');
            }
        });

        // Sidebar Accordion Logic
        document.querySelectorAll('.menu-toggle').forEach(toggle => {
            toggle.addEventListener('click', function() {
                const parentLi = this.parentElement;
                
                // Toggle current submenu
                parentLi.classList.toggle('open');
                
                // Optional: Close other open submenus
                document.querySelectorAll('.sidebar .menu > li.has-submenu').forEach(li => {
                    if (li !== parentLi) {
                        li.classList.remove('open');
                    }
                });
            });
        });

        const globalConnection = new signalR.HubConnectionBuilder()
            .withUrl("/dashboardHub")
            .withAutomaticReconnect()
            .build();
        window.HRMSSignalRConnection = globalConnection;

        globalConnection.on("ReceiveNotification", function (data) {
            const loggedInUser = '@currentUser';
            const myRealName = '@realName';

            if (data && data.receiver) {
                if (data.receiver !== "Tất cả nhân viên" && data.receiver !== "Tất cả"
                    && data.receiver !== loggedInUser && data.receiver !== myRealName) {
                    return;
                }
            }

            try {
                if (window.HRMS_Sound) {
                    var soundId = (data && data.sender ? data.sender : '') + '_' +
                                  (data && data.time ? data.time : '') + '_' +
                                  (data && data.content ? data.content.substring(0, 20) : '');
                    HRMS_Sound.playForNotification(soundId);
                }
            } catch(e) { }

            let badge = document.getElementById("notificationBadge");
            if (badge) {
                let currentCount = parseInt(badge.innerText) || 0;
                badge.innerText = currentCount + 1;
                badge.style.transform = "scale(1.25)";
                setTimeout(() => badge.style.transform = "scale(1)", 1000);
            }
        });

        let globalConnectionStartAttempts = 0;
        const globalConnectionRetryDelays = [2000, 5000, 15000];
        globalConnection.onreconnecting(() => window.dispatchEvent(new Event('hrms:signalr-disconnected')));
        globalConnection.onreconnected(() => window.dispatchEvent(new Event('hrms:signalr-connected')));
        globalConnection.onclose(() => window.dispatchEvent(new Event('hrms:signalr-disconnected')));

        async function startGlobalConnection() {
            try {
                await globalConnection.start();
                globalConnectionStartAttempts = 0;
                const loggedInUser = '@currentUser';
                const myRealName = '@realName';
                if (loggedInUser) { await globalConnection.invoke("JoinGroup", loggedInUser); }
                if (myRealName)   { await globalConnection.invoke("JoinGroup", myRealName); }
                window.dispatchEvent(new Event('hrms:signalr-connected'));
            }
            catch (err) {
                window.dispatchEvent(new Event('hrms:signalr-disconnected'));
                if (globalConnectionStartAttempts < globalConnectionRetryDelays.length) {
                    const delay = globalConnectionRetryDelays[globalConnectionStartAttempts++];
                    setTimeout(startGlobalConnection, delay);
                }
            }
        }
        setTimeout(startGlobalConnection, 0);
    </script>

    @* Legacy inline chatbot retired; AVA is mounted once through _AvaAssistant.
    <!-- AI Chatbot -->
    <div id="robot-chat-container" class="d-print-none" style="position: fixed; bottom: 20px; right: 20px; z-index: 10000; font-family: 'Inter', sans-serif;">
        <div id="robot-trigger" onclick="toggleChatBox()" style="width: 58px; height: 58px; border-radius: 50%; background: linear-gradient(135deg, #2563EB, #3B82F6); display: flex; justify-content: center; align-items: center; cursor: pointer; z-index: 10001; position: relative; box-shadow: 0 4px 12px rgba(37,99,235,0.3);">
            <i class="fa-solid fa-robot" style="font-size: 24px; color: white;"></i>
        </div>

        <div id="hrms-chat-box" style="display: none; position: absolute; bottom: 75px; right: 0; width: 360px; background: white; border-radius: 16px; box-shadow: 0 10px 40px rgba(0,0,0,0.18); overflow: hidden; border: 1px solid #e2e8f0; flex-direction: column;">
            <div style="background: linear-gradient(135deg, #2563EB, #3B82F6); color: white; padding: 14px 18px; display: flex; justify-content: space-between; align-items: center; font-weight: 700; font-size: 14px; gap: 10px;">
                <span><i class="fa-solid fa-robot" style="margin-right:8px;"></i>@aiName</span>
                <button onclick="resetChatHistory()" style="background: rgba(255,255,255,0.18); border: 1px solid rgba(255,255,255,0.3); color: white; border-radius: 6px; font-size: 11px; padding: 3px 10px; cursor: pointer; font-family: inherit;">Làm mới</button>
            </div>
            <div id="chat-history-content" style="height: 300px; overflow-y: auto; padding: 14px; background: #f8fafc; display: flex; flex-direction: column; gap: 10px;">
                <div id="ai-greeting-msg" style="background: #e2e8f0; padding: 10px 14px; border-radius: 12px 12px 12px 4px; align-self: flex-start; max-width: 85%; font-size: 13.5px; color: #334155; line-height: 1.5;">
                    Chào bạn! Tôi là @aiName. Tôi có thể giúp gì cho bạn?
                </div>
            </div>
            <div style="padding: 10px 14px; border-top: 1px solid #e2e8f0; display: flex; gap: 8px; background: white;">
                <input type="text" id="ai-user-input"
                       placeholder="Hỏi về lương, nhân viên, chấm công..."
                       style="flex: 1; padding: 9px 13px; border: 1px solid #e2e8f0; border-radius: 8px; outline: none; font-size: 13.5px; font-family: inherit; color: #334155; background: #f8fafc; transition: border-color 0.2s;">
                <button onclick="sendQuestionToAi()" style="background: linear-gradient(135deg, #2563EB, #3B82F6); color: white; border: none; border-radius: 8px; padding: 0 16px; cursor: pointer; font-weight: 600; font-family: inherit; font-size: 13px;">Gửi</button>
            </div>
        </div>
    </div>

    <script>
        function toggleChatBox() {
            const box = document.getElementById("hrms-chat-box");
            box.style.display = (box.style.display === "none" || box.style.display === "") ? "flex" : "none";
        }

        async function sendQuestionToAi() {
            const input = document.getElementById("ai-user-input");
            const history = document.getElementById("chat-history-content");
            const prompt = input.value.trim();
            if (!prompt) return;

            history.innerHTML += `<div style="background: linear-gradient(135deg,#2563EB,#3B82F6); color: white; padding: 10px 14px; border-radius: 12px 12px 4px 12px; align-self: flex-end; max-width: 85%; font-size: 13.5px; line-height:1.5;">${prompt}</div>`;
            input.value = "";
            history.scrollTop = history.scrollHeight;

            const loadingId = "ai-loading-" + Date.now();
            history.innerHTML += `<div id="${loadingId}" style="background: #e2e8f0; color: #64748b; padding: 10px 14px; border-radius: 12px 12px 12px 4px; align-self: flex-start; font-size: 13.5px;"><i class="fa-solid fa-circle-notch fa-spin" style="margin-right:6px;"></i>Đang xử lý...</div>`;
            history.scrollTop = history.scrollHeight;

            try {
                const response = await fetch('/Ai/Chat', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': document.querySelector('#aiCsrf input[name="__RequestVerificationToken"]').value
                    },
                    body: new URLSearchParams({ question: prompt })
                });
                const answer = await response.text();
                document.getElementById(loadingId).remove();

                if (response.ok) {
                    history.innerHTML += `<div style="background: #e2e8f0; padding: 10px 14px; border-radius: 12px 12px 12px 4px; align-self: flex-start; max-width: 85%; font-size: 13.5px; color: #334155; line-height:1.5;">${answer}</div>`;
                } else {
                    history.innerHTML += `<div style="background: #fee2e2; color: #991b1b; padding: 10px 14px; border-radius: 12px 12px 12px 4px; align-self: flex-start; font-size: 13.5px;">Xin lỗi, tôi đang gặp lỗi kết nối.</div>`;
                }
                history.scrollTop = history.scrollHeight;
            } catch (err) {
                document.getElementById(loadingId).remove();
                history.innerHTML += `<div style="background: #fee2e2; color: #991b1b; padding: 10px 14px; border-radius: 12px 12px 12px 4px; align-self: flex-start; font-size: 13.5px;">Không thể kết nối đến máy chủ AI.</div>`;
                history.scrollTop = history.scrollHeight;
            }
        }

        function resetChatHistory() {
            document.getElementById("chat-history-content").innerHTML = `
                <div id="ai-greeting-msg" style="background: #e2e8f0; padding: 10px 14px; border-radius: 12px 12px 12px 4px; align-self: flex-start; max-width: 85%; font-size: 13.5px; color: #334155; line-height: 1.5;">
                    Chào bạn! Tôi là trợ lý AI. Bạn cần tôi giúp gì về nhân sự hôm nay?
                </div>
            `;
        }

        document.getElementById("ai-user-input").addEventListener("keypress", (e) => {
            if (e.key === "Enter") sendQuestionToAi();
        });
    </script>
    }
    *@

    @await RenderSectionAsync("Scripts", required: false)
    @await Html.PartialAsync("_AvaAssistant")
</body>
