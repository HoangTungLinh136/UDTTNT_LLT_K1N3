@{
    ViewData["Title"] = "Bảng chấm công";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var role = ViewBag.Role as string;
    var currentYear = DateTime.Now.Year;
    var currentMonth = DateTime.Now.Month;
}

<form id="timesheetCsrf" hidden>@Html.AntiForgeryToken()</form>

<style>
    /* Styling cho Bảng chấm công */
    .timesheet-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }
    
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 24px;
    }

    .stat-card {
        background: #fff;
        border-radius: 12px;
        padding: 20px;
        border: 1px solid var(--hrms-border);
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }

    .stat-icon.total { background: #eff6ff; color: #3b82f6; }
    .stat-icon.full { background: #f0fdf4; color: #22c55e; }
    .stat-icon.abnormal { background: #fef2f2; color: #ef4444; }
    .stat-icon.status { background: #fffbeb; color: #f59e0b; }

    .filters-bar {
        background: #fff;
        padding: 16px;
        border-radius: 12px;
        border: 1px solid var(--hrms-border);
        margin-bottom: 24px;
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
        align-items: flex-end;
    }

    .matrix-container {
        background: #fff;
        border-radius: 12px;
        border: 1px solid var(--hrms-border);
        overflow-x: auto;
    }

    .matrix-table {
        width: 100%;
        border-collapse: collapse;
        white-space: nowrap;
    }

    .matrix-table th, .matrix-table td {
        padding: 12px;
        border: 1px solid var(--hrms-border);
        text-align: center;
        font-size: 13px;
    }

    .matrix-table th {
        background: #f8fafc;
        font-weight: 600;
        color: #475569;
    }

    .matrix-table th.sticky-col,
    .matrix-table td.sticky-col {
        position: sticky;
        left: 0;
        background: #fff;
        z-index: 2;
        box-shadow: 2px 0 5px rgba(0,0,0,0.05);
        text-align: left;
    }

    .matrix-table th.sticky-col {
        background: #f8fafc;
        z-index: 3;
    }

    .cell-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
    }
    
    .cell-badge:hover {
        opacity: 0.8;
        transform: scale(1.1);
    }

    .cell-badge.PRESENT { background: #dcfce7; color: #16a34a; }
    .cell-badge.LATE { background: #fef08a; color: #ca8a04; }
    .cell-badge.ABSENT { background: #fee2e2; color: #dc2626; }
    .cell-badge.LEAVE { background: #e0e7ff; color: #4f46e5; }
    .cell-badge.MISSING_OUT { background: #ffedd5; color: #ea580c; }
    .cell-badge.ABNORMAL { background: #fecdd3; color: #e11d48; }
    .cell-badge.OFF { background: #f1f5f9; color: #94a3b8; }
    .cell-badge.NONE { background: transparent; }

</style>

<div class="content-body">
    <div class="timesheet-header">
        <div>
            <h2 style="font-size: 24px; font-weight: 700; color: var(--hrms-text); margin-bottom: 4px;">Bảng chấm công</h2>
            <p style="color: #64748b; font-size: 14px;">Theo dõi và tổng hợp dữ liệu chấm công của nhân viên theo ngày.</p>
        </div>
        <div style="display: flex; gap: 12px;">
            <button class="btn btn-secondary" onclick="exportExcel()">
                <i class="fa-solid fa-file-excel"></i> Xuất Excel
            </button>
            @if (role == "HR")
            {
                <button class="btn btn-primary" id="btnLockPeriod" onclick="confirmLockPeriod()">
                    <i class="fa-solid fa-lock"></i> Chốt bảng công
                </button>
            }
        </div>
    </div>

    <!-- Statistics -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon total"><i class="fa-solid fa-users"></i></div>
            <div>
                <div style="color: #64748b; font-size: 13px; font-weight: 500;">TỔNG NHÂN VIÊN</div>
                <div id="statTotal" style="font-size: 24px; font-weight: 700; color: #0f172a; margin-top: 4px;">0</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon full"><i class="fa-solid fa-check-circle"></i></div>
            <div>
                <div style="color: #64748b; font-size: 13px; font-weight: 500;">ĐỦ CÔNG</div>
                <div id="statFull" style="font-size: 24px; font-weight: 700; color: #0f172a; margin-top: 4px;">0</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon abnormal"><i class="fa-solid fa-triangle-exclamation"></i></div>
            <div>
                <div style="color: #64748b; font-size: 13px; font-weight: 500;">BẤT THƯỜNG</div>
                <div id="statAbnormal" style="font-size: 24px; font-weight: 700; color: #0f172a; margin-top: 4px;">0</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon status"><i class="fa-solid fa-unlock"></i></div>
            <div>
                <div style="color: #64748b; font-size: 13px; font-weight: 500;">TRẠNG THÁI KỲ</div>
                <div id="statPeriod" style="font-size: 18px; font-weight: 700; color: #0f172a; margin-top: 4px;">CHƯA CHỐT</div>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="filters-bar">
        <div class="form-group" style="margin-bottom: 0; min-width: 150px;">
            <label>Tháng/Năm</label>
            <input type="month" id="filterMonth" class="form-control" value="@($"{currentYear}-{currentMonth:D2}")" onchange="loadData()">
        </div>
        @if (role != "Employee")
        {
            <div class="form-group" style="margin-bottom: 0; min-width: 180px;">
                <label>Phòng ban</label>
                <select id="filterDept" class="form-control" onchange="loadData()">
                    <option value="">Tất cả phòng ban</option>
                    @if (ViewBag.Departments != null)
                    {
                        foreach (var dept in ViewBag.Departments)
                        {
                            <option value="@dept">@dept</option>
                        }
                    }
                </select>
            </div>
            <div class="form-group" style="margin-bottom: 0; min-width: 200px;">
                <label>Nhân viên</label>
                <div class="search-box" style="margin: 0; width: 100%;">
                    <i class="fa-solid fa-search"></i>
                    <input type="text" id="filterEmp" placeholder="Tên nhân viên..." onkeyup="debounceLoadData()">
                </div>
            </div>
        }
        <div class="form-group" style="margin-bottom: 0; min-width: 180px;">
            <label>Trạng thái</label>
            <select id="filterStatus" class="form-control" onchange="loadData()">
                <option value="">Tất cả trạng thái</option>
                <option value="ABNORMAL">Có bất thường</option>
                <option value="FULL">Đủ công</option>
            </select>
        </div>
        <button class="btn btn-outline" onclick="resetFilters()" style="height: 38px;">
            <i class="fa-solid fa-rotate-right"></i> Đặt lại
        </button>
    </div>

    <!-- Matrix Table -->
    <div class="matrix-container">
        <table class="matrix-table" id="matrixTable">
            <thead>
                <tr id="matrixHeaderRow">
                    <th class="sticky-col" style="width: 250px;">Nhân viên</th>
                    <!-- Ngày sẽ được sinh động bằng JS -->
                    <th style="width: 80px;">Công</th>
                    <th style="width: 80px;">OT</th>
                </tr>
            </thead>
            <tbody id="matrixBody">
                <tr><td colspan="35" style="text-align: center; padding: 40px; color: #64748b;">Đang tải dữ liệu...</td></tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Drawer Chi tiết -->
<div class="drawer-overlay" id="detailOverlay" onclick="closeDrawer()"></div>
<div class="drawer-panel" id="detailDrawer">
    <div class="drawer-header">
        <h3 class="drawer-title">Chi tiết chấm công</h3>
        <button class="drawer-close" onclick="closeDrawer()"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <div class="drawer-body" id="detailContent">
        <!-- Content loaded by JS -->
    </div>
</div>

<!-- Modal Chốt Công -->
<div class="modal" id="lockModal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="modal-title">Chốt Bảng Công</h3>
                <button class="btn-close" onclick="closeModal('lockModal')"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-warning" style="display: flex; gap: 12px; background: #fffbeb; border: 1px solid #fcd34d; padding: 16px; border-radius: 8px; color: #92400e;">
                    <i class="fa-solid fa-triangle-exclamation" style="font-size: 24px; color: #f59e0b;"></i>
                    <div>
                        <strong>Cảnh báo khóa dữ liệu!</strong>
                        <p style="margin-top: 4px; font-size: 14px;">Bạn đang thực hiện chốt bảng công cho kỳ <strong id="lblLockPeriod"></strong>. Sau khi chốt, toàn bộ dữ liệu chấm công trong kỳ này sẽ bị khóa và không thể thay đổi thông thường. Dữ liệu này sẽ được dùng làm đầu vào cho kỳ lương.</p>
                    </div>
                </div>
                <p style="margin-top: 16px; font-size: 14px; font-weight: 500;">Bạn có chắc chắn muốn chốt bảng công này không?</p>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline" onclick="closeModal('lockModal')">Hủy</button>
                <button class="btn btn-primary" onclick="executeLockPeriod()">Xác nhận Chốt</button>
            </div>
        </div>
    </div>
</div>

<script>
    let debounceTimer;

    function getSelectedYearMonth() {
        const val = document.getElementById('filterMonth').value; // YYYY-MM
        if (!val) return null;
        const parts = val.split('-');
        return { year: parseInt(parts[0]), month: parseInt(parts[1]) };
    }

    function loadData() {
        const date = getSelectedYearMonth();
        if (!date) return;
        
        const dept = document.getElementById('filterDept') ? document.getElementById('filterDept').value : '';
        const emp = document.getElementById('filterEmp') ? document.getElementById('filterEmp').value : '';
        const status = document.getElementById('filterStatus').value;

        // Load stats
        fetch(`/Timesheet/GetStatistics?year=${date.year}&month=${date.month}&department=${encodeURIComponent(dept)}`)
            .then(res => res.json())
            .then(data => {
                document.getElementById('statTotal').innerText = data.totalEmployees;
                document.getElementById('statFull').innerText = data.fullAttendance;
                document.getElementById('statAbnormal').innerText = data.abnormal;
                
                const statPeriod = document.getElementById('statPeriod');
                if (data.periodStatus === 'CLOSED') {
                    statPeriod.innerText = "ĐÃ CHỐT";
                    statPeriod.style.color = "#16a34a";
                    const btn = document.getElementById('btnLockPeriod');
                    if (btn) btn.style.display = 'none';
                } else {
                    statPeriod.innerText = "CHƯA CHỐT";
                    statPeriod.style.color = "#f59e0b";
                    const btn = document.getElementById('btnLockPeriod');
                    if (btn) btn.style.display = 'inline-flex';
                }
            });

        // Load matrix
        fetch(`/Timesheet/GetTimesheetMatrix?year=${date.year}&month=${date.month}&department=${encodeURIComponent(dept)}&employeeName=${encodeURIComponent(emp)}&status=${encodeURIComponent(status)}`)
            .then(res => res.json())
            .then(data => {
                renderMatrix(data.daysInMonth, data.data, date.year, date.month);
            });
    }

    function debounceLoadData() {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(loadData, 500);
    }

    function resetFilters() {
        if(document.getElementById('filterDept')) document.getElementById('filterDept').value = '';
        if(document.getElementById('filterEmp')) document.getElementById('filterEmp').value = '';
        document.getElementById('filterStatus').value = '';
        loadData();
    }

    function getBadgeContent(status) {
        switch (status) {
            case 'PRESENT': return 'P';
            case 'LATE': return 'L';
            case 'ABSENT': return 'A';
            case 'LEAVE': return 'LV';
            case 'MISSING_OUT': return '!';
            case 'ABNORMAL': return 'X';
            case 'OFF': return '-';
            default: return '';
        }
    }

    function renderMatrix(daysInMonth, employees, year, month) {
        const headerRow = document.getElementById('matrixHeaderRow');
        let thHtml = `<th class="sticky-col" style="width: 250px;">Nhân viên</th>`;
        for (let i = 1; i <= daysInMonth; i++) {
            thHtml += `<th style="width: 45px;">${i}</th>`;
        }
        thHtml += `<th style="width: 80px;">Công</th><th style="width: 80px;">OT</th>`;
        headerRow.innerHTML = thHtml;

        const body = document.getElementById('matrixBody');
        let trHtml = '';

        if (employees.length === 0) {
            trHtml = `<tr><td colspan="${daysInMonth + 3}" style="text-align: center; padding: 40px; color: #64748b;">
                <div style="display:flex; flex-direction:column; align-items:center; gap:10px;">
                    <i class="fa-regular fa-folder-open" style="font-size: 32px; color: #cbd5e1;"></i>
                    <span>Chưa có dữ liệu chấm công.</span>
                </div>
            </td></tr>`;
        } else {
            employees.forEach(emp => {
                trHtml += `<tr>`;
                trHtml += `<td class="sticky-col">
                    <div style="font-weight: 500; color: #0f172a;">${emp.employeeName}</div>
                    <div style="font-size: 11px; color: #64748b;">${emp.department || '---'}</div>
                </td>`;
                
                for (let i = 1; i <= daysInMonth; i++) {
                    const dayData = emp.dailyData[i];
                    if (dayData && dayData.status !== 'NONE') {
                        const badgeText = getBadgeContent(dayData.status);
                        trHtml += `<td>
                            <div class="cell-badge ${dayData.status}" title="${dayData.text}" onclick="openDetail(${emp.employeeId}, '${emp.employeeName}', ${year}, ${month}, ${i})">
                                ${badgeText}
                            </div>
                        </td>`;
                    } else {
                        trHtml += `<td></td>`;
                    }
                }
                
                trHtml += `<td style="font-weight: 600;">${emp.totalWorkDays}</td>`;
                trHtml += `<td>${emp.totalOT}</td>`;
                trHtml += `</tr>`;
            });
        }
        
        body.innerHTML = trHtml;
    }

    function openDetail(employeeId, employeeName, year, month, day) {
        document.getElementById('detailOverlay').classList.add('open');
        document.getElementById('detailDrawer').classList.add('open');
        
        const dateStr = `${year}-${month.toString().padStart(2, '0')}-${day.toString().padStart(2, '0')}`;
        const content = document.getElementById('detailContent');
        
        content.innerHTML = `<div style="padding: 20px; text-align: center;"><i class="fa-solid fa-spinner fa-spin"></i> Đang tải dữ liệu...</div>`;
        
        fetch(`/Timesheet/GetDailyDetail?employeeId=${employeeId}&dateStr=${dateStr}`)
            .then(res => res.json())
            .then(data => {
                let html = `
                    <div style="margin-bottom: 24px; padding-bottom: 16px; border-bottom: 1px solid var(--hrms-border);">
                        <div style="font-size: 18px; font-weight: 600; color: #0f172a;">${employeeName}</div>
                        <div style="color: #64748b; margin-top: 4px;">Ngày: ${dateStr}</div>
                    </div>
                `;
                
                if (data.attendance) {
                    html += `
                        <div style="margin-bottom: 24px;">
                            <h4 style="font-size: 14px; font-weight: 600; margin-bottom: 12px; color: #475569;">GHI NHẬN TỪ HỆ THỐNG</h4>
                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                                <div style="background: #f8fafc; padding: 12px; border-radius: 8px; border: 1px solid var(--hrms-border);">
                                    <div style="font-size: 12px; color: #64748b; margin-bottom: 4px;">Check-in</div>
                                    <div style="font-weight: 600; font-size: 16px;">${new Date(data.attendance.checkIn).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})}</div>
                                </div>
                                <div style="background: #f8fafc; padding: 12px; border-radius: 8px; border: 1px solid var(--hrms-border);">
                                    <div style="font-size: 12px; color: #64748b; margin-bottom: 4px;">Check-out</div>
                                    <div style="font-weight: 600; font-size: 16px;">${data.attendance.checkOut ? new Date(data.attendance.checkOut).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) : '---'}</div>
                                </div>
                            </div>
                            <div style="margin-top: 12px; padding: 12px; border-radius: 8px; background: ${data.attendance.lateMinutes > 0 ? '#fef08a' : '#f0fdf4'}; border: 1px solid ${data.attendance.lateMinutes > 0 ? '#fde047' : '#bbf7d0'};">
                                <strong>Ghi chú:</strong> ${data.attendance.statusNote || 'Bình thường'}
                            </div>
                        </div>
                    `;
                } else {
                    html += `
                        <div style="margin-bottom: 24px; padding: 16px; background: #f8fafc; border-radius: 8px; text-align: center; color: #64748b;">
                            Không có dữ liệu Check-in/Check-out.
                        </div>
                    `;
                }

                if (data.leave) {
                    html += `
                        <div style="margin-bottom: 24px;">
                            <h4 style="font-size: 14px; font-weight: 600; margin-bottom: 12px; color: #475569;">ĐƠN TỪ LIÊN QUAN</h4>
                            <div style="padding: 12px; border-radius: 8px; background: #eff6ff; border: 1px solid #bfdbfe;">
                                <div style="font-weight: 600; color: #1e3a8a;">Nghỉ phép (${data.leave.status})</div>
                                <div style="font-size: 13px; color: #1e40af; margin-top: 4px;">Lý do: ${data.leave.reason}</div>
                            </div>
                        </div>
                    `;
                }
                
                content.innerHTML = html;
            });
    }

    function closeDrawer() {
        document.getElementById('detailOverlay').classList.remove('open');
        document.getElementById('detailDrawer').classList.remove('open');
    }

    function confirmLockPeriod() {
        const date = getSelectedYearMonth();
        if (!date) return;
        document.getElementById('lblLockPeriod').innerText = `${date.month}/${date.year}`;
        document.getElementById('lockModal').classList.add('open');
    }

    function closeModal(id) {
        document.getElementById(id).classList.remove('open');
    }

    function executeLockPeriod() {
        const date = getSelectedYearMonth();
        if (!date) return;
        
        fetch(`/Timesheet/ClosePeriod?year=${date.year}&month=${date.month}`, { method: 'POST', headers: { 'RequestVerificationToken': document.querySelector('#timesheetCsrf input[name="__RequestVerificationToken"]').value } })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    closeModal('lockModal');
                    loadData();
                    // Hiển thị Toast (nếu có)
                    alert("Chốt công thành công!");
                } else {
                    alert(data.message);
                }
            });
    }

    function exportExcel() {
        alert("Chức năng đang được cập nhật!");
    }

    // Auto load data on init
    document.addEventListener("DOMContentLoaded", function() {
        loadData();
    });
</script>
